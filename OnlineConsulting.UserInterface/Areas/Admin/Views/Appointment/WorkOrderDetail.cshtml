@using OnlineConsulting.UserInterface.Areas.Admin.Features.Appointment
@model WorkOrderDetailViewModel
@{
    ViewData["Title"] = "Work Order";
    ViewData["SubPage1"] = "Appointments";
    ViewData["SubPage1Url"] = Url.Action("Index", "Appointment", new { area = "Admin" });
    ViewData["SubPage2"] = "Work Order";
}
<div class="col-12">
    <div class="card p-3">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0">Work Order</h5>
            <a href="@Url.Action("Index","Appointment")" class="btn btn-outline-secondary btn-sm"><i class="ti ti-arrow-left me-1"></i>Back</a>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4"><strong>Technician:</strong> @(Model.TechnicianName ?? "-")</div>
                <div class="col-md-4"><strong>Equipment:</strong> @(Model.EquipmentLabel ?? "-")</div>
                <div class="col-md-4"><strong>Completed At:</strong> @(Model.CompletedAt?.ToString("MMM d, yyyy h:mm tt") ?? "-")</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.PartsUsed))
            {
                <div class="mb-3">
                    <h6>Parts Used</h6>
                    <p class="text-muted mb-0">@Model.PartsUsed</p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TechnicianNotes))
            {
                <div class="mb-3">
                    <h6>Technician Notes</h6>
                    <p class="text-muted mb-0">@Model.TechnicianNotes</p>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.BeforePhotoUrl) || !string.IsNullOrWhiteSpace(Model.AfterPhotoUrl))
            {
                <div class="row">
                    @if (!string.IsNullOrWhiteSpace(Model.BeforePhotoUrl))
                    {
                        <div class="col-md-6">
                            <h6>Before</h6>
                            <img src="@Model.BeforePhotoUrl" class="img-fluid rounded" alt="Before photo" />
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.AfterPhotoUrl))
                    {
                        <div class="col-md-6">
                            <h6>After</h6>
                            <img src="@Model.AfterPhotoUrl" class="img-fluid rounded" alt="After photo" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
