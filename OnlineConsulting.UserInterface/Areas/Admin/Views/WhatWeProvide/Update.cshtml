@using OnlineConsulting.UserInterface.Areas.Admin.Features.WhatWeProvide
@model UpdateWhatWeProvideViewModel
@{
    ViewData["Title"] = "Update What We Provide";
    ViewData["SubPage1"] = "What We Provide";
    ViewData["SubPage1Url"] = Url.Action("Index", "WhatWeProvide", new { area = "Admin" });
    ViewData["SubPage2"] = "Update What We Provide";
    ViewData["SubPage2Url"] = Url.Action("Update", "WhatWeProvide", new { area = "Admin", id = Model.Id });
}

<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">@Model.Title</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-auto text-center">
                    <img src="@Model.ImageUrl"
                         alt="user-image"
                         class="wid-150 rounded img-fluid"
                         style="width: 320px; height: 180px; border-radius: 8px; object-fit:cover;" />
                </div>
                <div class="col">
                    <form id="contactForm" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <input type="hidden" asp-for="Id" />
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label" for="image">Replace Image (optional)</label>
                                    <input class="form-control" id="image" type="file" asp-for="Image" accept=".png, .jpeg, .jpg, .gif" />
                                    <div class="text-muted" style="font-size: x-small;">
                                        <span style="font-weight: bold;">*</span>Leave empty to keep the current photo. Please ensure the image is <strong>483x561 pixels</strong> for the best results.
                                    </div>
                                    <span asp-validation-for="Image" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label" for="whatweprovidetitle">Title</label>
                                    <input type="text" class="form-control" id="whatweprovidetitle" placeholder="Enter title" asp-for="Title" />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label" for="summernote-textarea">Descripton</label>
                                    <textarea class="form-control" id="summernote-textarea" rows="3" placeholder="Enter description" asp-for="Description"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12 text-end mt-3">
                                <div class="d-grid gap-2 mt-2 text-center">
                                    <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Update</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
