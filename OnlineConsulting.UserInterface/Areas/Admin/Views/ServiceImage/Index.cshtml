@model IQueryable<ResultServiceImageDto>
@{
    ViewData["Title"] = "Service Image";
    ViewData["SubPage1"] = "Service Image";
    ViewData["SubPage1Url"] = Url.Action("Index", "ServiceImage", new { area = "Admin" });
}

<script type="module">
    import { DataTable } from '/templates/admin-sky-template/able-pro-vanila-bootstrap-9.5.0/dist/assets/js/plugins/module.js';
    window.dt = new DataTable('#pc-dt-simple');
</script>
<div class="col-12">
    <div class="card table-card">
        <div class="card-header">
            <div class="d-sm-flex align-items-center justify-content-between">
                <h5 class="mb-3 mb-sm-0">Service Image List</h5>
                <div>
                    <a href="@Url.Action("Create","ServiceImage")" class="btn btn-primary">Add Service Image</a>
                </div>
            </div>
        </div>
        <div class="card-body pt-3">
            <div class="table-responsive">
                <table class="table table-hover" id="pc-dt-simple" style="table-layout: auto; width: 100%;">
                    <thead>
                        <tr>
                            <th style="word-wrap: break-word; white-space: normal;">Count</th>
                            <th style="word-wrap: break-word; white-space: normal;">Service</th>
                            <th style="word-wrap: break-word; white-space: normal;">Created Date</th>
                            <th style="word-wrap: break-word; white-space: normal;">Created By</th>
                            <th style="word-wrap: break-word; white-space: normal;">Updated Date</th>
                            <th style="word-wrap: break-word; white-space: normal;">Updated By</th>
                            <th style="word-wrap: break-word; white-space: normal;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            int count = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td style="word-wrap: break-word; white-space: normal;">@count</td>
                                    <td style="word-wrap: break-word; white-space: normal;">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <div class="flex-shrink-0">
                                                <img src="@item.ImageUrl"
                                                     alt="Service Image image" class="img-radius wid-40" />
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="mb-0">@item.ServiceId</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="word-wrap: break-word; white-space: normal;">@item.CreatedDate</td>
                                    <td style="word-wrap: break-word; white-space: normal;">@item.CreatedBy</td>
                                    <td style="word-wrap: break-word; white-space: normal;">@item.UpdatedDate</td>
                                    <td style="word-wrap: break-word; white-space: normal;">@item.UpdatedBy</td>
                                    <td>
                                        <a href="#" class="avtar avtar-xs btn-link-secondary">
                                            <i class="ti ti-eye f-20"></i>
                                        </a>
                                        <a href="@Url.Action("Update","ServiceImage",new{id=item.Id})" class="avtar avtar-xs btn-link-secondary">
                                            <i class="ti ti-edit f-20"></i>
                                        </a>
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#deleteModalCenter" class="avtar avtar-xs btn-link-secondary delete-btn" data-id="@item.Id">
                                            <i class="ti ti-trash f-20"></i>
                                        </a>
                                    </td>
                                </tr>
                                count++;
                            }
                        }
                        else
                        {
                            <div class="alert alert-success m-4" role="alert"> No data added yet! </div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div id="deleteModalCenter" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalCenterTitle">Delete Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    The record you selected will be deleted. Do you want to continue?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">No</button>
                <a href="#" id="confirmDeleteBtn" class="btn btn-danger">Yes</a>
            </div>
        </div>
    </div>
</div>
<script>
        document.addEventListener('DOMContentLoaded', function () {
        const deleteButtons = document.querySelectorAll('.delete-btn');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

        deleteButtons.forEach(button => {
            button.addEventListener('click', function () {
                const itemId = this.getAttribute('data-id');
                confirmDeleteBtn.setAttribute('href', `/Admin/Message/Delete/${itemId}`);
            });
        });
    });
</script>