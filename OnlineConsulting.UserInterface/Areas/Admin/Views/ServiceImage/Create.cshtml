@model CreateServiceImageDto
@{
    ViewData["Title"] = "Create Service Image";
    ViewData["SubPage1"] = "Service Image";
    ViewData["SubPage1Url"] = Url.Action("Index", "ServiceImage", new { area = "Admin" });
    ViewData["SubPage2"] = "Create Service Image";
    ViewData["SubPage2Url"] = Url.Action("Create", "ServiceImage", new { area = "Admin" });
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Create New Service Image</h5>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="Servicecategory">Category</label>
                            <select class="form-control" id="Servicecategory" asp-for="ServiceId">
                                <option value="37720d4d-e824-4879-48ae-08dd2d3ec38b">Service 1</option>
                                <option value="37720d4d-e824-4879-48ae-08dd2d3ec38b">Service 2</option>
                                <option value="37720d4d-e824-4879-48ae-08dd2d3ec38b">Service 3</option>
                                <option value="37720d4d-e824-4879-48ae-08dd2d3ec38b">Service 4</option>
                            </select>
                            <span asp-validation-for="ServiceId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="ServiceImageimage">Service Image</label>
                            <input class="form-control" id="ServiceImageimage" type="file" asp-for="Image" accept=".png, .jpeg, .jpg, .gif" />
                            <span asp-validation-for="Image" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12 text-end mt-3">
                        <div class="d-grid gap-2 mt-2 text-center">
                            <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Save</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>