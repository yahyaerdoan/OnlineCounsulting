@using OnlineConsulting.UserInterface.Areas.Admin.Features.ProvidedItem
@model CreateProvidedItemViewModel
@{
    ViewData["Title"] = "Create Provided Item";
    ViewData["SubPage1"] = "Provided Item";
    ViewData["SubPage1Url"] = Url.Action("Index", "ProvidedItem", new { area = "Admin" });
    ViewData["SubPage2"] = "Create Provided Item";
    ViewData["SubPage2Url"] = Url.Action("Create", "ProvidedItem", new { area = "Admin" });
}

<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">Create New Provided Item</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="icon">Icon (CSS class name)</label>
                            <input type="text" class="form-control" id="icon" placeholder="e.g. ti ti-truck" asp-for="Icon" />
                            <span asp-validation-for="Icon" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="iconcolor">Icon Color (optional)</label>
                            <input type="text" class="form-control" id="iconcolor" placeholder="e.g. #ff0000" asp-for="IconColor" />
                            <span asp-validation-for="IconColor" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="ProvidedItemtitle">Title</label>
                            <input type="text" class="form-control" id="ProvidedItemtitle" placeholder="Enter title" asp-for="Title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label" for="ProvidedItemDescripton">Descripton</label>
                            <textarea class="form-control" id="ProvidedItemDescripton" rows="3" placeholder="Enter description" asp-for="Description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12 text-end mt-3">
                        <div class="d-grid gap-2 mt-2 text-center">
                            <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Save</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
