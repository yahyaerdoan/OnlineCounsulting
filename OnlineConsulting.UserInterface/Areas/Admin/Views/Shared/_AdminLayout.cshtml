@{
    Layout = null;
}

<!doctype html>
<html lang="en">
@await Component.InvokeAsync("AdminLayoutHeadComponentPartial")
<body data-pc-preset="preset-1" data-pc-sidebar-caption="true" data-pc-layout="vertical" data-pc-direction="ltr" data-pc-theme_contrast="" data-pc-theme="light">
    <!-- [ Pre-loader ] start -->
    <div class="loader-bg">
        <div class="loader-track">
            <div class="loader-fill"></div>
        </div>
    </div>
    <!-- [ Pre-loader ] End -->
    @await Component.InvokeAsync("AdminLayoutSidebarComponentPartial")
    @await Component.InvokeAsync("AdminLayoutHeaderComponentPartial")
    <!-- [ Main Content ] start -->
    <div class="pc-container">
        <div class="pc-content">
            @await Component.InvokeAsync("AdminLayoutBreadcrumbComponentPartial")
            <div class="row">
                @RenderBody()
            </div>
        </div>
    </div>
    <!-- [ Main Content ] end -->
    @await Component.InvokeAsync("AdminLayoutFooterComponentPartial")
    <div class="pct-c-btn">
        <a href="#" data-bs-toggle="offcanvas" data-bs-target="#offcanvas_pc_layout">
            <i class="ph-duotone ph-gear-six"></i>
        </a>
    </div>
    @await Component.InvokeAsync("AdminLayoutSettingsComponentPartial")
    @await Component.InvokeAsync("AdminLayoutScriptsComponentPartial")
    <partial name="_ValidationScriptsPartial" />
</body>
</html>