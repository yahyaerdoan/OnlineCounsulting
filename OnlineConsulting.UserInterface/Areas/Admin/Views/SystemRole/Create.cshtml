@using OnlineConsulting.UserInterface.Areas.Admin.Features.SystemRole
@model CreateSystemRoleViewModel
@{
    ViewData["Title"] = "Create New System Role";
    ViewData["SubPage1"] = "System Role List";
    ViewData["SubPage1Url"] = Url.Action("Index", "SystemRole", new { area = "Admin" });
    ViewData["SubPage2"] = "Create System Role";
    ViewData["SubPage2Url"] = Url.Action("Create", "SystemRole", new { area = "Admin" });
}
<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">Create New System Role</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="row">
              
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label" for="name">Role Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Enter name" asp-for="Name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label" for="description">Descripton</label>
                            <textarea class="form-control" id="description" rows="3" placeholder="Enter description" asp-for="Description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12 text-end mt-3">
                        <div class="d-grid gap-2 mt-2 text-center">
                            <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Save</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>