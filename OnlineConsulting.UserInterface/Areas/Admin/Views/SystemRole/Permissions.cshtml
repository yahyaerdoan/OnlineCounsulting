@using OnlineConsulting.UserInterface.Areas.Admin.Features.SystemRole
@model AssignRolePermissionsViewModel
@{
    ViewData["Title"] = "Assign Permissions";
    ViewData["SubPage1"] = "System Role List";
    ViewData["SubPage1Url"] = Url.Action("Index", "SystemRole", new { area = "Admin" });
    ViewData["SubPage2"] = "Assign Permissions";
    ViewData["SubPage2Url"] = Url.Action("Permissions", "SystemRole", new { area = "Admin", id = Model.RoleId });
    var totalGranted = Model.PermissionsByModule.Sum(m => m.Value.Count(p => p.IsChecked));
    var totalPermissions = Model.PermissionsByModule.Sum(m => m.Value.Count);
}

<div class="col-12">
    <div class="card">
        <div class="card-body d-flex align-items-center flex-wrap gap-3">
            <div class="avtar avtar-s bg-light-primary flex-shrink-0">
                <i class="ti ti-shield-lock f-20"></i>
            </div>
            <div class="flex-grow-1">
                <h5 class="mb-0">@Model.RoleName</h5>
                <span class="text-muted f-14">@totalGranted of @totalPermissions permissions granted</span>
            </div>
            <a href="@Url.Action("Index", "SystemRole")" class="btn btn-outline-secondary btn-sm">
                <i class="ti ti-arrow-left me-1"></i>Back to Roles
            </a>
        </div>
    </div>
</div>

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Assign Permissions</h5>
            <p class="text-muted mb-0 mt-1 f-14">Toggle the permissions this role should have, grouped by module. Unsaved changes are discarded if you leave without saving.</p>
        </div>
        <div class="card-body pt-3">
            <form method="post" id="permissionsForm">
                <div class="row">
                    @foreach (var module in Model.PermissionsByModule)
                    {
                        var moduleGranted = module.Value.Count(p => p.IsChecked);
                        <div class="col-md-6 col-xl-4">
                            <div class="card border mb-4">
                                <div class="card-header d-flex align-items-center justify-content-between py-2">
                                    <h6 class="mb-0">@module.Key</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-light-primary module-granted-count">@moduleGranted/@module.Value.Count</span>
                                        <a href="#" class="f-12 text-primary select-all-link" data-module="module-@module.Key">All</a>
                                        <span class="text-muted">/</span>
                                        <a href="#" class="f-12 text-secondary select-none-link" data-module="module-@module.Key">None</a>
                                    </div>
                                </div>
                                <div class="card-body py-2" data-module-group="module-@module.Key">
                                    @foreach (var permission in module.Value)
                                    {
                                        <div class="form-check form-switch mb-1">
                                            <input class="form-check-input input-primary module-permission-checkbox" type="checkbox" role="switch"
                                                   name="permissions" value="@permission.Value" id="perm-@permission.Value"
                                                   checked="@permission.IsChecked" />
                                            <label class="form-check-label f-14" for="perm-@permission.Value">@permission.Value</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-md-12 text-end mt-2">
                    <div class="d-grid gap-2 mt-2 text-center">
                        <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Save Permissions</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.select-all-link, .select-none-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var moduleKey = this.getAttribute('data-module');
                var checked = this.classList.contains('select-all-link');
                document.querySelectorAll('[data-module-group="' + moduleKey + '"] .module-permission-checkbox').forEach(function (checkbox) {
                    checkbox.checked = checked;
                });
            });
        });
    });
</script>
