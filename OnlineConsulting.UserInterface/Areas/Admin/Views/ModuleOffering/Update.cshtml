@using OnlineConsulting.UserInterface.Areas.Admin.Features.ModuleOffering
@model UpdateModuleOfferingViewModel
@{
    ViewData["Title"] = "Update Module Offering";
    ViewData["SubPage1"] = "Module Offerings";
    ViewData["SubPage1Url"] = Url.Action("Index", "ModuleOffering", new { area = "Admin" });
    ViewData["SubPage2"] = "Update Offering";
    ViewData["SubPage2Url"] = Url.Action("Update", "ModuleOffering", new { area = "Admin", id = Model.Id });
}
<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">Update Module Offering</h5>
            <p class="text-muted mb-0 mt-1 f-14">Key, billing cycle and price can't be changed once an offering exists - create a new offering for a real price change.</p>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <input type="hidden" asp-for="Id" />

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Key</label>
                            <input type="text" class="form-control" value="@Model.Key" disabled readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="name">Name</label>
                            <input type="text" class="form-control" id="name" asp-for="Name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Billing Cycle</label>
                            <input type="text" class="form-control" value="@Model.BillingCycle" disabled readonly />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Price</label>
                            <input type="text" class="form-control" value="@Model.Price.ToString("C")" disabled readonly />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label d-block">Visibility</label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" id="isPubliclyVisible" asp-for="IsPubliclyVisible" />
                                <label class="form-check-label" for="isPubliclyVisible">Publicly visible</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 text-end mt-3">
                        <div class="d-grid gap-2 mt-2 text-center">
                            <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Save</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
