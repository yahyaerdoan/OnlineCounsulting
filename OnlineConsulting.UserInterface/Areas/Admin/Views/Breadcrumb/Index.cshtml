@model IQueryable<ResultBreadcrumbDto>
@{
    ViewData["Title"] = "Breadcrumb List";
    ViewData["SubPage1"] = "Breadcrumb List";
    ViewData["SubPage1Url"] = Url.Action("Index", "Breadcrumb", new { area = "Admin" });
    int count = 1;
}

<script type="module">
    import { DataTable } from '/templates/admin-sky-template/able-pro-vanila-bootstrap-9.5.0/dist/assets/js/plugins/module.js';
    window.dt = new DataTable('#pc-dt-simple');
</script>

<div class="col-12">
    <div class="card table-card">
        <div class="card-header">
            <div class="d-sm-flex align-items-center justify-content-between">
                <h5 class="mb-3 mb-sm-0">Breadcrumb List</h5>
                <div>
                    @if (Model == null)
                    {
                        <a href="@Url.Action("Create","Breadcrumb")" class="btn btn-primary">Add UI Breadcrumb</a>
                    }
                </div>
            </div>
        </div>
        <div class="card-body pt-3">
            @if (Model != null)
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="pc-dt-simple">
                        <thead>
                            <tr>
                                <th>Count</th>
                                <th>Image - Title</th>
                                <th>Description</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td style="padding-left:2rem">@count</td>
                                    <td style="word-wrap: break-word; white-space: normal;">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <div class="flex-shrink-0">
                                                <img id="openImg" src="@item.ImageUrl" alt="user image"
                                                     class="rounded-circle" style="width: 60px; height: 60px; object-fit: cover;"
                                                     data-pc-animate="blur"
                                                     data-bs-toggle="modal"
                                                     data-bs-target="#animateModal"
                                                     data-url="@item.ImageUrl" />
                                            </div>
                                            <div class="flex-grow-1 ms-3 ">
                                                <h6 class="mb-0" style="word-wrap: break-word; white-space: normal;">@item.Title</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="word-wrap: break-word; white-space: normal;">@item.Description</td>
                                    <td>
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#modal-@item.Id" class="avtar avtar-xs btn-link-secondary detail-btn">
                                            <i class="ti ti-eye f-20"></i>
                                        </a>
                                        <a href="@Url.Action("Update","Breadcrumb",new{id=item.Id})" class="avtar avtar-xs btn-link-secondary">
                                            <i class="ti ti-edit f-20"></i>
                                        </a>
                                    </td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Detail Modal Start -->
                @foreach (var item in Model)
                {
                    <div id="modal-@item.Id" class="modal fade" tabindex="-1" aria-labelledby="detailModalCenterTitle" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content shadow-lg rounded-3 border-0">
                                <div class="modal-header bg-light border-0">
                                    <h5 class="modal-title fw-bold text-dark">@item.Title</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <div class="row align-items-center">

                                        <div class="col-md-12 text-center mb-3">
                                            <img src="@item.ImageUrl" alt="@item.Title" class="img-fluid rounded shadow-sm">
                                        </div>
                                        <div class="col-md-12">
                                            <h6 class="text-muted">@item.Title</h6>
                                            <p class="text-secondary">@item.Description</p>
                                        </div>
                                    </div>
                                    <hr class="my-3 mt-2">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0">
                                            <strong>Created Date:</strong> <span class="text-muted">@item.CreatedDate</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0">
                                            <strong>Created By:</strong> <span class="text-muted">@item.CreatedBy</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0">
                                            <strong>Updated Date:</strong> <span class="text-muted">@(string.IsNullOrWhiteSpace(item.UpdatedDate.ToString()) ? "No action has been taken yet." : item.UpdatedDate)</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0">
                                            <strong>Updated By:</strong> <span class="text-muted">@(string.IsNullOrWhiteSpace(item.UpdatedBy) ? "No action has been taken yet." : item.UpdatedBy)</span>
                                        </li>
                                    </ul>
                                </div>
                                <div class="modal-footer border-0">
                                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <!-- Detail Modal End -->
            }
            else
            {
                <div class="alert alert-success m-4" role="alert"> No data added yet! </div>
            }
        </div>
    </div>
</div>
<!-- Image Modal Start -->
<div class="modal fade modal-animate" id="animateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <img id="showImg" style="max-width:800px; object-fit:contain;" />
    </div>
</div>
<!-- Image Modal End -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const openButtons = document.querySelectorAll('#openImg');
        const showCoverImage = document.querySelector('#showImg');

        openButtons.forEach(button => {
            button.addEventListener('click', function () {
                const imgUrl = this.getAttribute('data-url');
                showCoverImage.setAttribute('src', imgUrl);
            });
        });
    });
</script>