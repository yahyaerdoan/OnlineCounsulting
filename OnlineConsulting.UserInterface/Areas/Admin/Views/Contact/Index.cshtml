@using OnlineConsulting.UserInterface.Areas.Admin.Features.Contact
@model ContactViewModel
@{
    ViewData["Title"] = "Contact Informations";
    ViewData["SubPage1"] = "Contact Informations";
    ViewData["SubPage1Url"] = Url.Action("Index", "Contact", new { area = "Admin" });
    int count = 1;
}

<script type="module">
    import { DataTable } from '/templates/admin-sky-template/able-pro-vanila-bootstrap-9.5.0/dist/assets/js/plugins/module.js';
    window.dt = new DataTable('#pc-dt-simple');
</script>

<div class="col-12">
    <div class="card table-card">
        <div class="card-header">
            <div class="d-sm-flex align-items-center justify-content-between">
                <h5 class="mb-3 mb-sm-0">Contact Information List</h5>
                <div>
                    @if (Model == null)
                    {
                        <a href="@Url.Action("Update","Contact")" class="btn btn-primary">Add Contact Informations</a>
                    }
                </div>
            </div>
        </div>
        <div class="card-body pt-3">
            <div class="table-responsive">
                <table class="table table-hover" id="pc-dt-simple">
                    <thead>
                        <tr>
                            <th>Count</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>Working Hours</th>
                            <th>Description</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            <tr>
                                <td style="padding-left:2rem">@count</td>
                                <td style ="word-wrap: break-word; white-space: normal;">@Model.Email</td>
                                <td>@Model.Phone</td>
                                <td>@Model.Address</td>
                                <td>@Model.WorkingHours</td>
                                <td style="word-wrap: break-word; white-space: normal;">@Model.Description</td>
                                <td>
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#modal1" class="avtar avtar-xs btn-link-secondary detail-btn">
                                        <i class="ti ti-eye f-20"></i>
                                    </a>
                                    <a href="@Url.Action("Update","Contact")" class="avtar avtar-xs btn-link-secondary">
                                        <i class="ti ti-edit f-20"></i>
                                    </a>
                                </td>
                            </tr>
                            count++;
                        }
                        else
                        {
                            <div class="alert alert-success m-4" role="alert"> No data added yet! </div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@if (Model != null)
{
<!-- Detail Modal Start -->
<div id="modal1" class="modal fade" tabindex="-1" aria-labelledby="detailModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-3 border-0">
            <div class="modal-header bg-light border-0">
                <h5 class="modal-title fw-bold text-dark">@Model.Email</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-12">
                        <h6 class="text-muted">Description</h6>
                        <p class="text-secondary">@Model.Description</p>
                    </div>
                    <div class="col-md-12">
                        <h6 class="text-muted">Address</h6>
                        <p class="text-secondary">@Model.Address</p>
                    </div>
                    <div class="col-md-12">
                        <h6 class="text-muted">Phone</h6>
                        <p class="text-secondary">@Model.Phone</p>
                    </div>
                    <div class="col-md-12">
                        <h6 class="text-muted">Email Address</h6>
                        <p class="text-secondary">@Model.Email</p>
                    </div>
                    <div class="col-md-12">
                        <h6 class="text-muted">Working Hours</h6>
                        <p class="text-secondary">@Model.WorkingHours</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Detail Modal End -->
}
