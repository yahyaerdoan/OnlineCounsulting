@model List<ResultUserDto>
@{
    ViewData["Title"] = "System User List";
    ViewData["SubPage1"] = "System User List";
    ViewData["SubPage1Url"] = Url.Action("Index", "SystemUser", new { area = "Admin" });
    int count = 1;
}

<script type="module">
    import { DataTable } from '/templates/admin-sky-template/able-pro-vanila-bootstrap-9.5.0/dist/assets/js/plugins/module.js';
    window.dt = new DataTable('#pc-dt-simple');
</script>

<div class="col-12">
    <div class="card table-card">
        <div class="card-header">
            <div class="d-sm-flex align-items-center justify-content-between">
                <h5 class="mb-3 mb-sm-0">System User List</h5>
                <div>
                    <a href="@Url.Action("Register","Account", new {area=""})" class="btn btn-primary">Add User</a>
                </div>
            </div>
        </div>
        <div class="card-body pt-3">
            @if (Model != null)
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="pc-dt-simple">
                        <thead>
                            <tr>
                                <th>Count</th>
                                <th>Full Name</th>
                                <th>UserName</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {


                                <tr>
                                    <td style="padding-left:2rem">@count</td>
                                    <td style="word-wrap: break-word; white-space: normal;">@item.FirstName @item.LastName</td>
                                    <td style="word-wrap: break-word; white-space: normal;">@item.Username</td>
                                    <td style="word-wrap: break-word; white-space: normal;">@item.Email</td>

                                    <td>
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#modal-@item.Id" class="avtar avtar-xs btn-link-secondary detail-btn">
                                            <i class="ti ti-eye f-20"></i>
                                        </a>
                                        <a href="@Url.Action("Update","SystemRole",new{id=item.Id})" class="avtar avtar-xs btn-link-secondary">
                                            <i class="ti ti-edit f-20"></i>
                                        </a>
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#deleteModalCenter" class="avtar avtar-xs btn-link-secondary delete-btn" data-id="@item.Id">
                                            <i class="ti ti-trash f-20"></i>
                                        </a>
                                    </td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Detail Modal Start -->
                @foreach (var item in Model)
                {
                    <div id="modal-@item.Id" class="modal fade" tabindex="-1" aria-labelledby="detailModalCenterTitle" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content shadow-lg rounded-3 border-0">
                                <div class="modal-header bg-light border-0">
                                    <h5 class="modal-title fw-bold text-dark">@item.FirstName @item.LastName</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    @*       <div class="row align-items-center">

                                        <div class="col-md-4 text-center">
                                            <img src="@item.ImgIcon.IconUrl" alt="Cover Image" class="img-fluid rounded shadow-sm">
                                        </div>
                                        <div class="col-md-8">
                                            <h6 class="text-muted">@item.Title</h6>
                                            <p class="text-secondary">@item.Description</p>
                                        </div>
                                    </div> *@
                                    <hr class="my-3 mt-2">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Role</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var role in item.Roles)
                                            {
                                                <tr>
                                                    <td>@role.Name</td>
                                                    <td>@role.Description </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    @*        <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0">
                                            <strong>Created Date:</strong> <span class="text-muted">Yahya</span>
                                        </li>
                                    </ul> *@
                                </div>
                                <div class="modal-footer border-0">
                                    <a href="@Url.Action("AssingARoleToUser","SystemUser", new {id = item.Id})" class="btn btn-outline-primary px-4">Manage My Role</a>
                                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <!-- Detail Modal End -->
            }
            else
            {
                <div class="alert alert-success m-4" role="alert"> No data added yet! </div>
            }
        </div>
    </div>
</div>
<!-- Delete Confirmation Modal Start -->
<div id="deleteModalCenter" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalCenterTitle">Delete Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    The record you selected will be deleted. Do you want to continue?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">No</button>
                <a href="#" id="confirmDeleteBtn" class="btn btn-danger">Yes</a>
            </div>
        </div>
    </div>
</div>
<!-- Delete Confirmation Modal End -->
<script>
        document.addEventListener('DOMContentLoaded', function () {
        const deleteButtons = document.querySelectorAll('.delete-btn');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

        deleteButtons.forEach(button => {
            button.addEventListener('click', function () {
                const itemId = this.getAttribute('data-id');
                // Silme bağlantısını günceller
                confirmDeleteBtn.setAttribute('href', `/Admin/SystemUser/Delete/${itemId}`);
            });
        });
    });
</script>

