@using OnlineConsulting.UserInterface.Areas.Admin.Features.HowIGetService
@model UpdateHowIGetServiceViewModel
@{
    ViewData["Title"] = "Update How I Get Service Stage";
    ViewData["SubPage1"] = "How I Get Service Stage List";
    ViewData["SubPage1Url"] = Url.Action("Index", "HowIGetService", new { area = "Admin" });
    ViewData["SubPage2"] = "Update How I Get Service Stage";
    ViewData["SubPage2Url"] = Url.Action("Update", "HowIGetService", new { area = "Admin", id = Model.Id });
}

<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">@Model.Title</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col">
                    <form id="contactForm" method="post">
                        <div class="row">
                            <input type="hidden" asp-for="Id" />
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="icon">Icon (CSS class name)</label>
                                    <input type="text" class="form-control" id="icon" placeholder="e.g. ti ti-truck" asp-for="Icon" />
                                    <span asp-validation-for="Icon" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="iconcolor">Icon Color (optional)</label>
                                    <input type="text" class="form-control" id="iconcolor" placeholder="e.g. #ff0000" asp-for="IconColor" />
                                    <span asp-validation-for="IconColor" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="title">Title</label>
                                    <input type="text" class="form-control" id="title" placeholder="Enter title" asp-for="Title" />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label" for="descriptionTextarea">Descripton</label>
                                    <textarea class="form-control" id="descriptionTextarea" rows="3" placeholder="Enter description" asp-for="Description"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12 text-end mt-3">
                                <div class="d-grid gap-2 mt-2 text-center">
                                    <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Update</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
