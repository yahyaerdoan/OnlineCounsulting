@model CreateImgIconDto
@{
    ViewData["Title"] = "Create New ImgIcon";
    ViewData["SubPage1"] = "ImgIcon List";
    ViewData["SubPage1Url"] = Url.Action("Index", "ImgIcon", new { area = "Admin" });
    ViewData["SubPage2"] = "Create ImgIcon";
    ViewData["SubPage2Url"] = Url.Action("Create", "ImgIcon", new { area = "Admin" });
}
<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">Create New Img Icon</h5>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="name">Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Enter name" asp-for="Name" /> 
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="image">Image</label>
                            <input class="form-control" id="image" type="file" asp-for="IconImage" />
                            <div class="text-muted" style="font-size: x-small;">
                                <span style="font-weight: bold;">*</span>Please ensure the image is <strong>70x70 pixels</strong> for the best results.
                            </div>
                            <span asp-validation-for="IconImage" accept=".png, .jpeg, .jpg, .gif" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label" for="description">Descripton</label>
                            <textarea class="form-control" id="description" rows="3" placeholder="Enter description" asp-for="Description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>                  
                    <div class="col-md-12 text-end mt-3">
                        <div class="d-grid gap-2 mt-2 text-center">
                            <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Save</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>