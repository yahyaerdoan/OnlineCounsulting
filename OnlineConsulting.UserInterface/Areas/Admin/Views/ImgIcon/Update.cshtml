@model UpdateImgIconDto
@{
    ViewData["Title"] = "Update Img Icon";
    ViewData["SubPage1"] = "Img Icon List";
    ViewData["SubPage1Url"] = Url.Action("Index", "ImgIcon", new { area = "Admin" });
    ViewData["SubPage2"] = "Update Img Icon";
    ViewData["SubPage2Url"] = Url.Action("Update", "ImgIcon", new { area = "Admin", id = Model.Id });
}

<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">@Model.Name</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-auto text-center">
                    <div style="position: relative; display: inline-block; text-align:center;">
                        <img src="@Model.IconUrl"
                             alt="user-image"
                             class="wid-150 rounded img-fluid"
                             style="width: 320px; height: 180px; border-radius: 8px; object-fit:cover;" />
                        <!-- Pencil Button -->
                        <button id="toggleFormButton"
                                style="position: absolute; top: 10px; right: 10px; background: none; border: none; padding: 0; cursor: pointer;">
                            <i class="ti ti-pencil" style="font-size: 16px; color: #007bff;"></i>
                        </button>
                    </div>
                    <div class="position-relative col-md-12 mt-2">
                        <div class="mb-3" id="updateImageForm" style="display: none;">
                            <form method="post" enctype="multipart/form-data" asp-action="UpdateImageFile" asp-controller="ImgIcon">
                                <input type="hidden" asp-for="Id" />
                                <input class="form-control" type="file" name="Image" accept=".png, .jpeg, .jpg, .gif" required />
                                <div class="text-muted" style="font-size: x-small;">
                                    <span style="font-weight: bold;">*</span>Please ensure the image is <strong>70x70 pixels</strong> for the best results.
                                </div>
                                <div class="d-grid gap-2 mt-3 text-center">
                                    <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Update</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <form id="contactForm" method="post">
                        <div class="row">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="IconUrl" />
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label" for="name">Name</label>
                                    <input type="text" id="name" class="form-control" placeholder="Enter first name" asp-for="Name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label" for="description">Descripton</label>
                                    <textarea class="form-control" id="description" rows="3" placeholder="Enter description" asp-for="Description"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12 text-end mt-3">
                                <div class="d-grid gap-2 mt-2 text-center">
                                    <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Update</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>