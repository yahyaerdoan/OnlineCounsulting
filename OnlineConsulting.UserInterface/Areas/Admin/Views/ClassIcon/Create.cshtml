@model CreateClassIconDto
@{
    ViewData["Title"] = "Create New Class Icon";
    ViewData["SubPage1"] = "Class Icon List";
    ViewData["SubPage1Url"] = Url.Action("Index", "ClassIcon", new { area = "Admin" });
    ViewData["SubPage2"] = "Create ClassIcon";
    ViewData["SubPage2Url"] = Url.Action("Create", "ClassIcon", new { area = "Admin" });
}

<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">Create New Class Icon</h5>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="name">Name</label>
                            <input type="text" id="name" class="form-control" placeholder="Enter name" asp-for="Name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="icon">Icon Class</label>
                            <input type="text" id="icon" class="form-control" placeholder="Enter icon" asp-for="IconClass" />
                            <span asp-validation-for="IconClass" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label" for="description">Descripton</label>
                            <textarea class="form-control" id="description" rows="3" placeholder="Enter description" asp-for="Description"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12 text-end mt-3">
                        <div class="d-grid gap-2 mt-2 text-center">
                            <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Save</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>