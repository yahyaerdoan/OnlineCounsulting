@model UpdateGalleryItemWithCategoryDto
@{
    ViewData["Title"] = "Update GalleryItem";
    ViewData["SubPage1"] = "GalleryItem List";
    ViewData["SubPage1Url"] = Url.Action("Index", "GalleryItem", new { area = "Admin" });
    ViewData["SubPage2"] = "Update GalleryItem";
    ViewData["SubPage2Url"] = Url.Action("Update", "GalleryItem", new { area = "Admin", id = Model.Id });
}

<div class="col-12">
    <div class="card p-3">
        <!-- Image Display Section -->
        <div class="card-header">
            <img src="@Model.ImageUrl" style="width: 320px; height: 180px; border-radius: 8px; object-fit:cover;" alt="user-image" class="mb-0 wid-150 rounded img-fluid" />
        </div>
        <div class="card-body">
            <!-- Form Section -->
            <div class="row">
                <div class="col">
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ImageUrl" />
                            <!-- Categories Section -->
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label">Categories</label>
                                    <div class="form-control" style="padding: 1rem;">
                                        <div class="row">
                                            @foreach (var category in ViewBag.GetGalleryCategories)
                                            {
                                                <div class="col-md-2 d-flex align-items-center" style="gap: 0.5rem; margin-bottom: 0.5rem;">
                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           id="category_@category.Id"
                                                           name="GalleryCategoryIds"
                                                           value="@category.Id"
                                                    @(Model.GalleryCategories?.Any(x => x.Id == category.Id) == true ? "checked" : "") />
                                                    <label class="form-check-label" for="category_@category.Id">
                                                        @category.Name
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <span asp-validation-for="GalleryCategoryIds" class="text-danger"></span>
                                </div>
                            </div>
                            <!-- Description Section -->
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label" for="description">Description</label>
                                    <textarea class="form-control" id="description" rows="3" placeholder="Enter description" asp-for="Description"></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                            <!-- Submit Button -->
                            <div class="col-md-12 text-end mt-3">
                                <div class="d-grid gap-2 mt-2 text-center">
                                    <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center">
                                        <i class="ti ti-bookmark me-1"></i>Update
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>