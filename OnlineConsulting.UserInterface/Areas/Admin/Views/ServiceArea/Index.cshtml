@using OnlineConsulting.UserInterface.Areas.Admin.Features.ServiceArea
@model List<ServiceAreaListItemViewModel>
@{
    ViewData["Title"] = "Service Area List";
    ViewData["SubPage1"] = "Service Area List";
    ViewData["SubPage1Url"] = Url.Action("Index", "ServiceArea", new { area = "Admin" });
    int count = 1;
    var stateCount = Model.Select(s => s.State).Distinct().Count();
}

<script type="module">
    import { DataTable } from '/templates/admin-sky-template/able-pro-vanila-bootstrap-9.5.0/dist/assets/js/plugins/module.js';
    window.dt = new DataTable('#pc-dt-simple');
</script>

<div class="col-12">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <div class="avtar avtar-s bg-light-primary flex-shrink-0">
                        <i class="ti ti-map-pin f-20"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0 text-muted f-w-400">Total Service Areas</h6>
                        <h4 class="mb-0">@Model.Count</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <div class="avtar avtar-s bg-light-success flex-shrink-0">
                        <i class="ti ti-map f-20"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0 text-muted f-w-400">States Covered</h6>
                        <h4 class="mb-0">@stateCount</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-12">
    <div class="card table-card">
        <div class="card-header">
            <div class="d-sm-flex align-items-center justify-content-between">
                <h5 class="mb-3 mb-sm-0">Service Area List</h5>
                <div>
                    <a href="@Url.Action("Create","ServiceArea")" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Add Service Area</a>
                </div>
            </div>
        </div>
        <div class="card-body pt-3">
            @if (Model is { Count: > 0 })
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="pc-dt-simple">
                        <thead>
                            <tr>
                                <th>Count</th>
                                <th>Area</th>
                                <th>Slug</th>
                                <th>Order</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td style="padding-left:2rem">@count</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avtar avtar-s bg-light-primary flex-shrink-0">
                                                <i class="ti ti-map-pin f-18"></i>
                                            </div>
                                            <div class="ms-3">
                                                <h6 class="mb-0" style="word-wrap: break-word; white-space: normal;">@item.Name</h6>
                                                <span class="text-muted f-12">@item.State</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><code>@item.Slug</code></td>
                                    <td>@item.DisplayOrder</td>
                                    <td>
                                        <a href="@Url.Action("Update","ServiceArea",new{id=item.Id})" class="avtar avtar-xs btn-link-secondary" title="Edit">
                                            <i class="ti ti-edit f-20"></i>
                                        </a>
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#deleteModalCenter" class="avtar avtar-xs btn-link-secondary delete-btn" data-id="@item.Id" title="Delete">
                                            <i class="ti ti-trash f-20"></i>
                                        </a>
                                    </td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="ti ti-map-pin f-40 text-muted"></i>
                    <p class="text-muted mb-3 mt-2">No service areas added yet.</p>
                    <a href="@Url.Action("Create","ServiceArea")" class="btn btn-primary"><i class="ti ti-plus me-1"></i>Add Service Area</a>
                </div>
            }
        </div>
    </div>
</div>
<!-- Delete Confirmation Modal Start -->
<div id="deleteModalCenter" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="deleteModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalCenterTitle">Delete Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    The record you selected will be deleted. Do you want to continue?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">No</button>
                <a href="#" id="confirmDeleteBtn" class="btn btn-danger">Yes</a>
            </div>
        </div>
    </div>
</div>
<!-- Delete Confirmation Modal End -->
<script>
        document.addEventListener('DOMContentLoaded', function () {
        const deleteButtons = document.querySelectorAll('.delete-btn');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

        deleteButtons.forEach(button => {
            button.addEventListener('click', function () {
                const itemId = this.getAttribute('data-id');
                confirmDeleteBtn.setAttribute('href', `/admin/service-areas/${itemId}/delete`);
            });
        });
    });
</script>
