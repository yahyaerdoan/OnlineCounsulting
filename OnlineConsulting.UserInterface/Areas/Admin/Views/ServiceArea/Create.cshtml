@using OnlineConsulting.UserInterface.Areas.Admin.Features.ServiceArea
@model CreateServiceAreaViewModel
@{
    ViewData["Title"] = "Create New Service Area";
    ViewData["SubPage1"] = "Service Area List";
    ViewData["SubPage1Url"] = Url.Action("Index", "ServiceArea", new { area = "Admin" });
    ViewData["SubPage2"] = "Create Service Area";
    ViewData["SubPage2Url"] = Url.Action("Create", "ServiceArea", new { area = "Admin" });
}
<div class="col-12">
    <div class="card p-3">
        <div class="card-header">
            <h5 class="mb-0">Create New Service Area</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="name">Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Enter name" asp-for="Name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="state">State</label>
                            <input type="text" class="form-control" id="state" placeholder="Enter state" asp-for="State" />
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label" for="introText">Intro Text</label>
                            <textarea class="form-control" id="introText" rows="3" placeholder="Enter intro text" asp-for="IntroText"></textarea>
                            <span asp-validation-for="IntroText" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label" for="displayOrder">Display Order</label>
                            <input type="number" class="form-control" id="displayOrder" asp-for="DisplayOrder" />
                            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12 text-end mt-3">
                        <div class="d-grid gap-2 mt-2 text-center">
                            <button class="btn btn-outline-primary d-inline-flex text-center justify-content-center"> <i class="ti ti-bookmark me-1"></i>Save</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
