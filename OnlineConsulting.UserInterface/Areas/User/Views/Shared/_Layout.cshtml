@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BreadcrumbDisplay"] = "none";
}

@section Styles {
    <link rel="stylesheet" href="" />
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
}
<main class="page-content py-5" style="background-color: #f8f9fa;">
    <div class="container">
        <!-- Top Info Section -->
        <div class="row mb-4">
            <div class="col-12">
                @await Component.InvokeAsync("DashboardUpperInfoComponentPartial")
            </div>
        </div>

        <!-- Dashboard Layout -->
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 mb-4 mb-lg-0">
                <div class="bg-white rounded shadow-sm p-3 h-100">
                    @await Component.InvokeAsync("DashboardSidebarComponentPartial")
                </div>
            </div>

            <!-- Main Dashboard Content -->
            <div class="col-md-9 col-lg-10">
                <div class="bg-white rounded shadow-sm p-4">
                    <div class="tab-content dashboard-content">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="mt-5 border-top pt-4 pb-3 text-center text-muted small">
        <div class="container">
            <div>&copy; @DateTime.Now.Year Online Consulting. All rights reserved.</div>
            <div>
                <a href="/privacy" class="text-muted me-3">Privacy Policy</a>
                <a href="/terms" class="text-muted">Terms of Service</a>
            </div>
        </div>
    </footer>
</main>

@section Scripts {
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
