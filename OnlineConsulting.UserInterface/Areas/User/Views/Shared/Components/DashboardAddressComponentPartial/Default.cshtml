<div class="tab-pane show active" id="address">
    <div class="container px-0">
        <h6 class="fw-bold mb-4">
            @*<i class="bi bi-geo-alt-fill text-primary me-2"></i>*@ Manage Your Addresses
        </h6>

        <!-- Address Tabs Navigation -->
        <ul class="nav nav-pills mb-3" id="addressTab" role="tablist">
            <li class="nav-item" role="presentation">
                <a class="nav-link active" id="addresslist-tab" data-bs-toggle="pill" href="#addresslist" role="tab" aria-controls="addresslist" aria-selected="true">
                    <i class="bi bi-house-door me-1"></i> My Addresses
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a class="nav-link" id="createaddress-tab" data-bs-toggle="pill" href="#createaddress" role="tab" aria-controls="createaddress" aria-selected="false">
                    <i class="bi bi-plus-circle me-1"></i> Add New Address
                </a>
            </li>
        </ul>

        <!-- Address Tab Content -->
        <div class="tab-content border rounded bg-white p-4 shadow-sm" id="addressTabContent">

            <!-- Address List -->
            <div class="tab-pane fade show active" id="addresslist" role="tabpanel" aria-labelledby="addresslist-tab">
                @await Component.InvokeAsync("DashboardAddressListComponentPartial")
            </div>

            <!-- Create Address Form -->
            <div class="tab-pane fade" id="createaddress" role="tabpanel" aria-labelledby="createaddress-tab">
                @await Component.InvokeAsync("DashboardAddressCreateComponentPartial")
            </div>
        </div>
    </div>
</div>

<style>
    #addressTab .nav-link {
        color: #333;
        font-weight: 500;
        background: transparent;
        border: none;
        box-shadow: none;
        transition: color .2s;
    }

        #addressTab .nav-link.active {
            color: #ff5951;
            font-weight: bold;
            background: transparent;
            border: none;
            box-shadow: none;
        }

        #addressTab .nav-link:hover {
            color: #ff5951;
        }
</style>
