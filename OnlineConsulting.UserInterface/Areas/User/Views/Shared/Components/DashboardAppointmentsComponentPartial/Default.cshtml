@using OnlineConsulting.UserInterface.Areas.User.Features.Appointment
@model List<UserAppointmentListItemViewModel>
@{
    var appointments = Model ?? new List<UserAppointmentListItemViewModel>();
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="tab-pane fade show active" id="appointments">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h6 class="mb-0 fw-bold">My Appointments</h6>
        <a href="@Url.Action("Book", "Appointment", new { area = "" })" class="btn btn-sm btn rounded-2">
            <i class="bi bi-calendar-plus me-1"></i>Book New
        </a>
    </div>

    @if (!appointments.Any())
    {
        <div class="alert alert">
            You have no appointments yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Service</th>
                        <th>Scheduled</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < appointments.Count; i++)
                    {
                        var appointment = appointments[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@appointment.ServiceName</td>
                            <td>@appointment.ScheduledStart.ToString("f", CultureInfo.CurrentCulture)</td>
                            <td>
                                <span class="badge
                                    @(appointment.Status == "Pending" ? "bg-warning text-dark" :
                                      appointment.Status == "Confirmed" ? "bg-primary" :
                                      appointment.Status == "Completed" ? "bg-success" :
                                      appointment.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                    @appointment.Status
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(appointment.NavigationUrl))
                                {
                                    <a href="@appointment.NavigationUrl" target="_blank" class="btn btn-sm btn rounded-2" title="Navigate">
                                        <i class="bi bi-geo-alt"></i>
                                    </a>
                                }
                                @if (appointment.CanCancel)
                                {
                                    <form asp-area="User" asp-controller="Appointment" asp-action="Cancel" asp-route-id="@appointment.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn rounded-2" title="Cancel">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
