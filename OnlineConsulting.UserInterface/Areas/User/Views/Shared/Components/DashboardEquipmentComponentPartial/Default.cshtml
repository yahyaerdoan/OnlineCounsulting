@using OnlineConsulting.UserInterface.Areas.User.Features.Equipment
@model List<UserEquipmentListItemViewModel>
@{
    var equipment = Model ?? new List<UserEquipmentListItemViewModel>();
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="tab-pane fade show active" id="equipment">
    <h6 class="mb-4 fw-bold">My Equipment</h6>

    @if (!equipment.Any())
    {
        <div class="alert alert">
            No equipment on file yet. Equipment is added by our technicians during a service visit.
        </div>
    }
    else
    {
        <div class="accordion" id="equipmentAccordion">
            @for (int i = 0; i < equipment.Count; i++)
            {
                var item = equipment[i];
                <div class="accordion-item mb-2">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#equipment-@i">
                            <i class="bi bi-tools me-2"></i>
                            <strong class="me-2">@item.Type</strong>
                            <span class="text-muted">@item.Brand @item.Model</span>
                        </button>
                    </h2>
                    <div id="equipment-@i" class="accordion-collapse collapse" data-bs-parent="#equipmentAccordion">
                        <div class="accordion-body">
                            <div class="row mb-3">
                                <div class="col-sm-4"><strong>Serial Number:</strong> @(item.SerialNumber ?? "-")</div>
                                <div class="col-sm-4"><strong>Installed:</strong> @(item.InstallDate?.ToString("MMM d, yyyy") ?? "-")</div>
                                <div class="col-sm-4"><strong>Warranty Until:</strong> @(item.WarrantyExpiresAt?.ToString("MMM d, yyyy") ?? "-")</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <p class="text-muted">@item.Notes</p>
                            }

                            <h6 class="mt-3 mb-2">Service History</h6>
                            @if (!item.ServiceHistory.Any())
                            {
                                <p class="text-muted mb-0">No service visits recorded for this equipment yet.</p>
                            }
                            else
                            {
                                <ul class="list-group">
                                    @foreach (var workOrder in item.ServiceHistory)
                                    {
                                        <li class="list-group-item">
                                            <div class="d-flex justify-content-between">
                                                <strong>@(workOrder.CompletedAt?.ToString("MMM d, yyyy") ?? "In progress")</strong>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(workOrder.TechnicianNotes))
                                            {
                                                <p class="mb-0 text-muted">@workOrder.TechnicianNotes</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(workOrder.PartsUsed))
                                            {
                                                <p class="mb-0 text-muted"><small><em>Parts used: @workOrder.PartsUsed</em></small></p>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
