@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}


<style>
    .nav-link:hover,
    .text-active-orange {
        color: #ff5951 !important;
        font-weight: 600;
    }
</style>

<ul role="tablist" class="nav flex-column dashboard-list">
    <li>
        <a href="@Url.Action("Index","Dashboard", new { area="User" })"
           class="nav-link @(currentController == "Dashboard" && currentAction == "Index" ? "active text-active-orange" : "")">
            <i class="bi bi-speedometer2 me-2"></i> Dashboard
        </a>
    </li>
    <li>
        <a href="@Url.Action("Order","Dashboard", new { area="User" })"
           class="nav-link @(currentController == "Dashboard" && currentAction == "Order" ? "active text-active-orange" : "")">
            <i class="bi bi-bag-check me-2"></i> Orders
        </a>
    </li>
    <li>
        <a href="@Url.Action("Download","Dashboard", new { area="User" })"
           class="nav-link @(currentController == "Dashboard" && currentAction == "Download" ? "active text-active-orange" : "")">
            <i class="bi bi-download me-2"></i> Downloads
        </a>
    </li>
    <li>
        <a href="@Url.Action("Address","Dashboard", new { area="User" })"
           class="nav-link @(currentController == "Dashboard" && currentAction == "Address" ? "active text-active-orange" : "")">
            <i class="bi bi-geo-alt me-2"></i> Addresses
        </a>
    </li>
    <li>
        <a href="@Url.Action("Account","Dashboard", new { area="User" })"
           class="nav-link @(currentController == "Dashboard" && currentAction == "Account" ? "active text-active-orange" : "")">
            <i class="bi bi-person-gear me-2"></i> Profile
        </a>
    </li>
    <li>
        <a href="@Url.Action("Logout", "Account", new { area = "" })"
           class="nav-link text-danger">
            <i class="bi bi-box-arrow-right me-2"></i> Logout
        </a>
    </li>
    <li class="mt-3">
        @{
            bool isOnline = false;

            if (Context.User.Identity != null && Context.User.Identity.IsAuthenticated)
            {
                isOnline = true;
            }
        }

        @if (isOnline)
        {
            <span class="text-success">
                <i class="bi bi-circle-fill me-1"></i> Online
            </span>
        }
        else
        {
            <span class="text-muted">
                <i class="bi bi-circle me-1"></i> Offline
            </span>
        }
    </li>
</ul>
