@model List<ResultOrderDto>
@{
    var orders = Model ?? new List<ResultOrderDto>();
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="tab-pane fade show active" id="orders">
    <h6 class="mb-4 fw-bold">My Orders</h6>

    @if (!orders.Any())
    {
        <div class="alert alert">
            You have no orders yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Ordered At</th>
                        <th>Order Status</th>
                        <th>Payment Status</th>
                        <th>Order Number</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < orders.Count; i++)
                    {
                        var order = orders[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@order.CreatedDate?.ToString("f", CultureInfo.CurrentCulture)</td>
                            <td>
                                <span class="badge
                                    @(order.OrderStatus == "Pending" ? "bg-warning text-dark" :
                                      order.OrderStatus == "Paid" ? "bg-success" :
                                      order.OrderStatus == "Cancelled" ? "bg-danger" : "bg-secondary")">
                                    @order.OrderStatus
                                </span>
                            </td>
                            <td>
                                <span class="badge
                                    @(order.PaymentStatus == "Pending" ? "bg-warning text-dark" :
                                      order.PaymentStatus == "Paid" ? "bg-success" :
                                      order.PaymentStatus == "Failed" ? "bg-danger" : "bg-secondary")">
                                    @order.PaymentStatus
                                </span>
                            <td>@order.OrderNumber</td>
                            <td>
                                <a href="@Url.Action("OrderDetail", "Dashboard", new { id = order.Id })" class="btn btn-sm btn btn rounded-2">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
