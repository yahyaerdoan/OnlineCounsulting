@using OnlineConsulting.UserInterface.Features.Account
@model RegisterViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Register";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLowerInvariant();
    var recaptchaSiteKey = Configuration["Recaptcha:SiteKey"];
}
<main class="page-content">
    <div class="register-page section-ptb">
        <div class="container">
            <div class="row">
                <div class="col-lg-7 col-md-12 m-auto">
                    <div class="login-register-wrapper">
                        <!-- login-register-tab-list start -->
                        <div class="login-register-tab-list nav">
                            <a class="@(currentAction == "login" ? "active" : "")" href="@Url.Action("Login", "Account")">
                                <h4>login</h4>
                            </a>
                            <a class="@(currentAction == "register" ? "active" : "")" href="@Url.Action("Register", "Account")">
                                <h4>register</h4>
                            </a>
                        </div>
                        <!-- login-register-tab-list end -->
                        <div class="tab-content">
                            <div id="lg1" class="tab-pane active">
                                <div class="login-form-container">
                                    <div class="login-register-form">
                                        <form asp-action="Register" asp-controller="Account" method="post">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="login-input-box">
                                                <div class="form-group mb-3">
                                                    <input type="text" asp-for="FirstName" autocomplete="off" class="form-control mb-1" placeholder="First Name" />
                                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                                </div>

                                                <div class="form-group mb-3">
                                                    <input type="text" asp-for="LastName" autocomplete="off" class="form-control mb-1" placeholder="Last Name" />
                                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                                </div>

                                                <div class="form-group mb-3">
                                                    <input type="text" asp-for="UserName" autocomplete="off" class="form-control mb-1" placeholder="User Name" />
                                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                                </div>

                                                <div class="form-group mb-3">
                                                    <input type="email" asp-for="Email" autocomplete="off" class="form-control mb-1" placeholder="Email" />
                                                    <span asp-validation-for="Email" class="text-danger"></span>
                                                </div>

                                                <div class="form-group mb-3">
                                                    <input type="password" asp-for="Password" class="form-control mb-1" autocomplete="new-password" placeholder="Password" />
                                                    <span asp-validation-for="Password" class="text-danger"></span>
                                                </div>

                                                <div class="form-group mb-3">
                                                    <input type="password" asp-for="ConfirmPassword" class="form-control mb-1" autocomplete="new-password" placeholder="Confirm Password" />
                                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                                </div>

                                            </div>
                                            <div class="mb-4 flex items-center space-x-2">
                                                <input type="checkbox">
                                                <label>I agree to <a href="#" class="text-danger">Conditions</a> of Use and <a href="#" class="text-danger">Privacy Notice</a>.</label>
                                            </div>
                                            <div class="form-group mb-3 d-flex justify-content-center">
                                                <div class="g-recaptcha" data-sitekey="@recaptchaSiteKey"></div>
                                            </div>
                                            <script src="https://www.google.com/recaptcha/api.js"></script>
                                            <div class="row text-center">
                                                <div class="button-box">
                                                    <button class="register-btn btn rounded-2" type="submit"><span>Register</span></button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>