@{
    ViewData["Title"] = "Checkout";
    ViewData["SubPage1"] = "Checkout";
}

<main class="page-content">

    <div class="checkout-main-content section-ptb">
        <div class="container">
            <!-- checkout-details-wrapper start -->
            <div class="checkout-details-wrapper">
                <div class="row">
                    @await Component.InvokeAsync("CheckoutBillingDetailsComponentPartial", new { cartId = @ViewBag.cartId })

                    @await Component.InvokeAsync("CheckoutOrderComponentPartial")

                </div>
            </div>
            <!-- checkout-details-wrapper end -->
        </div>
    </div>
</main>