@model CartViewModel
@{
    ViewData["Title"] = "Cart";
    ViewData["SubPage1"] = "Cart";
    int count = 1;
    var cartId = Model?.CartId ?? Guid.Empty;
    var items = Model?.Items ?? [];
}
<main class="page-content">
    <div class="cart-main-content section-ptb">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="cart-table">
                        @if (items.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Count</th>
                                            <th class="cart-product-name">Service Name</th>
                                            <th class="plantmore-product-price">Unit Price</th>
                                            <th class="plantmore-product-subtotal">Tax Rate (%)</th>
                                            <th class="plantmore-product-subtotal">Tax Amount</th>
                                            <th class="plantmore-product-subtotal">Subtotal</th>
                                            <th class="plantmore-product-subtotal">Total Price</th>
                                            <th class="plantmore-product-remove">Remove</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in items)
                                        {
                                            <tr>
                                                <td style="padding-left:2rem">@count</td>
                                                <td class="plantmore-product-name">@item.ServiceTitle</td>
                                                <td class="plantmore-product-price">@item.Price.ToUsd()</td>
                                                <td class="product-subtotal">@item.TaxRate%</td>
                                                <td class="product-subtotal">@item.TaxAmount.ToUsd()</td>
                                                <td class="product-subtotal">@item.SubTotalPrice.ToUsd()</td>
                                                <td class="product-subtotal">@item.TotalPrice.ToUsd()</td>
                                                <td class="plantmore-product-remove">
                                                    <form asp-action="RemoveBasketItem" asp-controller="Cart" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <button class="remove-btn" type="submit" title="Remove">
                                                            <i class="zmdi zmdi-delete"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                            count++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <!-- Totals section -->
                            <div class="row">
                                <div class="col-md-8">
                                    <div class="coupon-all">
                                        <div class="coupon2">
                                            <a href="@Url.Action("Index", "Service")" class="btn continue-btn">Continue Shopping</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 ml-auto">
                                    <div class="cart-page-total">
                                        <h2>Cart Totals</h2>
                                        <ul>
                                            <li>Subtotal <span>@Model!.SubTotal.ToUsd()</span></li>
                                            <li>Tax Total <span>@items.Sum(x => x.TaxAmount).ToUsd()</span></li>
                                            <li>Total <span>@Model!.Total.ToUsd()</span></li>
                                        </ul>
                                        <a href="@Url.Action("Index", "Checkout", new { cartId = cartId })" class="proceed-checkout-btn">Proceed to Checkout</a>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center mt-4">
                                <strong>Your cart is currently empty.</strong><br />
                                <a href="@Url.Action("Index","Service")" class="btn continue-btn mt-3">Continue Shopping</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
