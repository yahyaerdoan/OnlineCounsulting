@using System.Text.Json.Nodes
@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var fullUrl = $"{baseUrl}{Context.Request.Path}{Context.Request.QueryString}";
    var siteName = "ComfortPro";
    var searchPath = "/search";
    var fullSearchTarget = $"{baseUrl}{searchPath}?q={{search_term_string}}";

    var websiteJsonLd = new JsonObject
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = siteName,
        ["url"] = baseUrl,
        ["potentialAction"] = new JsonObject
        {
            ["@type"] = "SearchAction",
            ["target"] = fullSearchTarget,
            ["query-input"] = "required name=search_term_string"
        }
    }.ToJsonString();
    var title = ViewData["Title"]
        ?? "ComfortPro | Licensed HVAC Repair, Installation & Maintenance";

    var description = ViewData["MetaDescription"]
        ?? "ComfortPro is your local licensed & insured HVAC company - 24/7 emergency repair, installation, and maintenance plans for heating, cooling, and indoor air quality. Book online in minutes.";

    var keywords = ViewData["MetaKeywords"]
        ?? "HVAC repair, air conditioning repair, heating repair, furnace installation, AC installation, HVAC maintenance plan, emergency HVAC service, licensed HVAC contractor, indoor air quality";

    // Dynamic OG Image
    var imagePath = Url.Content("~/Resource/LocalStorage/WhatWeProvide-Images/whatweprovide.png");
    var ogImageUrl = baseUrl + imagePath;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="keywords" content="@keywords" />
    <meta name="author" content="ComfortPro" />

    <!-- Open Graph Tags -->
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta property="og:url" content="@fullUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Canonical -->
    <link rel="canonical" href="@fullUrl" />

    @await Component.InvokeAsync("LayoutHeadViewComponentPartial")
    @RenderSection("Styles", required: false)

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">@Html.Raw(websiteJsonLd)</script>

</head>

<body>
    <div class="main-wrapper">
        @await Component.InvokeAsync("LayoutHeaderAreaComponentPartial")
        @await Component.InvokeAsync("LayoutBredcrumbComponentPartial")

        @RenderBody()

        @await Component.InvokeAsync("LayoutFooterAreaViewComponentPartial")
    </div>

    @await Component.InvokeAsync("LayoutJavaScriptViewComponentPartial")
    <partial name="_ValidationScriptsPartial" />
    @RenderSection("Scripts", required: false)
</body>
</html>
