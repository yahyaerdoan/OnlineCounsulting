@model List<CategoryResponse>
@{
    var colorClasses = new[] { "malachite", "sunglow", "mariner", "brilliantrose", "shakespeare", "deyork" };
    int i = 0;
}

<div class="our-course-categories-area section-ptb">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 m-auto">
                <!-- section-title -->
                <div class="section-title-three">
                    <h4 style="text-transform:capitalize">Your Comfort, Our Priority</h4>
                    <h3 style="text-transform:capitalize;">Home Services We Provide</h3>
                    <p>
                        From routine maintenance to emergency repairs and full system installs, ComfortPro's
                        licensed technicians keep your home comfortable year-round. Explore our service categories below:
                    </p>
                </div><!--// section-title -->
            </div>
        </div>
        <div class="row">
            <div class="col">
                <div class="course-categories-wrap">
                    @foreach (var item in Model)
                    {
                        var colorClass = colorClasses[i % colorClasses.Length];
                        i++;
                        <div class="coustom-col-2" style="max-width:30px;">
                            <!-- single-course-categories -->
                            <div class="single-course-categories @colorClass">
                                <div class="item-inner">
                                    <div class="cours-icon">
                                        <i class="@item.Icon" style="font-size:48px; color:@(item.IconColor ?? "inherit")"></i>
                                    </div>
                                    <div class="cours-title">
                                        <h5>@item.Title</h5>
                                    </div>
                                </div>
                            </div>
                            <!--// single-course-categories -->
                        </div>
                    }
                </div>
            </div>
            <div class="all-course-btn">
                <a href="@Url.Action("Index", "Service")" class="all-course" style="text-transform: capitalize">All Services</a>
            </div>
        </div>
    </div>
</div>