
<!-- Register Now Area -->
<div class="register-now-area">
    <div class="container">
        <div class="row no-gutters">
            <div class="col-lg-5">
                <div class="register-wrap">
                    <div class="register-inner">
                        <div class="register-title text-center">
                            <h5>Ready to get started?</h5>
                            <h3>Book a Free Consultation</h3>
                        </div>
                        <div class="register-from-area">
                            <p class="text-center text-white mb-4">
                                Pick a service and a time that works for you &mdash; our team will confirm
                                your appointment shortly after.
                            </p>
                            <div class="submit-button text-center">
                                <a href="@Url.Action("Book", "Appointment", new { area = "" })">Book Now</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--// Register Now Area -->
