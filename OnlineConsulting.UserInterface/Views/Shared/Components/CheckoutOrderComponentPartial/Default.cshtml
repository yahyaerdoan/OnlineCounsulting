@using OnlineConsulting.UserInterface.Features.Cart
@model List<CartLineViewModel>

<div class="col-lg-6 col-md-6">
    <div class="your-order-wrapper">
        <h3 class="shoping-checkboxt-title">Your Order</h3>

        <div class="your-order-wrap">
            <!-- Order Table -->
            <div class="your-order-table table-responsive">
                <table class="table table-borderless align-middle">
                    <thead class="text-dark">
                        <tr>
                            <th class="product-name">Service</th>
                            <th class="product-total">Total</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Any())
                    {
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="text-start">
                                        <div class="fw-semibold">@item.ServiceTitle</div>
                                        <div class="text-muted small">Quantity: @item.Quantity</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-medium">@item.TotalPrice.ToUsd()</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-start">Subtotal</th>
                                <td class="text-center text-muted">@Model.Sum(x => x.SubTotalPrice).ToUsd()</td>
                            </tr>
                            <tr>
                                <th class="text-start">Tax</th>
                                <td class="text-center text-muted">@Model.Sum(x => x.TaxAmount).ToUsd()</td>
                            </tr>
                            <tr class="order-total">
                                <th class="text-start">Total</th>
                                <td class="text-center fw-bold fs-6">@Model.Sum(x => x.TotalPrice).ToUsd()</td>
                            </tr>
                        </tfoot>
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted">Your basket is empty.</td>
                        </tr>
                    }
                </table>

            </div>

            <!-- Payment Section -->
            <div class="payment-method mt-0">
                <h4>Credit Card Payment</h4>
                <div class="payment-content">
                    @* PlaceOrder creates the Order first (client secret can't exist before it does), then
                       redirects to /checkout/confirm which mounts the Stripe Payment Element for 3DS/SCA -
                       see CheckoutController.PlaceOrder/Confirm/Return. *@
                    <form method="post" asp-action="PlaceOrder" asp-controller="Checkout" asp-route-cartId="@ViewBag.cartId">
                        <button type="submit" class="btn btn-large rounded-2 w-100">Place Order</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
