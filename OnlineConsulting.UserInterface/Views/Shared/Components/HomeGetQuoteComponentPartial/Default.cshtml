
<!-- Get a Free Quote Area -->
<div class="get-quote-area section-ptb" style="background-color:#f8f9fa;">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-5">
                <h4 style="color:#FF5951;">Free, No-Obligation Estimate</h4>
                <h3 class="fw-bold mb-3">Get a Fast Quote Today</h3>
                <p class="text-muted mb-4">
                    Tell us a little about what you need and one of our licensed technicians
                    will follow up shortly &mdash; no pressure, no obligation.
                </p>
                <ul class="list-unstyled">
                    <li class="mb-2"><i class="fas fa-check me-2" style="color:#FF5951;"></i>Response within one business day</li>
                    <li class="mb-2"><i class="fas fa-check me-2" style="color:#FF5951;"></i>Upfront, transparent pricing</li>
                    <li class="mb-2"><i class="fas fa-check me-2" style="color:#FF5951;"></i>Licensed &amp; insured technicians</li>
                </ul>
            </div>
            @await Component.InvokeAsync("ContactMessageComponentPartial")
        </div>
    </div>
</div>
