@using OnlineConsulting.UserInterface.Areas.Admin.Features.SocialMedia
@model List<SocialMediaListItemViewModel>

<!-- top-social -->
<div class="top-social">
    <ul>
        @foreach (var item in Model)
        {
            <li><a href="@item.Url"><i class="@item.Icon" style="color:@(item.IconColor ?? "inherit")"></i></a></li>
        }
    </ul>
</div>
<!--// top-social -->
