@using OnlineConsulting.UserInterface.ViewComponents.HomeViewComponents.HomeSliderViewComponents
@model HomeSliderViewModel

<div class="hero-slider">
    <div class="hero-slider-active owl-carousel">
        @foreach (var item in Model.Slides)
        {
            <div class="singleSlide" data-black-overlay="1">
                <div class="itemBg">
                    <img src="@item.ImageUrl" alt="Slider item">
                </div>
                <!-- Hero Content One Start -->
                <div class="container">
                    <div class="hero-content-one">
                        <div class="row">
                            <div class="col">
                                <div class="slider-text-info">
                                    <h1>
                                        <span class="hero-slide-title">@item.Title </span> <br>
                                        <span class="hero-slide-subtitle"> @item.Description</span>
                                    </h1>
                                    <div class="d-flex flex-wrap gap-3 mt-3">
                                        <a href="@Url.Action("Book", "Appointment", new { area = "" })" class="btn slider-btn"><span>Schedule Service</span></a>
                                        @if (!string.IsNullOrWhiteSpace(Model.Phone))
                                        {
                                            <a href="tel:@Model.Phone" class="btn slider-btn slider-btn-outline"><span><i class="fas fa-phone-alt me-2"></i>Call @Model.Phone</span></a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Index", "AboutUs", new { area = "" })" class="btn slider-btn slider-btn-outline"><span>About Us</span></a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Hero Content One End -->
            </div>
        }
    </div>
</div>