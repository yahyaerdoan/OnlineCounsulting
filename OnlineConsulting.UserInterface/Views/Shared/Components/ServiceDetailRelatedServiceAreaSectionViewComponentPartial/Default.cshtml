@model List<ServiceCardViewModel>

<div class="related-product-area section-pt pt--60">
    <div class="row">
        <div class="col-lg-12">
            @if (Model != null && Model.Any())
            {
                <h5 class="title-2">Related Services</h5>
            }
        </div>
    </div>
    <div class="courses-tab-wrapper">
        <!-- courses-wrapper start -->
        <div class="courses-wrapper-tab-panel">
            <!-- tab-contnt start -->
            <div class="tab-content">

                <div class="tab-pane active" id="graphic">
                    <div class="row ">
                        <div class="courses-tab-active owl-carousel">
                            @foreach (var item in Model!)
                            {
                                <div class="col-lg-12">
                                    <!-- single-courses -->
                                    <div class="single-popular-courses mt--30">
                                        <div class="popular-courses-image">
                                            <a href="@Url.Action("Detail", "Service", new { slug = item.Slug })">
                                                <img src="@item.CoverImageUrl"
                                                     style="width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; display: block; border-radius: 5px 5px 0px 0px;"
                                                     alt="Service Images">
                                            </a>
                                        </div>
                                        <div class="popular-courses-contnet">
                                            <h5 style="height:43.19px;"><a href="@Url.Action("Detail","Service", new { slug = item.Slug } )">@item.Title</a></h5>
                                            <div class="post_meta">
                                                <ul style="height:56px;">
                                                    <li><a href="@Url.Action("Detail","Service", new { slug = item.Slug } )">@item.CategoryTitle</a></li>
                                                    @if (item.DiscountRate > 0)
                                                    {
                                                        <li>
                                                            <p style="text-decoration: line-through; color: gray;">@item.Price.ToUsd()</p>
                                                        </li>
                                                        <li>
                                                            <p style="color: #ff5951; font-weight: bold;">@item.DiscountedPrice.ToUsd()</p>
                                                        </li>
                                                        <li>
                                                            <p style="color: green; font-weight: bold;">@item.DiscountRate % Off</p>
                                                        </li>
                                                    }
                                                    else
                                                    {
                                                        <li>
                                                            <p style="color: black; font-weight: bold;">@item.Price.ToUsd()</p>
                                                        </li>
                                                    }

                                                </ul>
                                            </div>
                                            <p style="height:84px;">
                                                @(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                            </p>
                                        </div>
                                    </div><!--// single-courses -->
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div><!--// tab-contnt start -->
        </div>
        <!--// courses-wrapper start -->
    </div>
</div>
