@model CreateMessageViewModel

<div id="contact" class="tab-pane">
    <div class="row">
        <div class="col-lg-12">
            <div class="comments-reply-area tow-revew">
                <h5 class="comment-reply-title mb--30">Ask your questions about the service</h5>
                <form asp-controller="Service" asp-action="Detail" method="post" class="comment-form-area">
                    <div class="contact-page-form">
                        <div class="contact-input">
                            <div class="contact-inner mt-1">
                                <input type="text" class="form-control" placeholder="First Name *" id="first-name" asp-for="FirstName">
                                <span asp-validation-for="FirstName" class="text-danger error"></span>
                            </div>
                            <div class="contact-inner mt-1">
                                <input type="text" class="form-control" placeholder="Last Name *" id="last-name" asp-for="LastName">
                                <span asp-validation-for="LastName" class="text-danger error"></span>
                            </div>
                            <div class="contact-inner">
                                <input type="email" class="form-control" placeholder="Email *" id="email" asp-for="Email">
                                <span asp-validation-for="Email" class="text-danger error"></span>
                            </div>
                            <div class="contact-inner">
                                <input type="text" class="form-control" placeholder="Subject *" id="subject" asp-for="Subject">
                                <span asp-validation-for="Subject" class="text-danger error"></span>
                            </div>
                            <div class="contact-inner contact-message">
                                <textarea class="form-control" placeholder="Message *" asp-for="Description"></textarea>
                                <span asp-validation-for="Description" class="text-danger error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="comment-form-submit mt-0">
                      @*   //class="comment-submit rounded-2" *@
                        <button class="btn btn btn-large rounded-2 px-4 py-2 fw-semibold" type="submit" style="text-transform: capitalize">Send Email</button>
                    </div>
                </form>
            </div>
        </div>
        <!--// blog-details-wrapper -->
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Check if there are validation errors
        var hasErrors = document.querySelector(".error:not(:empty)") !== null;

        if (hasErrors) {
            // Activate the second tab "Contact For The Service"
            var tabLink = document.querySelector('[href="#contact"]');
            if (tabLink) {
                tabLink.click();
            }

            // Wait a bit to ensure tab switching, then scroll to the reviews section
            setTimeout(function () {
                var formSection = document.getElementById("contact");
                if (formSection) {
                    formSection.scrollIntoView({ behavior: "smooth", block: "center" });
                }
            }, 300); // 300ms delay to allow tab change
        }
    });
</script>