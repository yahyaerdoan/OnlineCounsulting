@model ResultServiceWithImageDto

<div class="product-description-area section-pt pt--60">
    <div class="row">
        <div class="col-lg-12">
            <!-- blog-item-filter-list start -->
            <ul class="nav description-list d-flex gap-2" role="tablist">
                <li class="nav-item">
                    <a class="active rounded-2"
                       data-bs-toggle="tab"
                       href="#description"
                       style="text-transform: capitalize;">
                        Detailed Descriptions
                    </a>
                </li>
                <li class="nav-item">
                    <a class="rounded-2"
                       data-bs-toggle="tab"
                       href="#contact"
                       style="text-transform: capitalize;">
                        Contact For The Service
                    </a>
                </li>
            </ul>
            <!-- blog-item-filter-list end -->
            <div class="blog-wrapper">
                <div class="tab-content">
                    <div id="description" class="tab-pane active">

                        <p>@Html.Raw(Model.DetailedDescription)</p>

