@using OnlineConsulting.UserInterface.Features.Cart
@model CartViewModel?

<!-- mini-cart-wrap -->
<div class="mini-cart-wrap">
    <button type="button">
        <i class="zmdi zmdi-shopping-basket"></i> <span>@(Model?.Items.Count ?? 0)</span>
    </button>

    <!-- mini-cart-wrap -->
    <div class="mini-cart-wrap">
    @if (Model is null || Model.Items.Count == 0)
    {
        <div class="p-3 text-center text-muted">Your cart is empty.</div>
    }
    else
    {
        <ul>
            @foreach (var item in Model.Items)
            {
                <li class="single-item">
                    <div class="product-info">
                        <h5>@item.ServiceTitle</h5>
                        <div class="price-box">
                            <span class="new-price">@item.TotalPrice.ToUsd()</span>
                        </div>
                        <div class="size">
                            Qty: @item.Quantity
                        </div>
                    </div>
                    <div class="remove-from-cart">
                        <form asp-action="RemoveBasketItem" asp-controller="Cart" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="remove-btn" title="Remove">
                                <i class="zmdi zmdi-delete"></i>
                            </button>
                        </form>
                    </div>
                </li>
            }
            <li>
                <div class="shopping-cart-total">
                    <h5>Subtotal: <span>@Model.SubTotal.ToUsd()</span></h5>
                    <h5>Total: <span>@Model.Total.ToUsd()</span></h5>
                </div>
            </li>
            <li>
                <div class="row">
                    <div class="col-6">
                        <div class="shopping-cart-btn">
                            <a href="@Url.Action("Index", "Checkout", new { area = "", cartId = Model.CartId })">Checkout</a>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="shopping-cart-btn">
                            <a href="@Url.Action("Index", "Cart", new { area = "" })">View Cart</a>
                        </div>
                    </div>
                </div>
            </li>
        </ul>
    }
    </div>
    <!--// mini-cart-wrap -->
</div>
<!--// mini-cart-wrap -->
