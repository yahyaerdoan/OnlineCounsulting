@using OnlineConsulting.UserInterface.Areas.Admin.Features.FooterAbout
@model List<FooterAboutListItemViewModel>

<div class="col-lg-4 col-md-6 mt--60">
    <div class="footer-single-block">
        <div class="footer-logo">
            <a href="@Url.Action("Index", "Home")"
               class="d-flex align-items-center text-decoration-none"
               style="white-space: nowrap;">
                <i class="fas fa-star"
                   style="color: #FF5951; font-size: 20px; margin-right: 8px; flex-shrink: 0;"></i>
                <partial name="_BrandLogo" model='new BrandLogoOptions { SecondWordColor = "#FFFFFF" }' />
            </a>
        </div>
        @foreach (var item in Model)
        {
            <p class="footer-dec">
                @item.Description
            </p>
        }
        <ul class="footer-hours-list">
            <li><i class="fas fa-map-marker-alt"></i> Proudly serving the greater metro area</li>
            <li><i class="fas fa-clock"></i> Mon&ndash;Sat: 7am&ndash;8pm &bull; 24/7 Emergency Line</li>
        </ul>
        @await Component.InvokeAsync("LayoutFooterTopAreaBlock1SocialMediaViewComponentPartial")       
    </div>
</div>