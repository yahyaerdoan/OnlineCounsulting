@using OnlineConsulting.UserInterface.Areas.Admin.Features.Testimonial
@model List<TestimonialListItemViewModel>
<div class="testimonials-area grey-bg-image section-ptb">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 m-auto">
                <!-- section-title -->
                <div class="section-title-two">
                    <h4 style="text-transform:capitalize">Testimonials</h4>
                    <h3 style="text-transform:capitalize">What Our Customers Say</h3>
                    <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                        <span style="color:#FFB800;">
                            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                        </span>
                        <span class="fw-semibold">4.9 out of 5</span>
                        <span class="text-muted">&mdash; based on 500+ verified reviews</span>
                    </div>
                </div><!--// section-title -->
            </div>
        </div>

        <div class="row">
            <div class="testimonial-active owl-carousel" >
                @foreach (var item in Model)
                {
                    <div class="col-lg-8 m-auto">
                        <!-- testimonial-wrap -->
                        <div class="testimonial-wrap text-center">
                            <div class="testimonial-image">
                                <img src="@item.ImageUrl" style="max-width: 122px; height: 122px; object-fit: cover; border-radius: 5px" alt="">
                            </div>
                            <div class="testimonial-info">
                                <div class="mb-2" style="color:#FFB800;">
                                    <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                                </div>
                                <div class="autor-info">
                                    <h4>@item.FirstName @item.LastName</h4>
                                    <h6>@item.Title</h6>
                                </div>
                                <p>
                                    @item.Description
                                </p>
                            </div>

                        </div>
                        <!--// testimonial-wrap -->
                    </div>
                }
            </div>
        </div>
    </div>
</div>