@using AdminContact = OnlineConsulting.UserInterface.Areas.Admin.Features.Contact
@model List<AdminContact.ContactViewModel>

<!-- top-contact-info -->
<div class="top-contact-info">
    @foreach (var item in Model)
    {
        <ul>
            <li>
                <a href="tel:@item.Phone" class="header-phone-cta">
                    <i class="zmdi zmdi-phone"></i>
                    <span class="header-phone-cta-text">
                        <small>24/7 Emergency Service</small>
                        <strong>@item.Phone</strong>
                    </span>
                </a>
            </li>
            <li><a href="mailto: @item.Email"><i class="zmdi zmdi-email"></i> @item.Email</a></li>
        </ul>
    }
</div>
<!--// top-contact-info -->