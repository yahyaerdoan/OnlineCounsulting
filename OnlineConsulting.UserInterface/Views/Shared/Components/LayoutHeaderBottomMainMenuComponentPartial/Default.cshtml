@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!-- main-menu -->
<div class="main-menu">
    <nav class="main-navigation">
        <ul class="nav-list">

            <li class="nav-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                <a class="fs-6" href="@Url.Action("Index", "Home",new {area=""})">Home</a>
            </li>

            <li class="nav-item @(currentController == "AboutUs" && currentAction == "Index" ? "active" : "")">
                <a class="fs-6" href="@Url.Action("Index", "AboutUs",new {area=""})">About</a>
            </li>

            <li class="nav-item @(currentController == "Gallery" && currentAction == "Index" ? "active" : "")">
                <a class="fs-6" href="@Url.Action("Index", "Gallery",new {area=""})">Gallery</a>
            </li>

            <li class="nav-item @(currentController == "Service" && currentAction == "Index" ? "active" : "")">
                <a class="fs-6" href="@Url.Action("Index", "Service",new {area=""})">Services</a>
            </li>

            <li class="nav-item @(currentController == "Contact" && currentAction == "Index" ? "active" : "")">
                <a class="fs-6" href="@Url.Action("Index", "Contact",new {area=""})">Contact</a>
            </li>

            <li class="nav-item @(currentController == "Appointment" && currentAction == "Book" ? "active" : "")">
                <a class="fs-6" href="@Url.Action("Book", "Appointment",new {area=""})">Appointment</a>
            </li>

            <li class="nav-item @(currentController == "Membership" && currentAction == "Index" ? "active" : "")">
                <a class="fs-6" href="@Url.Action("Index", "Membership",new {area=""})">Membership</a>
            </li>

        </ul>
    </nav>
</div>
<!--// main-menu -->
