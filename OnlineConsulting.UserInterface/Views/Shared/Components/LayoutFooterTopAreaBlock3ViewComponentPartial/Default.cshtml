@using OnlineConsulting.UserInterface.Features.Service
@model List<ServiceCardViewModel>
<div class="col-lg-3 col-md-6 mt--60">
    <div class="footer-block">
        <h5 style="text-transform:capitalize">Popular Services</h5>
        <ul class="footer-courses">
            @foreach (var item in Model)
            {
                <li>
                    <div class="courses-image">
                        <a href="@Url.Action("Detail", "Service", new{area="", slug = item.Slug })"><img src="@item.CoverImageUrl" style="border-radius:5px;  width: 100%; height: 66px; aspect-ratio: 1 / 1; object-fit: cover; display: block;" alt=""></a>
                    </div>
                    <div class="courses-nifo">
                        <h5>
                            <a href="@Url.Action("Detail", "Service", new{area="", slug = item.Slug })">@item.Title</a>
                        </h5>
                        <p>Price: @item.Price.ToUsd()</p>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>
