@* Booking flow in three steps (service, time, details); browsing is public and the sign-in prompt replaces the
   confirm button for anonymous visitors - same browse-then-sign-in pattern as Cart/Checkout. ?service={id} preselects
   a service and starts at the time step. The time step is a month calendar; picking a day loads its open times,
   grouped by part of day, beside the calendar on wide screens and below it (scrolled into view) on phones. *@
@page "/appointment"
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@layout OnlineConsulting.Maui.Shared.Layout.MarketingLayout
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject FormState<AppointmentModel> Form

<PageTitle>Book an Appointment</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="marketing-section">
    <MudText Typo="Typo.h4" Class="mb-2">Book an Appointment</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
        Three quick steps. Prefer to talk first? Use the <MudLink Href="/contact">Contact page</MudLink>.
    </MudText>

    @if (_confirmedSlot is not null)
    {
        <div class="booking-confirmed">
            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Color="Color.Success" Style="font-size: 3rem;" />
            <MudText Typo="Typo.h5" Class="mt-2">You're booked</MudText>
            <MudText Color="Color.Secondary" Class="mb-4">
                @SelectedServiceTitle on @DateTimeFormat.FormatDateTime(_confirmedSlot.Start). We've sent a confirmation email.
            </MudText>
            <MudButton Href="/user/appointments" Variant="Variant.Filled" Color="Color.Primary">View my appointments</MudButton>
        </div>
    }
    else
    {
        <StepIndicator Steps="StepNames" @bind-Current="_step" />

        @if (_step == 0)
        {
            <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
                <MudText Typo="Typo.subtitle1">What do you need?</MudText>
                <MudLink Href="/service-finder" Typo="Typo.body2">Not sure? Answer 3 quick questions</MudLink>
            </div>
            <div class="booking-choice-grid" role="radiogroup" aria-label="Service">
                <button type="button" class="booking-choice @(_serviceId is null ? "selected" : null)" role="radio" aria-checked="@(_serviceId is null)"
                        @onclick="@(() => _serviceId = null)">
                    <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" />
                    <span class="booking-choice-title">Not sure yet</span>
                    <span class="booking-choice-text">A technician will assess it on site.</span>
                </button>
                @foreach (var service in _services)
                {
                    var id = service.Id;
                    <button type="button" class="booking-choice @(_serviceId == id ? "selected" : null)" role="radio" aria-checked="@(_serviceId == id)"
                            @onclick="@(() => _serviceId = id)">
                        <MudIcon Icon="@Icons.Material.Outlined.HomeRepairService" />
                        <span class="booking-choice-title">@service.Title</span>
                        <span class="booking-choice-text">@service.Description</span>
                    </button>
                }
            </div>
            <div class="booking-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _step = 1)">Continue</MudButton>
            </div>
        }
        else if (_step == 1)
        {
            <div class="booking-schedule">
                <div class="booking-calendar-panel">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Pick a day</MudText>
                    <MudDatePicker PickerVariant="PickerVariant.Static" Date="_date" DateChanged="OnDateChangedAsync"
                                   MinDate="@FirstBookableDay" MaxDate="@LastBookableDay" ShowToolbar="false" Elevation="0"
                                   Class="booking-calendar" />
                </div>

                <div id="booking-times" class="booking-times-panel">
                    <ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

                    @if (_date is not { } date)
                    {
                        <div class="booking-times-hint">
                            <span class="tone-bubble @AccentTone.Blue"><MudIcon Icon="@Icons.Material.Outlined.EventAvailable" /></span>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Choose a day on the calendar to see the open times.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-3">@date.ToString("dddd, MMMM d")</MudText>

                        @if (_loadingSlots)
                        {
                            <div class="booking-slot-grid" aria-busy="true">
                                @for (var i = 0; i < 6; i++)
                                {
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="44px" Class="rounded" />
                                }
                            </div>
                        }
                        else if (_slots.Count == 0)
                        {
                            <div class="booking-empty">
                                <MudText Color="Color.Secondary">No open times on this date.</MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                                           OnClick="@(() => OnDateChangedAsync(date.AddDays(1)))">Try the next day</MudButton>
                            </div>
                        }
                        else
                        {
                            @foreach (var (period, slots) in SlotsByPeriod)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="booking-slot-period">@period</MudText>
                                <div class="booking-slot-grid" role="listbox" aria-label="@($"{period} times")">
                                    @foreach (var slot in slots)
                                    {
                                        var isSelected = _selectedSlot == slot;
                                        <button type="button" role="option" aria-selected="@isSelected" class="booking-slot @(isSelected ? "selected" : null)"
                                                @onclick="@(() => _selectedSlot = slot)">
                                            @slot.Start.ToString("h:mm tt")
                                        </button>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <div class="booking-actions">
                <MudButton Variant="Variant.Text" OnClick="@(() => _step = 0)">Back</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selectedSlot is null)" OnClick="@(() => _step = 2)">Continue</MudButton>
            </div>
        }
        else if (_selectedSlot is { } selected)
        {
            <MudPaper Outlined="true" Class="pa-4 mb-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Your visit</MudText>
                <MudText Typo="Typo.subtitle1">@SelectedServiceTitle</MudText>
                <MudText Color="Color.Secondary">@selected.Start.ToString("dddd, MMM d") at @selected.Start.ToString("h:mm tt")</MudText>
            </MudPaper>

            <EditForm EditContext="@Form.EditContext">
                <MudTextField @bind-Value="_model.ServiceAddress" For="@(() => _model.ServiceAddress)" Label="Service address (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="1" Sizing="InputSizing.Auto" autocomplete="street-address" />
                <MudTextField @bind-Value="_model.CustomerNote" For="@(() => _model.CustomerNote)" Label="Anything we should know? (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="2" Sizing="InputSizing.Auto" Class="mt-2" />

                <AuthorizeView Context="authContext">
                    <Authorized>
                        <div class="booking-actions">
                            <MudButton Variant="Variant.Text" OnClick="@(() => _step = 1)">Back</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_submitting" OnClick="@(() => SubmitAsync(selected))">
                                @(_submitting ? "Booking..." : "Confirm booking")
                            </MudButton>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <MudAlert Severity="Severity.Info" Class="mt-4">
                            Sign in to confirm this booking.
                            <div class="mt-2">
                                <MudButton Href="/login?ReturnUrl=/appointment" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Sign In</MudButton>
                                <MudButton Href="/register" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="ml-2">Register</MudButton>
                            </div>
                        </MudAlert>
                    </NotAuthorized>
                </AuthorizeView>
            </EditForm>
        }
    }
</MudContainer>

@code {
    private static readonly string[] StepNames = ["Service", "Date & time", "Details"];

    private int _step;
    private DateTime? _date;
    private Guid? _serviceId;
    private List<ServiceResponse> _services = [];
    private List<AvailableSlotResponse> _slots = [];
    private AvailableSlotResponse? _selectedSlot;
    private AvailableSlotResponse? _confirmedSlot;
    private readonly AppointmentModel _model = new();
    private bool _loadingSlots;
    private bool _scrollToTimes;
    private bool _submitting;
    private string? _loadError;

    private static DateTime FirstBookableDay => DateTime.Today.AddDays(1);

    private static DateTime LastBookableDay => DateTime.Today.AddDays(90);

    private IEnumerable<(string Period, List<AvailableSlotResponse> Slots)> SlotsByPeriod =>
        _slots.GroupBy(slot => slot.Start.Hour switch { < 12 => "Morning", < 17 => "Afternoon", _ => "Evening" })
              .Select(group => (group.Key, group.OrderBy(slot => slot.Start).ToList()));

    [SupplyParameterFromQuery(Name = "service")]
    public Guid? PreselectedServiceId { get; set; }

    private string SelectedServiceTitle => _services.FirstOrDefault(s => s.Id == _serviceId)?.Title ?? "Service visit";

    protected override async Task OnInitializedAsync()
    {
        Form.Bind(_model);

        var result = await ApiClient.GetAsync<PaginatedResponse<ServiceResponse>>($"{ApiRoutes.Services.Base}?size=100");
        _services = result.IsSuccessful && result.ResultData is not null ? result.ResultData.Items : [];

        if (PreselectedServiceId is { } preselected && _services.Any(s => s.Id == preselected))
        {
            _serviceId = preselected;
            _step = 1;
        }
    }

    private async Task OnDateChangedAsync(DateTime? newDate)
    {
        _date = newDate;
        _selectedSlot = null;

        if (_date is null)
        {
            _slots = [];
            return;
        }

        _loadingSlots = true;
        _loadError = null;
        StateHasChanged();

        var date = DateOnly.FromDateTime(_date.Value);
        var result = await ApiClient.GetAsync<List<AvailableSlotResponse>>($"{ApiRoutes.Scheduling.Availability.Base}?date={date:yyyy-MM-dd}");
        if (!result.IsSuccessful || result.ResultData is null)
        {
            _loadError = result.DisplayMessage;
            _slots = [];
        }
        else
        {
            _slots = result.ResultData;
        }

        _loadingSlots = false;
        _scrollToTimes = true;
    }

    /// <summary>Scrolls only after the times have rendered - scrolling from the load handler ran before the new list existed.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToTimes)
        {
            _scrollToTimes = false;
            await JsRuntime.InvokeVoidAsync("comfortProScrollIntoView", "booking-times");
        }
    }

    private async Task SubmitAsync(AvailableSlotResponse slot)
    {
        _submitting = true;

        var body = new
        {
            serviceId = _serviceId,
            scheduledStart = slot.Start,
            scheduledEnd = slot.End,
            customerNote = _model.CustomerNote,
            serviceAddress = _model.ServiceAddress,
        };

        var result = await ApiClient.PostAsync<Guid>(ApiRoutes.Operations.Appointments.Base, body);
        _submitting = false;

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            if (result.StatusCode == 409)
            {
                _step = 1;
                await OnDateChangedAsync(_date);
            }

            return;
        }

        _confirmedSlot = slot;
    }

    private sealed class AppointmentModel
    {
        public string? CustomerNote { get; set; }
        public string? ServiceAddress { get; set; }
    }
}
