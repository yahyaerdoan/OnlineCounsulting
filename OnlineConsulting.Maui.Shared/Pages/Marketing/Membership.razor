@* Membership sales page: value proposition, benefits, plans (billing toggle when both cycles exist, the signed-in member's
   own plan marked), member vs pay-as-you-go comparison, how it works, testimonials, FAQs and a closing call to action.
   Every number shown comes from the plans themselves. *@
@page "/membership"
@layout OnlineConsulting.Maui.Shared.Layout.MarketingLayout
@using OnlineConsulting.Maui.Shared.Components.Marketing
@inject IApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Membership</PageTitle>

<section class="membership-intro">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Align="Align.Center" Class="text-strong">ComfortPro Membership</MudText>
        <MudText Typo="Typo.h3" Align="Align.Center" Class="marketing-display text-strong mt-1">Worry-free comfort, all year round</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="mt-3 membership-intro-lead">
            Your heating and cooling looked after by the same team, every season: included tune-ups, priority booking
            @(MaxDiscount > 0 ? $"and {MaxDiscount:0.##}% off every repair" : "and member-only pricing"). Fewer surprises, lower bills.
        </MudText>
        <div class="membership-intro-actions">
            <MudButton Href="#plans" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">See plans</MudButton>
            <MudButton Href="#benefits" Variant="Variant.Text" Color="Color.Primary" Size="Size.Large">Why join?</MudButton>
        </div>
        <div class="membership-trust">
            @foreach (var (icon, label) in TrustPoints)
            {
                <span class="membership-trust-item"><MudIcon Icon="@icon" Size="Size.Small" />@label</span>
            }
        </div>
    </MudContainer>
</section>

<MudContainer id="benefits" MaxWidth="MaxWidth.Large" Class="marketing-section-tight">
    <MudText Typo="Typo.h5" Align="Align.Center" Class="marketing-display text-strong">What members get</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-1 mb-6">A small monthly amount that protects the most expensive system in your home.</MudText>
    <div class="membership-benefit-grid">
        @foreach (var (benefit, index) in Benefits.Select((b, i) => (b, i)))
        {
            <div class="membership-benefit">
                <span class="tone-bubble tone-bubble-lg @AccentTone.At(index)"><MudIcon Icon="@benefit.Icon" /></span>
                <MudText Typo="Typo.subtitle1" Class="text-strong">@benefit.Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@benefit.Text</MudText>
            </div>
        }
    </div>
</MudContainer>

<section class="marketing-dark-section">
<MudContainer id="plans" MaxWidth="MaxWidth.Large" Class="marketing-section-tight">
    <MudText Typo="Typo.h5" Align="Align.Center" Class="marketing-display text-strong mb-6">Choose your plan</MudText>
    <ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

    @if (_loading)
    {
        <MudGrid Justify="Justify.Center">
            @for (var i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" md="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="360px" Class="rounded-lg" /></MudItem>
            }
        </MudGrid>
    }
    else if (_plans.Count == 0 && _loadError is null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.WorkspacePremium" Title="No plans available right now"
                    Text="Check back soon, or contact us and we'll help you find the right service." ActionText="Contact us" ActionHref="/contact" />
    }
    else if (_plans.Count > 0)
    {
        @if (HasBothCycles)
        {
            <div class="membership-cycle-toggle" role="radiogroup" aria-label="Billing cycle">
                <button type="button" role="radio" aria-checked="@(!_showAnnual)" class="@(!_showAnnual ? "selected" : null)" @onclick="@(() => _showAnnual = false)">Monthly</button>
                <button type="button" role="radio" aria-checked="@_showAnnual" class="@(_showAnnual ? "selected" : null)" @onclick="@(() => _showAnnual = true)">Yearly</button>
            </div>
        }

        var visiblePlans = VisiblePlans;
        Guid? featuredPlanId = visiblePlans.Count >= 3 ? visiblePlans[visiblePlans.Count / 2].Id : null;

        <MudGrid Justify="Justify.Center">
            @foreach (var plan in visiblePlans)
            {
                var featured = plan.Id == featuredPlanId;
                var isCurrent = plan.Id == _currentPlanId;
                <MudItem xs="12" sm="6" md="4" Class="@(featured ? "membership-plan-featured" : null)">
                    <div class="position-relative" style="height:100%;">
                        @if (isCurrent)
                        {
                            <span class="marketing-pricing-badge membership-badge-current">Your plan</span>
                        }
                        else if (featured)
                        {
                            <span class="marketing-pricing-badge">Most popular</span>
                        }
                        <MudCard Outlined="true" Class="@($"d-flex flex-column marketing-pricing-card {(featured || isCurrent ? "marketing-pricing-card-featured" : "")}")" Style="height:100%;">
                            <MudCardContent Class="d-flex flex-column flex-grow-1 pa-6">
                                <MudText Typo="Typo.h6" Class="text-strong">@plan.Name</MudText>
                                <div class="membership-price">
                                    <span class="membership-price-amount">@CurrencyFormat.Format(plan.Price)</span>
                                    <span class="membership-price-cycle">/ @(IsAnnual(plan) ? "year" : "month")</span>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@PriceNote(plan)</MudText>
                                @if (plan.TrialDays is > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Outlined.Celebration"
                                             Class="ml-0 mt-3 align-self-start">@plan.TrialDays-day free trial</MudChip>
                                }
                                <ul class="membership-benefits">
                                    <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Primary" /><span><strong>@plan.IncludedVisitsPerYear</strong> included @(plan.IncludedVisitsPerYear == 1 ? "visit" : "visits") per year</span></li>
                                    @if (plan.DiscountPercent > 0)
                                    {
                                        <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Primary" /><span><strong>@plan.DiscountPercent.ToString("0.##")% off</strong> every additional service</span></li>
                                    }
                                    @if (plan.CreditAmount > 0)
                                    {
                                        <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Primary" /><span><strong>@CurrencyFormat.Format(plan.CreditAmount)</strong> account credit</span></li>
                                    }
                                    @foreach (var benefit in BenefitLines(plan.Benefits))
                                    {
                                        <li><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Primary" /><span>@benefit</span></li>
                                    }
                                </ul>
                            </MudCardContent>
                            <MudCardActions Class="pa-6 pt-0">
                                @if (isCurrent)
                                {
                                    <MudButton Href="/user/membership" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="Size.Large">Manage membership</MudButton>
                                }
                                else if (_currentPlanId is not null)
                                {
                                    <MudButton Href="/user/membership" Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Size="Size.Large">Switch to this plan</MudButton>
                                }
                                else
                                {
                                    <MudButton Href="@($"/user/membership/subscribe/{plan.Id}")" Variant="@(featured ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary" FullWidth="true" Size="Size.Large">
                                        @(plan.TrialDays is > 0 ? "Start free trial" : $"Choose {plan.Name}")
                                    </MudButton>
                                }
                            </MudCardActions>
                        </MudCard>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>
</section>

@if (_plans.Count > 0)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="marketing-section-tight">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="marketing-display text-strong mb-6">Member vs. pay as you go</MudText>
        <div class="membership-compare" role="table" aria-label="Member compared with pay as you go">
            <div class="membership-compare-row membership-compare-head" role="row">
                <span role="columnheader"></span>
                <span role="columnheader">Pay as you go</span>
                <span role="columnheader" class="membership-compare-member">Member</span>
            </div>
            @foreach (var row in ComparisonRows)
            {
                <div class="membership-compare-row" role="row">
                    <span role="rowheader" class="text-strong">@row.Feature</span>
                    <span role="cell" class="membership-compare-guest">@row.Guest</span>
                    <span role="cell" class="membership-compare-member">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />@row.Member
                    </span>
                </div>
            }
        </div>
    </MudContainer>
}

<section class="marketing-dark-section">
    <MudContainer MaxWidth="MaxWidth.Large" Class="marketing-section-tight">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="marketing-display text-strong mb-6">How membership works</MudText>
        <div class="membership-steps">
            @for (var i = 0; i < Steps.Length; i++)
            {
                var step = Steps[i];
                <div class="membership-step">
                    <span class="membership-step-number">@(i + 1)</span>
                    <MudIcon Icon="@step.Icon" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle1" Class="text-strong mt-2">@step.Title</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@step.Text</MudText>
                </div>
            }
        </div>
    </MudContainer>
</section>

<HomeTestimonialsSection />

<MudContainer MaxWidth="MaxWidth.Medium" Class="marketing-section-tight">
    <MudText Typo="Typo.h5" Align="Align.Center" Class="marketing-display text-strong mb-4">Membership questions</MudText>
    <MudStack Spacing="2">
        @foreach (var (question, answer) in Faqs)
        {
            <details class="marketing-promo-card">
                <summary><span class="marketing-promo-title text-strong">@question</span></summary>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@answer</MudText>
            </details>
        }
    </MudStack>

</MudContainer>

<section class="membership-cta">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center text-center">
        <MudText Typo="Typo.h4" Class="marketing-display text-strong">Ready for worry-free comfort?</MudText>
        <MudText Typo="Typo.body1" Class="mt-2 membership-cta-lead">
            Join today and your first included visit is ready to book. @(_plans.Any(p => p.TrialDays is > 0) ? "Try it free, cancel anytime." : "Cancel anytime.")
        </MudText>
        <div class="membership-intro-actions">
            <MudButton Href="#plans" Variant="Variant.Filled" Size="Size.Large" Class="membership-cta-primary">Become a member</MudButton>
            <MudButton Href="/contact" Variant="Variant.Outlined" Size="Size.Large" Class="membership-cta-secondary">Talk to us first</MudButton>
        </div>
    </MudContainer>
</section>

@code {
    private sealed record Step(string Icon, string Title, string Text);

    private sealed record Benefit(string Icon, string Title, string Text);

    private sealed record ComparisonRow(string Feature, string Guest, string Member);

    private static readonly (string Icon, string Label)[] TrustPoints =
    [
        (Icons.Material.Outlined.EventRepeat, "Cancel anytime"),
        (Icons.Material.Outlined.PauseCircle, "Pause or switch plans"),
        (Icons.Material.Outlined.Lock, "Secure card payment"),
    ];

    private static readonly Step[] Steps =
    [
        new(Icons.Material.Outlined.WorkspacePremium, "Pick a plan", "Choose the plan that fits your home and sign up in a couple of minutes."),
        new(Icons.Material.Outlined.EventAvailable, "Book your included visits", "Schedule maintenance whenever it suits you, with priority time slots."),
        new(Icons.Material.Outlined.Savings, "Save on every job", "Your member discount applies to any extra service you book."),
    ];

    private static readonly (string Question, string Answer)[] Faqs =
    [
        ("Can I cancel anytime?", "Yes. Cancel from your account whenever you like; your membership stays active until the end of the period you've already paid for."),
        ("Can I pause or change my plan?", "Yes. You can pause and resume your membership, or switch to another plan, from the Membership page in your account."),
        ("How do included visits work?", "Each plan includes a set number of visits per year. Book them like any other visit; anything beyond those gets your member discount."),
        ("Is there a free trial?", "Plans marked with a free trial don't charge your card until the trial ends, and you can cancel before then at no cost."),
        ("Is my payment information safe?", "Card details are handled by our payment provider, Stripe. We never see or store your full card number."),
    ];

    private List<MembershipPlanResponse> _plans = [];
    private Guid? _currentPlanId;
    private bool _showAnnual;
    private bool _loading = true;
    private string? _loadError;

    private const int PageSize = 24;

    private bool HasBothCycles => _plans.Any(IsAnnual) && _plans.Any(p => !IsAnnual(p));

    private List<MembershipPlanResponse> VisiblePlans =>
        HasBothCycles ? [.. _plans.Where(p => IsAnnual(p) == _showAnnual)] : _plans;

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiClient.GetAsync<PaginatedResponse<MembershipPlanResponse>>(
            ApiRoutes.Paged(ApiRoutes.Growth.MembershipPlans.Base, 0, PageSize));
        if (!result.IsSuccessful)
        {
            _loadError = result.DisplayMessage;
            _loading = false;
            return;
        }

        _plans = [.. (result.ResultData?.Items ?? []).Where(p => p.IsActive).OrderBy(p => p.Price)];
        await LoadCurrentPlanAsync();
        _loading = false;
    }

    /// <summary>Marks the signed-in customer's plan and opens the toggle on its billing cycle; a 404 just means not a member.</summary>
    private async Task LoadCurrentPlanAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated is not true)
        {
            return;
        }

        var result = await ApiClient.GetAsync<CustomerMembershipResponse>(ApiRoutes.Growth.CustomerMemberships.Mine);
        if (result is { IsSuccessful: true, ResultData: { Status: not ("Cancelled" or "Failed") } membership })
        {
            _currentPlanId = membership.MembershipPlanId;
            _showAnnual = _plans.FirstOrDefault(p => p.Id == membership.MembershipPlanId) is { } plan && IsAnnual(plan);
        }
    }

    private static bool IsAnnual(MembershipPlanResponse plan) => plan.BillingCycle == "Annual";

    private decimal MaxDiscount => _plans.Count > 0 ? _plans.Max(p => p.DiscountPercent) : 0;

    private int MaxIncludedVisits => _plans.Count > 0 ? _plans.Max(p => p.IncludedVisitsPerYear) : 0;

    private decimal MaxCredit => _plans.Count > 0 ? _plans.Max(p => p.CreditAmount) : 0;

    private IEnumerable<Benefit> Benefits
    {
        get
        {
            yield return new(Icons.Material.Outlined.Bolt, "Priority scheduling",
                "Members get first pick of time slots, even at the peak of summer and winter when everyone needs help at once.");
            yield return new(Icons.Material.Outlined.Build, "Included tune-ups",
                MaxIncludedVisits > 0
                    ? $"Up to {MaxIncludedVisits} maintenance {(MaxIncludedVisits == 1 ? "visit" : "visits")} a year come with your plan, so you never skip one."
                    : "Seasonal maintenance visits come with your plan, so you never skip one.");
            if (MaxDiscount > 0)
            {
                yield return new(Icons.Material.Outlined.Sell, $"{MaxDiscount:0.##}% off repairs",
                    "Your member discount applies to repairs and every additional service you book.");
            }
            if (MaxCredit > 0)
            {
                yield return new(Icons.Material.Outlined.AccountBalanceWallet, "Account credit",
                    $"Plans include up to {CurrencyFormat.Format(MaxCredit)} in credit toward your services.");
            }
            yield return new(Icons.Material.Outlined.EnergySavingsLeaf, "Lower energy bills",
                "A clean, tuned system works less to heat and cool your home, and that shows up on your utility bill.");
            yield return new(Icons.Material.Outlined.Shield, "Fewer breakdowns",
                "Regular check-ups catch small problems early, before they turn into costly emergency repairs.");
            yield return new(Icons.Material.Outlined.History, "Longer equipment life",
                "Well-maintained furnaces and AC units last longer, putting off the cost of a replacement.");
            yield return new(Icons.Material.Outlined.Tune, "Total flexibility",
                "Pause, switch plans or cancel from your account. No long-term contract.");
        }
    }

    private IEnumerable<ComparisonRow> ComparisonRows
    {
        get
        {
            yield return new("Maintenance visits", "Paid per visit",
                MaxIncludedVisits > 0 ? $"Up to {MaxIncludedVisits} included a year" : "Included");
            if (MaxDiscount > 0)
            {
                yield return new("Repairs and extra services", "Standard pricing", $"Up to {MaxDiscount:0.##}% off");
            }
            yield return new("Scheduling", "Next available slot", "Priority time slots");
            if (MaxCredit > 0)
            {
                yield return new("Account credit", "None", $"Up to {CurrencyFormat.Format(MaxCredit)}");
            }
            yield return new("Commitment", "None", "Cancel anytime");
        }
    }

    private static string PriceNote(MembershipPlanResponse plan) =>
        IsAnnual(plan) ? $"About {CurrencyFormat.Format(Math.Round(plan.Price / 12, 2))} a month, billed yearly" : "Billed monthly";

    private static IEnumerable<string> BenefitLines(string? benefits) =>
        benefits?.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [];
}
