@* More than 2 bound inputs, so this is a full page rather than a MudDialog (per project standard).
   Renamed from AccountAddressFormPage.razor - lives under /user/addresses/* now, not /user/account/*. *@
@page "/user/addresses/new"
@page "/user/addresses/{Id:guid}"
@attribute [Authorize(Roles = AppRoles.User)]
@layout OnlineConsulting.Maui.Shared.Layout.DashboardLayout
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.User.AccountModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<AddressFormModel> Form

<PageTitle>@(IsEdit ? "Edit Address" : "New Address")</PageTitle>

<DashboardPageHeading Text="@(IsEdit ? "Edit Address" : "New Address")" />
<ApiErrorAlert Message="@_error" Severity="Severity.Error" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (IsEdit && !_addressFound)
    {
        @* No form when the address wasn't found - nothing to bind, and it would otherwise
           render as a blank, save-able form that PUTs to a nonexistent/foreign address id. *@
    }
    else
    {
        <EditForm EditContext="@Form.EditContext">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.AddressName" For="@(() => _model.AddressName)" Label="Address name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.CompanyName" For="@(() => _model.CompanyName)" Label="Company name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.AddressLine" For="@(() => _model.AddressLine)" Label="Address line" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.City" For="@(() => _model.City)" Label="City" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.State" For="@(() => _model.State)" Label="State" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.Zipcode" For="@(() => _model.Zipcode)" Label="Zip code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Country" For="@(() => _model.Country)" Label="Country" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes" For="@(() => _model.Notes)" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudCheckBox @bind-Value="_model.IsShippingAddress" Label="Use as shipping address" Color="Color.Primary" Dense="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudCheckBox @bind-Value="_model.IsBillingAddress" Label="Use as billing address" Color="Color.Primary" Dense="true" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/user/addresses"))">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">@(IsEdit ? "Save" : "Create")</MudButton>
            </MudStack>
        </EditForm>
    }

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsEdit => Id.HasValue;

    private readonly AddressFormModel _model = new();
    private bool _loading;
    private string? _error;
    private bool _addressFound = true;

    protected override async Task OnInitializedAsync()
    {
        Form.Bind(_model);

        if (!IsEdit)
        {
            return;
        }

        _loading = true;
        var result = await ApiClient.GetAsync<List<UserAddressResponse>>(ApiRoutes.Addresses.Base);

        if (!result.IsSuccessful)
        {
            _error = result.DisplayMessage;
            _addressFound = false;
        }
        else
        {
            var existing = result.ResultData?.FirstOrDefault(a => a.Id == Id);
            if (existing is null)
            {
                _error = "Address not found.";
                _addressFound = false;
            }
            else
            {
                _model.AddressName = existing.AddressName;
                _model.CompanyName = existing.CompanyName;
                _model.Country = existing.Country;
                _model.AddressLine = existing.AddressLine;
                _model.City = existing.City;
                _model.State = existing.State;
                _model.Zipcode = existing.Zipcode;
                _model.Notes = existing.Notes;
                _model.IsShippingAddress = existing.IsShippingAddress;
                _model.IsBillingAddress = existing.IsBillingAddress;
            }
        }

        _loading = false;
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var body = new
        {
            addressName = _model.AddressName,
            companyName = _model.CompanyName,
            country = _model.Country,
            addressLine = _model.AddressLine,
            city = _model.City,
            state = _model.State,
            zipcode = _model.Zipcode,
            notes = _model.Notes,
            isShippingAddress = _model.IsShippingAddress,
            isBillingAddress = _model.IsBillingAddress,
        };

        if (IsEdit)
        {
            var updateResult = await ApiClient.PutAsync(ApiRoutes.Addresses.ById(Id!.Value), body);
            if (!updateResult.IsSuccessful)
            {
                Form.DisplayErrors(updateResult, Snackbar);
                return;
            }

            Snackbar.ShowSuccess(updateResult.DisplayMessage);
        }
        else
        {
            var createResult = await ApiClient.PostAsync<Guid>(ApiRoutes.Addresses.Base, body);
            if (!createResult.IsSuccessful)
            {
                Form.DisplayErrors(createResult, Snackbar);
                return;
            }

            Snackbar.ShowSuccess(createResult.DisplayMessage);
        }

        Navigation.NavigateTo("/user/addresses");
    });
}
