@* Full notification inbox (the phone bell's destination, "See all" on wide screens): newest first, load more, mark all
   read; reloads live when a new notification arrives. *@
@page "/notifications"
@attribute [Authorize]
@layout OnlineConsulting.Maui.Shared.Layout.MarketingLayout
@implements IDisposable
@inject IApiClient ApiClient
@inject NotificationState NotificationState
@inject DataChangeNotifier Notifier
@inject NavigationManager Navigation

<PageTitle>Notifications</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="notifications-page">
    <div class="notifications-page-header">
        <MudText Typo="Typo.h5" Class="text-strong">Notifications</MudText>
        @if (NotificationState.UnreadCount > 0)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="MarkAllReadAsync">Mark all read</MudButton>
        }
    </div>

    <ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

    @if (_loading)
    {
        <ListSkeleton Rows="5" />
    }
    else if (_items.Count == 0)
    {
        <div class="cart-empty">
            <span class="tone-bubble tone-bubble-lg tone-blue"><MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" /></span>
            <MudText Typo="Typo.h6" Class="text-strong">You're All Caught Up</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Updates about your visits, orders and membership will show up here.</MudText>
        </div>
    }
    else
    {
        <div class="notifications-list">
            @foreach (var notification in _items)
            {
                <NotificationItem Notification="@notification" OnOpen="OpenAsync" />
            }
        </div>

        @if (_hasMore)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="mt-3" Disabled="@_loadingMore" OnClick="LoadMoreAsync">
                @(_loadingMore ? "Loading..." : "Load more")
            </MudButton>
        }
    }
</MudContainer>

@code {
    private const int PageSize = 20;

    private List<UserNotificationResponse> _items = [];
    private int _pageIndex;
    private bool _hasMore;
    private bool _loading = true;
    private bool _loadingMore;
    private string? _loadError;
    private IDisposable? _liveUpdates;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        NotificationState.Changed += OnStateChanged;
        _liveUpdates = Notifier.Subscribe(() => InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); }), DataTopic.Notifications);
        await ReloadAsync();
        _loading = false;
    }

    /// <summary>Reloads everything the user has already paged through, so a live refresh doesn't collapse the list.</summary>
    private async Task ReloadAsync()
    {
        var size = PageSize * (_pageIndex + 1);
        var result = await ApiClient.GetAsync<PaginatedResponse<UserNotificationResponse>>(ApiRoutes.Paged(ApiRoutes.Notifications.Base, 0, size));
        if (!result.IsSuccessful || result.ResultData is null)
        {
            _loadError = result.DisplayMessage;
            return;
        }

        _loadError = null;
        _items = result.ResultData.Items;
        _hasMore = _items.Count < result.ResultData.Count;
    }

    private async Task LoadMoreAsync()
    {
        _loadingMore = true;
        _pageIndex++;
        await ReloadAsync();
        _loadingMore = false;
    }

    private async Task OpenAsync(UserNotificationResponse notification)
    {
        if (!notification.IsRead)
        {
            _ = await ApiClient.PostAsync(ApiRoutes.Notifications.Read(notification.Id), null);
            NotificationState.SetCount(NotificationState.UnreadCount - 1);
            _items = [.. _items.Select(n => n.Id == notification.Id ? n with { IsRead = true } : n)];
        }

        if (AuthState is not null && NotificationState.LinkFor(notification, (await AuthState).User) is { } link)
        {
            Navigation.NavigateTo(link);
        }
    }

    private async Task MarkAllReadAsync()
    {
        var result = await ApiClient.PostAsync(ApiRoutes.Notifications.ReadAll, null);
        if (result.IsSuccessful)
        {
            NotificationState.SetCount(0);
            _items = [.. _items.Select(n => n with { IsRead = true })];
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        NotificationState.Changed -= OnStateChanged;
        _liveUpdates?.Dispose();
    }
}
