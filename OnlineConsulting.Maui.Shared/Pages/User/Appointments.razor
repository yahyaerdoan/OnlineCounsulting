@* Own appointments as cards with a progress track - service names resolved once per distinct service via
   GetAsync(Services.ById(...)) in parallel. CanCancel mirrors the legacy MVC rule exactly: Status is Pending or Confirmed. *@
@page "/user/appointments"
@attribute [Authorize(Roles = AppRoles.User)]
@layout OnlineConsulting.Maui.Shared.Layout.DashboardLayout
@inject IApiClient ApiClient
@inject ISnackbar Snackbar

<PageTitle>My Appointments</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h6">My Appointments</MudText>
        <MudButton Href="/appointment" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add">Book New</MudButton>
    </MudStack>

    <ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

    @if (_loading)
    {
        <ListSkeleton Rows="4" />
    }
    else if (_appointments.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.CalendarMonth" Title="No appointments yet"
                    Text="Book a visit and it will show up here with its status." ActionText="Book a visit" ActionHref="/appointment" />
    }
    else
    {
        <div class="appointment-list">
            @foreach (var appointment in _appointments)
            {
                <MudPaper Outlined="true" Class="appointment-card">
                    <div class="appointment-card-header">
                        <div class="min-w-0">
                            <MudText Typo="Typo.subtitle1" Class="text-strong">@ServiceName(appointment)</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@DateTimeFormat.FormatDateTime(appointment.ScheduledStart)</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(appointment.Status)">@StatusLabel(appointment.Status)</MudChip>
                    </div>

                    @if (appointment.Status == "Cancelled")
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">This visit was cancelled.</MudText>
                    }
                    else
                    {
                        <ol class="appointment-progress" aria-label="Visit progress">
                            @foreach (var (label, done) in Progress(appointment))
                            {
                                <li class="@(done ? "done" : null)">
                                    <span class="appointment-progress-dot"></span>
                                    <span class="appointment-progress-label">@label</span>
                                </li>
                            }
                        </ol>
                    }

                    @if (!string.IsNullOrWhiteSpace(appointment.NavigationUrl) || CanCancel(appointment))
                    {
                        <div class="appointment-card-actions">
                            @if (!string.IsNullOrWhiteSpace(appointment.NavigationUrl))
                            {
                                <MudButton Href="@appointment.NavigationUrl" Target="_blank" Size="Size.Small" Variant="Variant.Text"
                                           StartIcon="@Icons.Material.Outlined.LocationOn">Directions</MudButton>
                            }
                            @if (CanCancel(appointment))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Cancel"
                                           OnClick="@(() => CancelAsync(appointment))">Cancel visit</MudButton>
                            }
                        </div>
                    }
                </MudPaper>
            }
        </div>
    }

@code {
    private List<AppointmentResponse> _appointments = [];
    private Dictionary<Guid, string> _serviceNames = [];
    private bool _loading = true;
    private string? _loadError;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;

        // Capped at 100, no pagination UI yet - revisit if a customer's appointment history grows past this.
        var result = await ApiClient.GetAsync<PaginatedResponse<AppointmentResponse>>(ApiRoutes.Paged(ApiRoutes.Operations.Appointments.Mine, 0, 100));
        if (!result.IsSuccessful || result.ResultData is null)
        {
            _loadError = result.DisplayMessage;
            _appointments = [];
            _loading = false;
            return;
        }

        _appointments = [.. result.ResultData.Items.OrderByDescending(a => a.ScheduledStart)];
        await LoadServiceNamesAsync();
        _loading = false;
    }

    private async Task LoadServiceNamesAsync()
    {
        var serviceIds = _appointments.Select(a => a.ServiceId).OfType<Guid>().Distinct();
        var lookups = await Task.WhenAll(serviceIds.Select(async serviceId =>
        {
            var result = await ApiClient.GetAsync<ServiceDetailResponse>(ApiRoutes.Services.ById(serviceId));
            return (ServiceId: serviceId, Title: result.IsSuccessful ? result.ResultData?.Title : null);
        }));

        _serviceNames = lookups
            .Where(l => l.Title is not null)
            .ToDictionary(l => l.ServiceId, l => l.Title ?? string.Empty);
    }

    private string ServiceName(AppointmentResponse appointment) =>
        appointment.ServiceId is Guid serviceId && _serviceNames.TryGetValue(serviceId, out var name) ? name : "General meeting";

    private static bool CanCancel(AppointmentResponse appointment) => appointment.Status is "Pending" or "Confirmed";

    private static string StatusLabel(string status) => status switch
    {
        "Pending" => "Requested",
        "PendingPayment" => "Awaiting payment",
        _ => status,
    };

    private static IEnumerable<(string Label, bool Done)> Progress(AppointmentResponse appointment)
    {
        var completed = appointment.Status == "Completed";
        var confirmed = completed || appointment.Status == "Confirmed";

        yield return ("Requested", true);
        yield return ("Confirmed", confirmed);
        yield return ("Technician assigned", completed || appointment.AssignedTechnicianUserId is not null);
        yield return ("Completed", completed);
    }

    private static Color StatusColor(string status) => status switch
    {
        "Pending" => Color.Warning,
        "Confirmed" => Color.Info,
        "Completed" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default,
    };

    private async Task CancelAsync(AppointmentResponse appointment)
    {
        var result = await ApiClient.PostAsync(ApiRoutes.Operations.Appointments.Cancel(appointment.Id), new { });
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await ReloadAsync();
    }
}
