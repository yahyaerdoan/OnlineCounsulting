@* Read-only order detail/invoice view - no separate Invoice entity exists in this stack.
   Full page (not a dialog) - the dialog-to-page threshold applies once content grows past a
   couple of fields, and this shows a header block plus a full line-item table (a stacked item list on phones). *@
@page "/user/orders/{OrderId:guid}"
@attribute [Authorize(Roles = AppRoles.User)]
@layout OnlineConsulting.Maui.Shared.Layout.DashboardLayout
@using OnlineConsulting.Maui.Shared.Components.User
@inject IApiClient ApiClient

<PageTitle>Order Detail</PageTitle>

<DashboardPageHeading Text="@(_detail is not null ? $"Order {_detail.Order.OrderNumber}" : "Order Detail")" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_detail is not null)
{
    <MudPaper Outlined="true" Class="order-detail-card mb-4">
        <div class="order-detail-header">
            <span class="tone-bubble @AccentTone.Orange"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" /></span>
            <div class="min-w-0">
                <MudText Typo="Typo.subtitle1" Class="text-strong">#@_detail.Order.OrderNumber</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Placed @DateTimeFormat.FormatDateTime(_detail.Order.CreatedDate)</MudText>
            </div>
        </div>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-3">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-0">Status: @_detail.Order.OrderStatus</MudChip>
            <MudChip T="string" Size="Size.Small" Color="@OrdersList.PaymentColor(_detail.Order.PaymentStatus)">Payment: @_detail.Order.PaymentStatus</MudChip>
        </MudStack>
    </MudPaper>

    <MudPaper Outlined="true" Class="order-detail-card mobile-only">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Items</MudText>
        @foreach (var item in _detail.Items)
        {
            <div class="order-detail-item">
                <div class="min-w-0">
                    <MudText Typo="Typo.body2" Class="text-strong">@(_serviceNames.GetValueOrDefault(item.ServiceId) ?? "Service")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Quantity &times; @CurrencyFormat.Format(item.UnitPrice) · tax @CurrencyFormat.Format(item.TaxAmount)</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="text-strong">@CurrencyFormat.Format(item.TotalPrice)</MudText>
            </div>
        }
        <div class="order-detail-total">
            <MudText Typo="Typo.subtitle1">Total</MudText>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="text-strong">@CurrencyFormat.Format(_detail.Order.TotalPrice)</MudText>
        </div>
    </MudPaper>

    <MudSimpleTable Dense="true" Class="hide-on-phone">
        <thead>
            <tr>
                <th>Service</th>
                <th>Qty</th>
                <th class="text-right">Unit Price</th>
                <th class="text-right">Tax</th>
                <th class="text-right">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _detail.Items)
            {
                <tr>
                    <td>@(_serviceNames.GetValueOrDefault(item.ServiceId) ?? item.ServiceId.ToString())</td>
                    <td>@item.Quantity</td>
                    <td class="text-right">@CurrencyFormat.Format(item.UnitPrice)</td>
                    <td class="text-right">@CurrencyFormat.Format(item.TaxAmount)</td>
                    <td class="text-right">@CurrencyFormat.Format(item.TotalPrice)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3 hide-on-phone">
        <MudText Typo="Typo.subtitle1">Total: @CurrencyFormat.Format(_detail.Order.TotalPrice)</MudText>
    </MudStack>

    <MudButton Href="/user/orders" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack"
               Class="mt-4 order-detail-back">Back to orders</MudButton>
}

@code {
    [Parameter]
    public Guid OrderId { get; set; }

    private OrderDetailResponse? _detail;
    private readonly Dictionary<Guid, string> _serviceNames = [];
    private bool _loading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiClient.GetAsync<OrderDetailResponse>(ApiRoutes.Commerce.Orders.ById(OrderId));
        if (!result.IsSuccessful || result.ResultData is null)
        {
            _loadError = result.DisplayMessage;
            _loading = false;
            return;
        }

        _detail = result.ResultData;

        foreach (var serviceId in _detail.Items.Select(i => i.ServiceId).Distinct())
        {
            var serviceResult = await ApiClient.GetAsync<ServiceDetailResponse>(ApiRoutes.Services.ById(serviceId));
            if (serviceResult.IsSuccessful && serviceResult.ResultData is not null)
            {
                _serviceNames[serviceId] = serviceResult.ResultData.Title;
            }
        }

        _loading = false;
    }
}
