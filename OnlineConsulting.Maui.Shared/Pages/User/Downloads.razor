@* Downloads has no backend - the legacy MVC version rendered fake placeholder rows (template
   PSD names). This is a real "coming soon" stub instead, no fabricated data. *@
@page "/user/downloads"
@attribute [Authorize(Roles = AppRoles.User)]
@layout OnlineConsulting.Maui.Shared.Layout.DashboardLayout

<PageTitle>Downloads</PageTitle>

<DashboardPageHeading Text="Downloads" />

<div class="cart-empty">
    <span class="tone-bubble tone-bubble-lg tone-cornflower"><MudIcon Icon="@Icons.Material.Outlined.Download" /></span>
    <MudText Typo="Typo.h6" Class="text-strong">Coming Soon</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">Manuals, warranty papers and service reports for your units will be available here. Your receipts are under Invoices.</MudText>
    <div class="cart-empty-actions">
        <MudButton Href="/user/invoices" Variant="Variant.Filled" Class="sell-btn" StartIcon="@Icons.Material.Outlined.ReceiptLong">View Invoices</MudButton>
    </div>
</div>
