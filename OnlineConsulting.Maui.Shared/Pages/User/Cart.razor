@* Storefront cart - basket ownership is implicit (JWT or guest_id cookie), never passed by the
   client. Interactive (no [ExcludeFromInteractiveRouting]), so quantity/removal updates live. One card per item at every
   width (photo, name, unit price and tax, a quantity stepper, line total, remove); on wide screens the order summary sits
   beside the list and stays in view while scrolling, on phones it follows the list. *@
@page "/user/cart"
@using Microsoft.AspNetCore.Http
@using OnlineConsulting.Maui.Shared.Components.Marketing
@using OnlineConsulting.Maui.Shared.Components.User
@using OnlineConsulting.Maui.Shared.Infrastructure.Commerce
@inject IApiClient ApiClient
@inject DataChangeNotifier Notifier
@implements IDisposable
@inject ISnackbar Snackbar
@inject CartState CartState

<PageTitle>Cart</PageTitle>

<MarketingPageBanner Title="Cart" SubPage="Cart" />

<MudContainer MaxWidth="MaxWidth.Large" Class="marketing-section-tight">
    <ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_items.Count == 0 && _loadError is null)
    {
        <div class="cart-empty">
            <span class="tone-bubble tone-bubble-lg tone-blue"><MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" /></span>
            <MudText Typo="Typo.h6" Class="text-strong">Your cart is empty</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Browse filters, parts and products we ship, or book a technician for a visit.</MudText>
            <div class="cart-empty-actions">
                <MudButton Href="/services" Variant="Variant.Filled" Class="sell-btn" EndIcon="@Icons.Material.Filled.ArrowForward">Browse services</MudButton>
                <MudButton Href="/appointment" Variant="Variant.Outlined" Color="Color.Primary" Class="svc-action" StartIcon="@Icons.Material.Outlined.EventAvailable">Book a visit</MudButton>
            </div>
        </div>
    }
    else if (_basket is not null)
    {
        <div class="cart-layout">
            <section class="cart-lines" aria-label="Items in your cart">
                <div class="cart-head">
                    <MudText Typo="Typo.h5" Class="marketing-display text-strong">Your cart</MudText>
                    <span class="cart-head-count">@ItemCount @(ItemCount == 1 ? "item" : "items")</span>
                    <a href="/services" class="cart-head-continue hide-on-phone"><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />Continue shopping</a>
                </div>

                @if (HasBookingItems)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        Some items are services we book as a visit, not sell online. Remove them to check out, then use
                        <strong>Book a visit</strong> on each one to schedule it.
                    </MudAlert>
                }

                <div class="cart-item-cards" role="list">
                    @foreach (var item in _items)
                    {
                        var info = _serviceInfo.GetValueOrDefault(item.ServiceId);
                        var detailUrl = info is not null ? $"/services/{info.Slug}" : null;
                        var isBooking = info?.Kind == ServiceKinds.Booking;
                        <div class="@($"cart-item-card {(isBooking ? "cart-item-blocked" : "")}")" role="listitem">
                            <a href="@detailUrl" class="cart-item-thumb" aria-label="@(info?.Title ?? "Service")">
                                @if (info?.ImageUrl is { Length: > 0 } imageUrl)
                                {
                                    <img src="@imageUrl" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" />
                                }
                            </a>
                            <div class="cart-item-body">
                                <div class="cart-item-top">
                                    <a href="@detailUrl" class="cart-item-title">@(info?.Title ?? "Service")</a>
                                    <MudTooltip Text="Remove from cart">
                                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                                       Disabled="@_isBusy" OnClick="@(() => RemoveItemAsync(item))" aria-label="Remove from cart" />
                                    </MudTooltip>
                                </div>
                                <span class="cart-item-meta">@CurrencyFormat.Format(item.Price) each · tax @(item.TaxRate)% (@CurrencyFormat.Format(item.TaxAmount))</span>
                                @if (isBooking)
                                {
                                    <MudLink Href="@($"/appointment?service={item.ServiceId}")" Typo="Typo.caption" Color="Color.Warning" Class="text-strong">Booked as a visit · Book instead</MudLink>
                                }
                                <div class="cart-item-bottom">
                                    <div class="cart-qty" role="group" aria-label="Quantity">
                                        <button type="button" class="cart-qty-button" aria-label="Decrease quantity"
                                                disabled="@(_isBusy || item.Quantity <= 1)" @onclick="@(() => ChangeQuantityAsync(item, item.Quantity - 1))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Remove" Size="Size.Small" />
                                        </button>
                                        <span class="cart-qty-value" aria-live="polite">@item.Quantity</span>
                                        <button type="button" class="cart-qty-button" aria-label="Increase quantity"
                                                disabled="@_isBusy" @onclick="@(() => ChangeQuantityAsync(item, item.Quantity + 1))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                                        </button>
                                    </div>
                                    <span class="cart-item-total">@CurrencyFormat.Format(item.TotalPrice)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <aside class="cart-summary-col" aria-label="Order summary">
                <div class="cart-summary-sticky">
                    <CartSummary SubTotal="@_basket.SubTotalPrice" TaxTotal="@_taxTotal" Total="@_basket.TotalPrice" Disabled="@(_isBusy || HasBookingItems)" />
                    <ul class="cart-assurance">
                        <li><MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />Secure payment by Stripe</li>
                        <li><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small" />Tax is included in your total</li>
                    </ul>
                    <MudButton Href="/services" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ArrowBack"
                               FullWidth="true" Class="svc-action cart-continue-button mobile-only">Continue shopping</MudButton>
                </div>
            </aside>
        </div>
    }
</MudContainer>

@code {
    private sealed record ServiceLineInfo(string Title, string Slug, string? ImageUrl, string Kind);

    private BasketResponse? _basket;
    private List<BasketItemResponse> _items = [];
    private Dictionary<Guid, ServiceLineInfo> _serviceInfo = [];
    private bool _loading = true;
    private bool _isBusy;
    private string? _loadError;

    private decimal _taxTotal => _items.Sum(i => i.TaxAmount);

    private int ItemCount => _items.Sum(i => i.Quantity);

    /// <summary>Booking services can't be checked out (the Api rejects them) - flag them and block checkout until removed.</summary>
    private bool HasBookingItems => _items.Any(i => _serviceInfo.GetValueOrDefault(i.ServiceId)?.Kind == ServiceKinds.Booking);

    private IDisposable? _liveUpdates;

    protected override async Task OnInitializedAsync()
    {
        _liveUpdates = Notifier.Subscribe(() => InvokeAsync(async () =>
        {
            if (!_isBusy)
            {
                await LoadBasketAsync();
                StateHasChanged();
            }
        }), DataTopic.Basket);

        await LoadBasketAsync();
        _loading = false;
    }

    /// <summary>Refreshes the basket in place. The full-page progress bar is only for the first load - showing it on every
    /// quantity change swapped the whole cart out for a moment, and the page jumped.</summary>
    private async Task LoadBasketAsync()
    {
        var result = await ApiClient.GetAsync<BasketResponse>(ApiRoutes.Commerce.Baskets.Base);
        if (!result.IsSuccessful || result.ResultData is null)
        {
            // No basket yet is a normal empty-cart state, not a load failure.
            if (result.StatusCode != StatusCodes.Status404NotFound)
            {
                _loadError = result.DisplayMessage;
            }

            _basket = null;
            _items = [];
            CartState.SetCount(0);
            return;
        }

        _basket = result.ResultData;
        _items = [.. _basket.Items];
        CartState.SetCount(_items.Count);
        await LoadServiceInfoAsync();
    }

    /// <summary>Fetches title/slug/image only for services not already known, so a quantity change doesn't refetch every line.</summary>
    private async Task LoadServiceInfoAsync()
    {
        var unknownItems = _items.Where(i => !_serviceInfo.ContainsKey(i.ServiceId)).DistinctBy(i => i.ServiceId);
        var lookups = await Task.WhenAll(unknownItems.Select(async item =>
        {
            var serviceResult = await ApiClient.GetAsync<ServiceDetailResponse>(ApiRoutes.Services.ById(item.ServiceId));
            if (!serviceResult.IsSuccessful || serviceResult.ResultData is null)
            {
                return (item.ServiceId, Info: (ServiceLineInfo?)null);
            }

            var service = serviceResult.ResultData;
            var imageUrl = service.CoverMediaAssetId is Guid coverId
                ? await MediaUploadHelper.GetUrlAsync(ApiClient, coverId)
                : null;

            return (item.ServiceId, Info: (ServiceLineInfo?)new ServiceLineInfo(service.Title, service.Slug, imageUrl, service.Kind));
        }));

        foreach (var (serviceId, info) in lookups)
        {
            if (info is not null)
            {
                _serviceInfo[serviceId] = info;
            }
        }
    }

    private async Task ChangeQuantityAsync(BasketItemResponse item, int newQuantity)
    {
        _isBusy = true;
        StateHasChanged();

        var result = await ApiClient.PutAsync(ApiRoutes.Commerce.Baskets.SetItemQuantity(item.Id), new { quantity = newQuantity });

        if (result.IsSuccessful)
        {
            await LoadBasketAsync();
        }
        else
        {
            Snackbar.ShowError(result.DisplayMessage);
        }

        _isBusy = false;
    }

    private async Task RemoveItemAsync(BasketItemResponse item)
    {
        _isBusy = true;
        StateHasChanged();

        var result = await ApiClient.DeleteAsync(ApiRoutes.Commerce.Baskets.RemoveItem(item.Id));

        if (result.IsSuccessful)
        {
            Snackbar.ShowSuccess(result.DisplayMessage);
            await LoadBasketAsync();
        }
        else
        {
            Snackbar.ShowError(result.DisplayMessage);
        }

        _isBusy = false;
    }

    public void Dispose() => _liveUpdates?.Dispose();
}
