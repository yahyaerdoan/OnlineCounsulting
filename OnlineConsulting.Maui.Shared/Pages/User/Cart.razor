@* Storefront cart - basket ownership is implicit (JWT or guest_id cookie), never passed by the
   client. Interactive (no [ExcludeFromInteractiveRouting]), so quantity/removal updates live. Wide screens get the
   line-item table; phones get one card per item with a thumb-sized quantity stepper, then the totals, then
   "Continue shopping" as a secondary full-width button. *@
@page "/user/cart"
@using Microsoft.AspNetCore.Http
@using OnlineConsulting.Maui.Shared.Components.Marketing
@using OnlineConsulting.Maui.Shared.Components.User
@using OnlineConsulting.Maui.Shared.Infrastructure.Commerce
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject CartState CartState

<PageTitle>Cart</PageTitle>

<MarketingPageBanner Title="Cart" SubPage="Cart" />

<MudContainer MaxWidth="MaxWidth.Large" Class="marketing-section-tight">
    <ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_items.Count == 0 && _loadError is null)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-10" Spacing="3">
            <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">Your cart is empty.</MudText>
            <MudButton Href="/services" Variant="Variant.Filled" Color="Color.Primary">Browse Services</MudButton>
        </MudStack>
    }
    else if (_basket is not null)
    {
        <div class="cart-item-cards mobile-only" role="list">
            @foreach (var item in _items)
            {
                var info = _serviceInfo.GetValueOrDefault(item.ServiceId);
                var detailUrl = info is not null ? $"/services/{info.Slug}" : null;
                <div class="cart-item-card" role="listitem">
                    <a href="@detailUrl" class="cart-item-thumb" aria-label="@(info?.Title ?? "Service")">
                        @if (info?.ImageUrl is { Length: > 0 } imageUrl)
                        {
                            <img src="@imageUrl" alt="" loading="lazy" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.HomeRepairService" />
                        }
                    </a>
                    <div class="cart-item-body">
                        <div class="cart-item-top">
                            <a href="@detailUrl" class="cart-item-title">@(info?.Title ?? "Service")</a>
                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                           Disabled="@_isBusy" OnClick="@(() => RemoveItemAsync(item))" aria-label="Remove from cart" />
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@CurrencyFormat.Format(item.Price) each · tax @(item.TaxRate)%</MudText>
                        <div class="cart-item-bottom">
                            <div class="cart-qty" role="group" aria-label="Quantity">
                                <button type="button" class="cart-qty-button" aria-label="Decrease quantity"
                                        disabled="@(_isBusy || item.Quantity <= 1)" @onclick="@(() => ChangeQuantityAsync(item, item.Quantity - 1))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Remove" Size="Size.Small" />
                                </button>
                                <span class="cart-qty-value" aria-live="polite">@item.Quantity</span>
                                <button type="button" class="cart-qty-button" aria-label="Increase quantity"
                                        disabled="@_isBusy" @onclick="@(() => ChangeQuantityAsync(item, item.Quantity + 1))">
                                    <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                                </button>
                            </div>
                            <span class="cart-item-total">@CurrencyFormat.Format(item.TotalPrice)</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <MudPaper Class="mb-4 hide-on-phone" Outlined="true">
            <MudTable Items="@_items" Hover="true" Elevation="0" Class="cart-items-table">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Service</MudTh>
                    <MudTh Class="mud-table-cell-align-center">Unit Price</MudTh>
                    <MudTh Class="mud-table-cell-align-center">Quantity</MudTh>
                    <MudTh Class="mud-table-cell-align-center">Tax Rate</MudTh>
                    <MudTh Class="mud-table-cell-align-center">Tax Amount</MudTh>
                    <MudTh Class="mud-table-cell-align-center">Subtotal</MudTh>
                    <MudTh Class="mud-table-cell-align-center">Total</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    @{
                        var info = _serviceInfo.GetValueOrDefault(item.ServiceId);
                    }
                    <MudTd DataLabel="#">@(_items.IndexOf(item) + 1)</MudTd>
                    <MudTd DataLabel="Service">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            @if (info?.ImageUrl is not null)
                            {
                                <MudImage Src="@info.ImageUrl" ObjectFit="ObjectFit.Cover" Height="48" Width="48" Class="rounded" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Image" Color="Color.Secondary" />
                            }
                            <MudLink Href="@(info is not null ? $"/services/{info.Slug}" : null)" Typo="Typo.body1">@(info?.Title ?? "Service")</MudLink>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Unit Price" Class="mud-table-cell-align-center">@CurrencyFormat.Format(item.Price)</MudTd>
                    <MudTd DataLabel="Quantity" Class="text-center">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Outlined.Remove" Size="Size.Small"
                                           Disabled="@(_isBusy || item.Quantity <= 1)" OnClick="@(() => ChangeQuantityAsync(item, item.Quantity - 1))" />
                            <MudText>@item.Quantity</MudText>
                            <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small"
                                           Disabled="@_isBusy" OnClick="@(() => ChangeQuantityAsync(item, item.Quantity + 1))" />
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Tax Rate" Class="mud-table-cell-align-center">@(item.TaxRate)%</MudTd>
                    <MudTd DataLabel="Tax Amount" Class="mud-table-cell-align-center">@CurrencyFormat.Format(item.TaxAmount)</MudTd>
                    <MudTd DataLabel="Subtotal" Class="mud-table-cell-align-center">@CurrencyFormat.Format(item.SubTotalPrice)</MudTd>
                    <MudTd DataLabel="Total" Class="mud-table-cell-align-center text-strong">@CurrencyFormat.Format(item.TotalPrice)</MudTd>
                    <MudTd DataLabel="Remove">
                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                       Disabled="@_isBusy" OnClick="@(() => RemoveItemAsync(item))" title="Remove" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>

        <MudGrid>
            <MudItem xs="12" md="8" Class="d-flex align-center cart-continue-col">
                <MudButton Href="/services" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ArrowBack"
                           Class="cart-continue-button">
                    Continue shopping
                </MudButton>
            </MudItem>
            <MudItem xs="12" md="4" Class="cart-summary-col">
                <CartSummary SubTotal="@_basket.SubTotalPrice" TaxTotal="@_taxTotal" Total="@_basket.TotalPrice" Disabled="@_isBusy" />
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private sealed record ServiceLineInfo(string Title, string Slug, string? ImageUrl);

    private BasketResponse? _basket;
    private List<BasketItemResponse> _items = [];
    private Dictionary<Guid, ServiceLineInfo> _serviceInfo = [];
    private bool _loading = true;
    private bool _isBusy;
    private string? _loadError;

    private decimal _taxTotal => _items.Sum(i => i.TaxAmount);

    protected override async Task OnInitializedAsync()
    {
        await LoadBasketAsync();
        _loading = false;
    }

    /// <summary>Refreshes the basket in place. The full-page progress bar is only for the first load - showing it on every
    /// quantity change swapped the whole cart out for a moment, and the page jumped.</summary>
    private async Task LoadBasketAsync()
    {
        var result = await ApiClient.GetAsync<BasketResponse>(ApiRoutes.Commerce.Baskets.Base);
        if (!result.IsSuccessful || result.ResultData is null)
        {
            // No basket yet is a normal empty-cart state, not a load failure.
            if (result.StatusCode != StatusCodes.Status404NotFound)
            {
                _loadError = result.DisplayMessage;
            }

            _basket = null;
            _items = [];
            CartState.SetCount(0);
            return;
        }

        _basket = result.ResultData;
        _items = [.. _basket.Items];
        CartState.SetCount(_items.Count);
        await LoadServiceInfoAsync();
    }

    /// <summary>Fetches title/slug/image only for services not already known, so a quantity change doesn't refetch every line.</summary>
    private async Task LoadServiceInfoAsync()
    {
        var unknownItems = _items.Where(i => !_serviceInfo.ContainsKey(i.ServiceId)).DistinctBy(i => i.ServiceId);
        var lookups = await Task.WhenAll(unknownItems.Select(async item =>
        {
            var serviceResult = await ApiClient.GetAsync<ServiceDetailResponse>(ApiRoutes.Services.ById(item.ServiceId));
            if (!serviceResult.IsSuccessful || serviceResult.ResultData is null)
            {
                return (item.ServiceId, Info: (ServiceLineInfo?)null);
            }

            var service = serviceResult.ResultData;
            var imageUrl = service.CoverMediaAssetId is Guid coverId
                ? await MediaUploadHelper.GetUrlAsync(ApiClient, coverId)
                : null;

            return (item.ServiceId, Info: (ServiceLineInfo?)new ServiceLineInfo(service.Title, service.Slug, imageUrl));
        }));

        foreach (var (serviceId, info) in lookups)
        {
            if (info is not null)
            {
                _serviceInfo[serviceId] = info;
            }
        }
    }

    private async Task ChangeQuantityAsync(BasketItemResponse item, int newQuantity)
    {
        _isBusy = true;
        StateHasChanged();

        var result = await ApiClient.PutAsync(ApiRoutes.Commerce.Baskets.SetItemQuantity(item.Id), new { quantity = newQuantity });

        if (result.IsSuccessful)
        {
            await LoadBasketAsync();
        }
        else
        {
            Snackbar.ShowError(result.DisplayMessage);
        }

        _isBusy = false;
    }

    private async Task RemoveItemAsync(BasketItemResponse item)
    {
        _isBusy = true;
        StateHasChanged();

        var result = await ApiClient.DeleteAsync(ApiRoutes.Commerce.Baskets.RemoveItem(item.Id));

        if (result.IsSuccessful)
        {
            Snackbar.ShowSuccess(result.DisplayMessage);
            await LoadBasketAsync();
        }
        else
        {
            Snackbar.ShowError(result.DisplayMessage);
        }

        _isBusy = false;
    }
}
