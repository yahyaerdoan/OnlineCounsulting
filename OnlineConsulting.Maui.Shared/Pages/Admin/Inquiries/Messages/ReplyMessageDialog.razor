@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Inquiries
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject FormState<ReplyMessageModel> Form

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reply to @Message.FirstName @Message.LastName</MudText>
    </TitleContent>
    <DialogContent>
        <EntitySummaryHeader Title="@Message.Subject" Subtitle="@Message.Email" />

        <EditForm EditContext="@Form.EditContext">
            <MudTextField @bind-Value="_model.ReplyBody" For="@(() => _model.ReplyBody)" Label="Reply" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="4" MaxLines="10" Sizing="InputSizing.Auto" Class="mt-3" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="SendAsync" IsBusy="@_isBusy" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public MessageResponse Message { get; set; } = default!;

    private readonly ReplyMessageModel _model = new();
    private bool _isBusy;

    protected override void OnInitialized() => Form.Bind(_model);

    private async Task SendAsync()
    {
        _isBusy = true;

        var result = await ApiClient.PostAsync(ApiRoutes.Inquiries.Messages.Reply(Message.Id), new { replyBody = _model.ReplyBody });

        _isBusy = false;

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private sealed class ReplyMessageModel
    {
        public string ReplyBody { get; set; } = string.Empty;
    }
}
