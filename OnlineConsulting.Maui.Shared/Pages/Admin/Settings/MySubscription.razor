@* Tenant-side self-service subscription view - any tenant admin manages their own modules here,
   reusing the platform-owner's ManageTenantModulesDialog (AddModule/RemoveModule already allow the
   caller to manage their own tenant via TenantOwnershipGuard, no new backend needed for the toggle). *@
@page "/admin/settings/my-subscription"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@using OnlineConsulting.Maui.Shared.Pages.Admin.Platform

<PageTitle>My Subscription</PageTitle>

<PageHeroBanner Title="My Subscription" Subtitle="Your business's active modules and billing." />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_tenant is not null)
{
    <MudPaper Outlined="true" Class="pa-4 rounded-lg mb-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.h6">@_tenant.Name</MudText>
            <MudChip T="string" Size="Size.Small" Color="@(_tenant.Status == "Active" ? Color.Success : Color.Default)">@_tenant.Status</MudChip>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_tenant.ActiveModuleKeys.Count active module(s) - @CurrencyFormat.Format(_tenant.TotalActivePrice) / period</MudText>
    </MudPaper>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ManageModulesAsync">Manage Modules</MudButton>
}

@code {
    private TenantResponse? _tenant;
    private bool _loading = true;
    private string? _loadError;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        var result = await ApiClient.GetAsync<TenantResponse>(ApiRoutes.Tenancy.MyTenant);
        if (!result.IsSuccessful || result.ResultData is null)
        {
            _loadError = result.DisplayMessage;
            _tenant = null;
        }
        else
        {
            _tenant = result.ResultData;
        }

        _loading = false;
    }

    private Task ManageModulesAsync() =>
        DialogService.ShowAndReloadAsync("Manage Modules", new DialogParameters<ManageTenantModulesDialog> { { x => x.Tenant, _tenant! } }, ReloadAsync);
}
