@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Settings
@inject IApiClient ApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Roles: @User.FirstName @User.LastName</MudText>
    </TitleContent>
    <DialogContent>
        <EntitySummaryHeader Title="@($"{User.FirstName} {User.LastName}")" Subtitle="@User.Email" />

        <ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            @foreach (var role in _assignments)
            {
                <MudChip T="string" Variant="@(role.IsAssigned ? Variant.Filled : Variant.Outlined)"
                         Color="@(role.IsAssigned ? Color.Primary : Color.Default)" OnClick="@(() => Toggle(role))">
                    @role.RoleName
                </MudChip>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="SaveAsync" IsBusy="@_isSaving" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public UserResponse User { get; set; } = default!;

    private List<RoleAssignmentResponse> _assignments = [];
    private string? _loadError;
    private bool _isSaving;

    protected override async Task OnInitializedAsync()
    {
        if (User.Links.Find(LinkRels.Roles) is not { } roles)
        {
            return;
        }

        var result = await ApiClient.FollowAsync<List<RoleAssignmentResponse>>(roles);
        if (result.IsSuccessful && result.ResultData is not null)
        {
            _assignments = result.ResultData;
        }
        else
        {
            _loadError = result.DisplayMessage;
        }
    }

    private void Toggle(RoleAssignmentResponse role) =>
        _assignments[_assignments.IndexOf(role)] = role with { IsAssigned = !role.IsAssigned };

    private async Task SaveAsync()
    {
        if (User.Links.Find(LinkRels.AssignRoles) is not { } assignRoles)
        {
            return;
        }

        _isSaving = true;
        var result = await ApiClient.FollowAsync(assignRoles, new { roleAssignments = _assignments });
        _isSaving = false;

        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
