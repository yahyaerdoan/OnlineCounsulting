@page "/admin/settings/users/{Id:guid}/permissions"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Member Permissions</PageTitle>

<PageHeroBanner Title="Member Permissions" Subtitle="Uncheck a permission to deny it for this person only - their role stays unchanged.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/settings/users"))">Back to Users</MudButton>
    </ActionContent>
</PageHeroBanner>
<PageBreadcrumbExtra Text="Member Permissions" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_user is not null && _rolePermissions.Count == 0)
{
    <MudText Typo="Typo.subtitle1" Class="mt-4">@_user.FirstName @_user.LastName</MudText>
    <MudAlert Severity="Severity.Info" Class="mt-2">
        This person's role grants no editable permissions (e.g. Super Admin or a bypass role) - nothing to narrow here.
    </MudAlert>
}
else if (_user is not null)
{
    <MudPaper Elevation="0" Outlined="true" Class="mt-2 pa-4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1">@_user.FirstName @_user.LastName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_user.Email</MudText>
            </MudStack>
            @if (_denied.Count > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Outlined.Block">
                    @_denied.Count restricted
                </MudChip>
            }
        </MudStack>

        <MudTextField T="string" ValueChanged="@(v => _filter = v)" Immediate="true" DebounceInterval="300" Margin="Margin.Dense"
                      Placeholder="Search modules" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                      IconSize="Size.Small" Class="mb-3" />

        @foreach (var (module, permissions) in _catalogByModule.Where(m => m.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
        {
            var deniedInModule = permissions.Count(_denied.Contains);

            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                    <MudText Typo="Typo.h6">@module</MudText>
                    @if (deniedInModule > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@deniedInModule restricted</MudChip>
                    }
                </MudStack>
                <MudTable Items="@(new[] { _user })" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Member</MudTh>
                        @foreach (var permission in permissions)
                        {
                            <MudTh Class="mud-table-cell-align-center">@ActionLabel(permission)</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate Context="member">
                        <MudTd DataLabel="Member">@member!.FirstName @member.LastName</MudTd>
                        @foreach (var permission in permissions)
                        {
                            <MudTd DataLabel="@ActionLabel(permission)" Class="mud-table-cell-align-center">
                                <MudStack Row="true" Justify="Justify.Center">
                                    <MudCheckBox T="bool" Value="@(!_denied.Contains(permission))" ValueChanged="@(v => Toggle(permission, v))"
                                                 Dense="true" Color="@(_denied.Contains(permission) ? Color.Warning : Color.Primary)" Class="ma-0" />
                                </MudStack>
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-4">
            <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="@(_denied.Count == 0)" OnClick="ResetAsync">
                Reset to role defaults
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@_isSaving">Save</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UserResponse? _user;
    private List<string> _rolePermissions = [];
    private HashSet<string> _denied = [];
    private Dictionary<string, string[]> _catalogByModule = [];
    private string _filter = string.Empty;
    private bool _loading = true;
    private bool _isSaving;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        var userResult = await ApiClient.GetAsync<UserResponse>(ApiRoutes.Users.ById(Id));
        if (!userResult.IsSuccessful || userResult.ResultData is null)
        {
            _loadError = userResult.DisplayMessage;
            _loading = false;
            return;
        }

        _user = userResult.ResultData;

        var catalogResult = await ApiClient.GetAsync<Dictionary<string, string[]>>(ApiRoutes.Permissions.All);
        var overridesResult = await ApiClient.GetAsync<UserPermissionOverridesResponse>(ApiRoutes.Users.PermissionOverrides(Id));

        if (!catalogResult.IsSuccessful || catalogResult.ResultData is null || !overridesResult.IsSuccessful || overridesResult.ResultData is null)
        {
            _loadError = !catalogResult.IsSuccessful ? catalogResult.DisplayMessage : overridesResult.DisplayMessage;
            _loading = false;
            return;
        }

        _rolePermissions = overridesResult.ResultData.RolePermissions;
        _denied = [.. overridesResult.ResultData.DeniedPermissions];

        // Only show modules/permissions this person's role actually grants - nothing to toggle otherwise.
        _catalogByModule = catalogResult.ResultData
            .Select(kv => (kv.Key, Permissions: kv.Value.Where(_rolePermissions.Contains).ToArray()))
            .Where(m => m.Permissions.Length > 0)
            .ToDictionary(m => m.Key, m => m.Permissions);

        _loading = false;
    }

    /// <summary>Permission strings are "module.action" - just the action reads well as a label.</summary>
    private static string ActionLabel(string permission)
    {
        var action = permission.Contains('.') ? permission[(permission.LastIndexOf('.') + 1)..] : permission;
        return action.Length == 0 ? action : char.ToUpperInvariant(action[0]) + action[1..];
    }

    private void Toggle(string permission, bool isGranted)
    {
        if (isGranted)
        {
            _ = _denied.Remove(permission);
        }
        else
        {
            _ = _denied.Add(permission);
        }
    }

    private async Task ResetAsync()
    {
        if (!await DialogService.ConfirmAsync("Reset to Role Defaults", "Clear every restriction for this person? They'll get everything their role normally grants."))
        {
            return;
        }

        _denied.Clear();
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        var result = await ApiClient.PutAsync(ApiRoutes.Users.PermissionOverrides(Id), new { deniedPermissions = _denied.ToArray() });
        _isSaving = false;

        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
    }
}
