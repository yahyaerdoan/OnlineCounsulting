@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Settings
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.Settings.RoleModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject FormState<RoleFormModel> Form

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit @Role.Name</MudText>
    </TitleContent>
    <DialogContent>
        <EntitySummaryHeader Title="@Role.Name" Subtitle="@Role.Description" />

        <EditForm EditContext="@Form.EditContext">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" />

                <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="1" MaxLines="5" Sizing="InputSizing.Auto" Placeholder="What can people in this role do?" />
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="SaveAsync" IsBusy="@Form.IsBusy" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public RoleResponse Role { get; set; } = default!;

    private readonly RoleFormModel _model = new();

    protected override void OnInitialized()
    {
        _model.Name = Role.Name;
        _model.Description = Role.Description;
        Form.Bind(_model);
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var result = await ApiClient.PutAsync(ApiRoutes.Roles.ById(Role.Id), new { name = _model.Name, description = _model.Description });
        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        MudDialog.Close(DialogResult.Ok(true));
    });
}
