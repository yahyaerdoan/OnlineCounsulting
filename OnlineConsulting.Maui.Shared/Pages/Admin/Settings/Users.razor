@page "/admin/settings/users"
@attribute [Authorize]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Users</PageTitle>

<PageHeroBanner Title="Users" Subtitle="Manage your team's accounts, roles, and access." />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="UserResponse" @ref="_table" ApiBasePath="@ApiRoutes.Users.All"
                 SearchPlaceholder="Search name or email" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@nameof(UserResponse.LastName)" T="UserResponse">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(UserResponse.Email)" T="UserResponse">Email</MudTableSortLabel></MudTh>
        <MudTh>Roles</MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(UserResponse.IsActive)" T="UserResponse">Status</MudTableSortLabel></MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="user">
        <MudTd DataLabel="Name">@user.FirstName @user.LastName</MudTd>
        <MudTd DataLabel="Email">@user.Email</MudTd>
        <MudTd DataLabel="Roles">
            @foreach (var role in user.Roles)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Class="mr-1">@role</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(user.IsActive ? Color.Success : Color.Default)">
                @(user.IsActive ? "Active" : "Inactive")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                <MudIconButton Icon="@Icons.Material.Outlined.EditNote" Color="Color.Default" title="Edit"
                               OnClick="@(() => EditAsync(user))" />

                <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts" Color="Color.Default" title="Manage roles"
                               OnClick="@(() => ManageRolesAsync(user))" />

                <MudToggleIconButton Toggled="user.IsActive" ToggledChanged="@(_ => ToggleActiveAsync(user))"
                                      Icon="@Icons.Material.Filled.PersonAddAlt1" Color="Color.Success" title="Activate/Deactivate"
                                      ToggledIcon="@Icons.Material.Filled.PersonOff" ToggledColor="Color.Warning" />

                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" title="Delete"
                               OnClick="@(() => DeleteAsync(user))" />
            </MudButtonGroup>
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<UserResponse> _table = default!;
    private string? _loadError;

    private Task EditAsync(UserResponse user) =>
        DialogService.ShowAndReloadAsync("Edit User", new DialogParameters<EditUserDialog> { { x => x.User, user } }, _table.ReloadAsync);

    private Task ManageRolesAsync(UserResponse user) =>
        DialogService.ShowAndReloadAsync("Edit Roles", new DialogParameters<UserRolesDialog> { { x => x.User, user } }, _table.ReloadAsync);

    private async Task ToggleActiveAsync(UserResponse user)
    {
        var result = await ApiClient.PutAsync(ApiRoutes.Users.ById(user.Id),
            new { firstName = user.FirstName, lastName = user.LastName, isActive = !user.IsActive });

        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }

    private async Task DeleteAsync(UserResponse user)
    {
        if (!await DialogService.ConfirmDeleteAsync("user", $"{user.FirstName} {user.LastName}"))
        {
            return;
        }

        var result = await ApiClient.DeleteAsync(ApiRoutes.Users.ById(user.Id));
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
