@* Team and customer accounts. The role tabs come from the tenant's own roles, so a custom role such as "Technician" gets its own
   tab and list once the admin creates it. *@
@page "/admin/settings/users"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Users</PageTitle>

<PageHeroBanner Title="Users" Subtitle="Manage your team's accounts, roles, and access." />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

@if (_roleTabs.Count > 1)
{
    <ListFilterTabs Options="_roleTabs" Selected="@_role" SelectedChanged="OnRoleChanged" Label="Filter by role" />
}

<ServerDataTable TItem="UserResponse" @ref="_table" ApiBasePath="@ApiRoutes.Users.All" ExtraQuery="RoleQuery"
                 SearchPlaceholder="Search name or email" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@nameof(UserResponse.LastName)" T="UserResponse">User</MudTableSortLabel></MudTh>
        <MudTh>Roles</MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(UserResponse.IsActive)" T="UserResponse">Status</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(UserResponse.CreatedDate)" T="UserResponse">Joined</MudTableSortLabel></MudTh>
        <MudTh Class="cell-actions">Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="user">
        <MudTd Class="cell-primary">
            <PersonCell Name="@($"{user.FirstName} {user.LastName}")" Secondary="@user.Email" ImageUrl="@user.ImageUrl" />
        </MudTd>
        <MudTd DataLabel="Roles">
            <span class="cell-chips">
                @if (user.Roles.Count == 0)
                {
                    <span class="cell-muted">No role</span>
                }
                @foreach (var role in user.Roles)
                {
                    <span class="role-chip">@role</span>
                }
            </span>
        </MudTd>
        <MudTd DataLabel="Status">
            <StatusBadge Label="@(user.IsActive ? "Active" : "Inactive")" Kind="@(user.IsActive ? StatusKinds.Success : StatusKinds.Neutral)" />
        </MudTd>
        <MudTd DataLabel="Joined">@(user.CreatedDate is { } joined ? BusinessTime.FormatDate(joined) : "-")</MudTd>
        <MudTd DataLabel="Actions" Class="cell-actions">
            <MudTooltip Text="Edit">
                <MudIconButton Icon="@Icons.Material.Outlined.EditNote" Size="Size.Small" aria-label="Edit" Disabled="@(!user.Can(LinkRels.Edit))"
                               OnClick="@(() => EditAsync(user))" />
            </MudTooltip>
            <MudTooltip Text="Manage roles">
                <MudIconButton Icon="@Icons.Material.Outlined.ManageAccounts" Size="Size.Small" aria-label="Manage roles" Disabled="@(!user.Can(LinkRels.AssignRoles))"
                               OnClick="@(() => ManageRolesAsync(user))" />
            </MudTooltip>
            <MudTooltip Text="Narrow permissions">
                <MudIconButton Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" aria-label="Narrow permissions" Disabled="@(!user.Can(LinkRels.PermissionOverrides))"
                               OnClick="@(() => Navigation.NavigateTo($"{AppRoutes.AdminHome}/settings/users/{user.Id}/permissions"))" />
            </MudTooltip>
            <MudTooltip Text="@(user.IsActive ? "Deactivate" : "Activate")">
                <MudIconButton Icon="@(user.IsActive ? Icons.Material.Outlined.PersonOff : Icons.Material.Outlined.PersonAddAlt1)" Size="Size.Small"
                               Color="@(user.IsActive ? Color.Warning : Color.Success)"
                               aria-label="@(user.IsActive ? "Deactivate" : "Activate")" Disabled="@(!user.Can(LinkRels.Edit))" OnClick="@(() => ToggleActiveAsync(user))" />
            </MudTooltip>
            <MudTooltip Text="Delete">
                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Size="Size.Small" aria-label="Delete" Disabled="@(!user.Can(LinkRels.Delete))"
                               OnClick="@(() => DeleteAsync(user))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">@(_role.Length == 0 ? "No users found." : $"No users with the {_role} role.")</MudText>
    </NoRecordsContent>
</ServerDataTable>

@code {
    private ServerDataTable<UserResponse>? _table;
    private string? _loadError;
    private string _role = string.Empty;
    private List<ListFilterOption> _roleTabs = [];

    protected override async Task OnInitializedAsync()
    {
        var roles = await ApiClient.GetAsync<List<RoleResponse>>(ApiRoutes.Roles.Base);
        var names = roles.IsSuccessful && roles.ResultData is not null ? roles.ResultData.Select(r => r.Name).Order().ToList() : [];
        _roleTabs = [new(string.Empty, "Everyone", Icons.Material.Outlined.Groups), .. names.Select(name => new ListFilterOption(name, name))];
    }

    private string? RoleQuery() => _role.Length == 0 ? null : $"&role={Uri.EscapeDataString(_role)}";

    private async Task OnRoleChanged(string role)
    {
        _role = role;
        await ReloadAsync(refilter: true);
    }

    private Task ReloadAsync(bool refilter = false) =>
        _table is null ? Task.CompletedTask : refilter ? _table.RefilterAsync() : _table.ReloadAsync();

    private Task EditAsync(UserResponse user) =>
        DialogService.ShowAndReloadAsync("Edit User", new DialogParameters<EditUserDialog> { { x => x.User, user } }, () => ReloadAsync());

    private Task ManageRolesAsync(UserResponse user) =>
        DialogService.ShowAndReloadAsync("Edit Roles", new DialogParameters<UserRolesDialog> { { x => x.User, user } }, () => ReloadAsync());

    private async Task ToggleActiveAsync(UserResponse user)
    {
        if (user.Links.Find(LinkRels.Edit) is not { } edit)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(edit,
            new { firstName = user.FirstName, lastName = user.LastName, isActive = !user.IsActive });

        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await ReloadAsync();
    }

    private async Task DeleteAsync(UserResponse user)
    {
        if (!await DialogService.ConfirmDeleteAsync("user", $"{user.FirstName} {user.LastName}"))
        {
            return;
        }

        if (user.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await ReloadAsync();
    }
}
