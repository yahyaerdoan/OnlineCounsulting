@page "/admin/settings/permissions"
@attribute [Authorize]
@inject IApiClient ApiClient
@inject ISnackbar Snackbar

<PageTitle>Permissions</PageTitle>

<PageHeroBanner Title="Permissions" Subtitle="Control access levels and assign permissions per role." />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<MudPaper Elevation="0" Outlined="true" Class="mt-2 pa-4">
    <MudStack Row="true" Class="mb-2">
        <MudSpacer />
        <MudTextField T="string" ValueChanged="@(v => _filter = v)" Immediate="true" DebounceInterval="300" Margin="Margin.Dense"
                      Placeholder="Search modules" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" />
    </MudStack>

    @foreach (var (module, permissions) in _catalog.Where(m => m.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase)))
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-2">
            <MudText Typo="Typo.h6">@module</MudText>
            <MudTable Items="_roles" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Role</MudTh>
                    @foreach (var permission in permissions)
                    {
                        <MudTh Style="text-align:center;">@ActionLabel(permission)</MudTh>
                    }
                </HeaderContent>
                <RowTemplate Context="role">
                    <MudTd DataLabel="Role">@role.RoleName</MudTd>
                    @foreach (var permission in permissions)
                    {
                        <MudTd DataLabel="@ActionLabel(permission)" Style="text-align:center;">
                            <MudStack Row="true" Justify="Justify.Center">
                                <MudCheckBox T="bool" Value="@role.Assigned.Contains(permission)"
                                             ValueChanged="@(v => ToggleAsync(role, permission, v))"
                                             Dense="true" Color="Color.Primary" Class="ma-0" />
                            </MudStack>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
</MudPaper>

@code {
    private Dictionary<string, string[]> _catalog = [];
    private List<RoleRow> _roles = [];
    private string _filter = string.Empty;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        var catalogResult = await ApiClient.GetAsync<Dictionary<string, string[]>>(ApiRoutes.Permissions.All);
        var rolesResult = await ApiClient.GetAsync<List<RolePermissionsResponse>>(ApiRoutes.Roles.PermissionsMatrix);

        if (!catalogResult.IsSuccessful || catalogResult.ResultData is null || !rolesResult.IsSuccessful || rolesResult.ResultData is null)
        {
            _loadError = !catalogResult.IsSuccessful ? catalogResult.DisplayMessage : rolesResult.DisplayMessage;
            return;
        }

        _catalog = catalogResult.ResultData;
        _roles = [.. rolesResult.ResultData.Select(r => new RoleRow(r.RoleId, r.RoleName, [.. r.Permissions]))];
    }

    /// <summary>Permission strings are "module.action" - just the action reads well as a column header.</summary>
    private static string ActionLabel(string permission)
    {
        var action = permission.Contains('.') ? permission[(permission.LastIndexOf('.') + 1)..] : permission;
        return action.Length == 0 ? action : char.ToUpperInvariant(action[0]) + action[1..];
    }

    private async Task ToggleAsync(RoleRow role, string permission, bool isAssigned)
    {
        if (isAssigned)
        {
            _ = role.Assigned.Add(permission);
        }
        else
        {
            _ = role.Assigned.Remove(permission);
        }

        var result = await ApiClient.PutAsync(ApiRoutes.Roles.Permissions(role.RoleId), new { permissions = role.Assigned.ToArray() });
        if (!result.IsSuccessful)
        {
            // Revert the optimistic toggle - the server never applied it.
            if (isAssigned)
            {
                _ = role.Assigned.Remove(permission);
            }
            else
            {
                _ = role.Assigned.Add(permission);
            }

            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
    }

    private sealed record RoleRow(Guid RoleId, string RoleName, HashSet<string> Assigned);
}
