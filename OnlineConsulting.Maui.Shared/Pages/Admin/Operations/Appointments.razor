@page "/admin/operations/appointments"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Appointments</PageTitle>

<PageHeroBanner Title="Appointments" Subtitle="Dispatch board for scheduled service appointments." />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="AppointmentResponse" @ref="_table" ApiBasePath="@ApiRoutes.Operations.Appointments.All"
                 SearchPlaceholder="Search status" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh>Customer</MudTh>
        <MudTh>Service</MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(AppointmentResponse.ScheduledStart)" T="AppointmentResponse">Scheduled</MudTableSortLabel></MudTh>
        <MudTh>Where</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Technician</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="appointment">
        <MudTd DataLabel="Customer"><PersonCell Name="@(appointment.CustomerName ?? string.Empty)" Secondary="@appointment.CustomerEmail" /></MudTd>
        <MudTd DataLabel="Service">@(appointment.ServiceTitle ?? "-")</MudTd>
        <MudTd DataLabel="Scheduled">@BusinessTime.FormatDateTime(appointment.ScheduledStart)</MudTd>
        <MudTd DataLabel="Where">
            <span class="appointment-where">
                <MudIcon Icon="@(appointment.IsOnline ? Icons.Material.Outlined.VideoCall : Icons.Material.Outlined.LocationOn)" Size="Size.Small" />
                <span>@(appointment.IsOnline ? $"Online: {appointment.Topic}" : appointment.ServiceAddress ?? "-")</span>
            </span>
        </MudTd>
        <MudTd DataLabel="Status">@appointment.Status</MudTd>
        <MudTd DataLabel="Technician">@(appointment.AssignedTechnicianUserId is not null ? "Assigned" : "Unassigned")</MudTd>
        <MudTd DataLabel="Actions">
            <RowActions Actions="@([
                new RowAction("Confirm", Icons.Material.Outlined.Check) { OnClick = () => ConfirmAsync(appointment), Disabled = !appointment.Can(LinkRels.Confirm), Color = Color.Success },
                new RowAction("Cancel", Icons.Material.Outlined.Close) { OnClick = () => CancelAsync(appointment), Disabled = !appointment.Can(LinkRels.Cancel), Color = Color.Error },
                new RowAction("Assign technician", Icons.Material.Outlined.PersonAdd) { OnClick = () => AssignTechnicianAsync(appointment), Disabled = !appointment.Can(LinkRels.AssignTechnician) },
                new RowAction("Record work order", Icons.Material.Outlined.Build) { Href = RecordWorkOrderUrl(appointment), Disabled = appointment.AssignedTechnicianUserId is null || !appointment.Can(LinkRels.RecordWorkOrder) },
                new RowAction("View work order", Icons.Material.Outlined.Description) { Href = WorkOrderUrl(appointment), Visible = appointment.Can(LinkRels.WorkOrder) },
            ])" />
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<AppointmentResponse> _table = default!;
    private string? _loadError;

    private async Task ConfirmAsync(AppointmentResponse appointment)
    {
        if (appointment.Links.Find(LinkRels.Confirm) is not { } confirm)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(confirm, new { });
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }

    private Task CancelAsync(AppointmentResponse appointment) =>
        DialogService.ShowAndReloadAsync("Cancel Appointment", new DialogParameters<CancelAppointmentDialog> { { x => x.CancelLink, appointment.Links.Find(LinkRels.Cancel) } }, _table.ReloadAsync);

    private Task AssignTechnicianAsync(AppointmentResponse appointment) =>
        DialogService.ShowAndReloadAsync("Assign Technician", new DialogParameters<AssignTechnicianDialog> { { x => x.AssignLink, appointment.Links.Find(LinkRels.AssignTechnician) } }, _table.ReloadAsync);

    private static string RecordWorkOrderUrl(AppointmentResponse appointment) =>
        $"{AppRoutes.AdminHome}/operations/appointments/{appointment.Id}/record-work-order";

    private static string WorkOrderUrl(AppointmentResponse appointment) =>
        $"{AppRoutes.AdminHome}/operations/appointments/{appointment.Id}/work-order";
}
