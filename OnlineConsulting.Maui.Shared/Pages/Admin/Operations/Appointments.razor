@page "/admin/operations/appointments"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Appointments</PageTitle>

<PageHeroBanner Title="Appointments" Subtitle="Dispatch board for scheduled service appointments." />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="AppointmentResponse" @ref="_table" ApiBasePath="@ApiRoutes.Operations.Appointments.All"
                 SearchPlaceholder="Search status" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@nameof(AppointmentResponse.ScheduledStart)" T="AppointmentResponse">Scheduled</MudTableSortLabel></MudTh>
        <MudTh>Where</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Technician</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="appointment">
        <MudTd DataLabel="Scheduled" Class="cell-primary">@DateTimeFormat.FormatDateTime(appointment.ScheduledStart)</MudTd>
        <MudTd DataLabel="Where">
            <span class="appointment-where">
                <MudIcon Icon="@(appointment.IsOnline ? Icons.Material.Outlined.VideoCall : Icons.Material.Outlined.LocationOn)" Size="Size.Small" />
                <span>@(appointment.IsOnline ? $"Online: {appointment.Topic}" : appointment.ServiceAddress ?? "-")</span>
            </span>
        </MudTd>
        <MudTd DataLabel="Status">@appointment.Status</MudTd>
        <MudTd DataLabel="Technician">@(appointment.AssignedTechnicianUserId is not null ? "Assigned" : "Unassigned")</MudTd>
        <MudTd DataLabel="Actions">
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                <MudTooltip Text="Confirm">
                    <MudIconButton aria-label="Confirm" Icon="@Icons.Material.Outlined.Check" Color="Color.Success" Size="Size.Small"
                                   Disabled="@(appointment.Status != "Pending")" OnClick="@(() => ConfirmAsync(appointment))" />
                </MudTooltip>
                <MudTooltip Text="Cancel">
                    <MudIconButton aria-label="Cancel" Icon="@Icons.Material.Outlined.Close" Color="Color.Error" Size="Size.Small"
                                   Disabled="@(!IsOpen(appointment))" OnClick="@(() => CancelAsync(appointment))" />
                </MudTooltip>
                <MudTooltip Text="Assign technician">
                    <MudIconButton aria-label="Assign technician" Icon="@Icons.Material.Outlined.PersonAdd" Color="Color.Default" Size="Size.Small"
                                   Disabled="@(!IsOpen(appointment))" OnClick="@(() => AssignTechnicianAsync(appointment))" />
                </MudTooltip>
                <MudTooltip Text="Record work order">
                    <MudIconButton aria-label="Record work order" Icon="@Icons.Material.Outlined.Build" Color="Color.Default" Size="Size.Small"
                                   Disabled="@(appointment.AssignedTechnicianUserId is null || !IsOpen(appointment))" OnClick="@(() => RecordWorkOrderAsync(appointment))" />
                </MudTooltip>
                @if (appointment.Status == "Completed")
                {
                    <MudTooltip Text="View work order">
                        <MudIconButton aria-label="View work order" Icon="@Icons.Material.Outlined.Description" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => ViewWorkOrderAsync(appointment))" />
                    </MudTooltip>
                }
            </MudButtonGroup>
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<AppointmentResponse> _table = default!;
    private string? _loadError;

    private async Task ConfirmAsync(AppointmentResponse appointment)
    {
        var result = await ApiClient.PostAsync(ApiRoutes.Operations.Appointments.Confirm(appointment.Id), new { });
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }

    private static bool IsOpen(AppointmentResponse appointment) => appointment.Status is "Pending" or "Confirmed";

    private Task CancelAsync(AppointmentResponse appointment) =>
        DialogService.ShowAndReloadAsync("Cancel Appointment", new DialogParameters<CancelAppointmentDialog> { { x => x.AppointmentId, appointment.Id } }, _table.ReloadAsync);

    private Task AssignTechnicianAsync(AppointmentResponse appointment) =>
        DialogService.ShowAndReloadAsync("Assign Technician", new DialogParameters<AssignTechnicianDialog> { { x => x.Appointment, appointment } }, _table.ReloadAsync);

    private void RecordWorkOrderAsync(AppointmentResponse appointment) =>
        Navigation.NavigateTo($"{AppRoutes.AdminHome}/operations/appointments/{appointment.Id}/record-work-order");

    private void ViewWorkOrderAsync(AppointmentResponse appointment) =>
        Navigation.NavigateTo($"{AppRoutes.AdminHome}/operations/appointments/{appointment.Id}/work-order");
}
