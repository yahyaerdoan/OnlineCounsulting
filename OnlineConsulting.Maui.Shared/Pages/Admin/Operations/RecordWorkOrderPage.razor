@page "/admin/operations/appointments/{AppointmentId:guid}/record-work-order"
@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Operations
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.Operations.OperationsModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<RecordWorkOrderFormModel> Form

<PageTitle>Record Work Order</PageTitle>

<PageHeroBanner Title="Record Work Order" Subtitle="Complete this appointment and capture the technician's work.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/operations/appointments"))">Back to Appointments</MudButton>
    </ActionContent>
</PageHeroBanner>
<PageBreadcrumbExtra Text="Record Work Order" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <EditForm EditContext="@Form.EditContext">
        <MudPaper Class="pa-4">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <UserPicker Label="Technician" Required="true" Value="@_model.TechnicianUserId" ValueChanged="@((Guid? id) => _model.TechnicianUserId = id ?? Guid.Empty)" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Equipment</MudText>
                    <MudRadioGroup T="string" @bind-Value="_model.EquipmentMode">
                        <MudRadio T="string" Value="@ExistingMode" Color="Color.Primary" Dense="true">Use existing equipment on file</MudRadio>
                        <MudRadio T="string" Value="@NewMode" Color="Color.Primary" Dense="true">Record new equipment</MudRadio>
                    </MudRadioGroup>
                </MudItem>

                @if (_model.EquipmentMode == ExistingMode)
                {
                    <MudItem xs="12" md="6">
                        <MudSelect T="Guid?" @bind-Value="_model.EquipmentId" Label="Existing equipment" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            @foreach (var item in _existingEquipment)
                            {
                                <MudSelectItem T="Guid?" Value="@item.Id">@($"{item.Type} - {item.Brand} {item.Model}")</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.NewEquipmentType" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.NewEquipmentSerialNumber" Label="Serial Number" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.NewEquipmentBrand" Label="Brand" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.NewEquipmentModel" Label="Model" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.PartsUsed" Label="Parts used" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="1" MaxLines="3" Sizing="InputSizing.Auto" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.TechnicianNotes" Label="Technician notes" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="1" MaxLines="5" Sizing="InputSizing.Auto" />
                </MudItem>

                <MudItem xs="12">
                    <div class="charges">
                        <div class="charges-head">
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="text-strong">Charges for the invoice</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">The customer gets an invoice with these lines and can pay online. Remove every line for warranty or no-charge visits.</MudText>
                            </div>
                        </div>

                        @foreach (var charge in _charges)
                        {
                            <div class="charge-row" @key="charge">
                                <MudTextField @bind-Value="charge.Description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="charge-desc" />
                                <MudNumericField T="decimal" @bind-Value="charge.Quantity" Label="Qty" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Step="1" Immediate="true" Class="charge-qty" />
                                <MudNumericField T="decimal" @bind-Value="charge.UnitPrice" Label="Unit price" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Immediate="true"
                                                 Adornment="Adornment.Start" AdornmentText="$" Class="charge-price" />
                                <MudNumericField T="int" @bind-Value="charge.TaxRate" Label="Tax %" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="100" Immediate="true" Class="charge-tax" />
                                <span class="charge-total">@CurrencyFormat.Format(charge.Quantity * charge.UnitPrice)</span>
                                <MudTooltip Text="Remove line">
                                    <MudIconButton aria-label="Remove line" Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => _charges.Remove(charge))" />
                                </MudTooltip>
                            </div>
                        }

                        <div class="charges-foot">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddCharge">Add line</MudButton>
                            @if (_charges.Count > 0)
                            {
                                <span class="charges-estimate">Estimate: <strong>@CurrencyFormat.Format(ChargesEstimate)</strong> incl. tax, before any member discount</span>
                            }
                            else
                            {
                                <span class="charges-estimate">No invoice will be sent for this visit.</span>
                            }
                        </div>
                    </div>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Before photo</MudText>
                    @if (_beforePhotoUrl is not null)
                    {
                        <MudImage Src="@_beforePhotoUrl" Height="88" Class="rounded-lg mb-2" />
                    }
                    <MudFileUpload T="IBrowserFile" OnFilesChanged="@(e => OnPhotoSelectedAsync(e, isBeforePhoto: true))" Accept="image/*" Disabled="_isUploadingBeforePhoto" />
                    @if (_isUploadingBeforePhoto)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
                    }
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">After photo</MudText>
                    @if (_afterPhotoUrl is not null)
                    {
                        <MudImage Src="@_afterPhotoUrl" Height="88" Class="rounded-lg mb-2" />
                    }
                    <MudFileUpload T="IBrowserFile" OnFilesChanged="@(e => OnPhotoSelectedAsync(e, isBeforePhoto: false))" Accept="image/*" Disabled="_isUploadingAfterPhoto" />
                    @if (_isUploadingAfterPhoto)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
                    }
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/operations/appointments"))">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">Complete Appointment</MudButton>
            </MudStack>
        </MudPaper>
    </EditForm>
}

@code {
    private const string ExistingMode = "existing";
    private const string NewMode = "new";

    [Parameter]
    public Guid AppointmentId { get; set; }

    private readonly RecordWorkOrderFormModel _model = new();
    private List<EquipmentItemResponse> _existingEquipment = [];
    private Guid _customerUserId;
    private bool _loading = true;
    private string? _loadError;

    private Guid? _beforePhotoAssetId;
    private Guid? _afterPhotoAssetId;
    private string? _beforePhotoUrl;
    private string? _afterPhotoUrl;
    private bool _isUploadingBeforePhoto;
    private bool _isUploadingAfterPhoto;
    private readonly List<ChargeRow> _charges = [];
    private int _defaultTaxRate;

    private sealed class ChargeRow
    {
        public string Description { get; set; } = "";
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public int TaxRate { get; set; }
    }

    private decimal ChargesEstimate => _charges.Sum(c => c.Quantity * c.UnitPrice * (1 + c.TaxRate / 100m));

    private void AddCharge() => _charges.Add(new ChargeRow { TaxRate = _defaultTaxRate });

    protected override async Task OnInitializedAsync()
    {
        // Bind before any await - Blazor can render (and touch Form.EditContext) after the first yield point.
        Form.Bind(_model);

        var appointmentResult = await ApiClient.GetAsync<AppointmentResponse>(ApiRoutes.Operations.Appointments.ById(AppointmentId));
        if (!appointmentResult.IsSuccessful || appointmentResult.ResultData is null)
        {
            _loadError = appointmentResult.DisplayMessage;
            _loading = false;
            return;
        }

        var appointment = appointmentResult.ResultData;
        _customerUserId = appointment.UserId;

        if (appointment.ServiceId is { } serviceId)
        {
            var serviceResult = await ApiClient.GetAsync<ServiceDetailResponse>(ApiRoutes.Services.ById(serviceId));
            if (serviceResult.IsSuccessful && serviceResult.ResultData is { } service)
            {
                _defaultTaxRate = service.TaxRate;
                _charges.Add(new ChargeRow { Description = service.Title, Quantity = 1, UnitPrice = service.DiscountedPrice, TaxRate = service.TaxRate });
            }
        }
        if (appointment.AssignedTechnicianUserId is { } technicianId)
        {
            _model.TechnicianUserId = technicianId;
        }

        var equipmentResult = await ApiClient.QueryAsync<PaginatedResponse<EquipmentItemResponse>>(
            ApiRoutes.Paged(ApiRoutes.Operations.Equipment.All, 0, 100),
            new DynamicQuery(null, new DynamicFilter(nameof(EquipmentItemResponse.UserId), "eq", _customerUserId.ToString())));
        _existingEquipment = equipmentResult.IsSuccessful && equipmentResult.ResultData is not null ? equipmentResult.ResultData.Items : [];

        // Mirrors the MVC form's checked="@(Model.ExistingEquipment.Count > 0)" default.
        _model.EquipmentMode = _existingEquipment.Count > 0 ? ExistingMode : NewMode;
        if (_existingEquipment.Count > 0)
        {
            _model.EquipmentId = _existingEquipment[0].Id;
        }

        _loading = false;
    }

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e, bool isBeforePhoto)
    {
        if (isBeforePhoto)
        {
            _isUploadingBeforePhoto = true;
        }
        else
        {
            _isUploadingAfterPhoto = true;
        }

        var result = await MediaUploadHelper.UploadAsync(ApiClient, e.File, MediaFolders.WorkOrders);

        _isUploadingBeforePhoto = false;
        _isUploadingAfterPhoto = false;

        if (!result.IsSuccessful || result.ResultData is null)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        if (isBeforePhoto)
        {
            _beforePhotoAssetId = result.ResultData.Id;
            _beforePhotoUrl = result.ResultData.Url;
        }
        else
        {
            _afterPhotoAssetId = result.ResultData.Id;
            _afterPhotoUrl = result.ResultData.Url;
        }
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var body = new
        {
            appointmentId = AppointmentId,
            technicianUserId = _model.TechnicianUserId,
            partsUsed = _model.PartsUsed,
            technicianNotes = _model.TechnicianNotes,
            completedAt = DateTimeOffset.UtcNow,
            equipmentId = _model.EquipmentMode == ExistingMode ? _model.EquipmentId : null,
            newEquipment = _model.EquipmentMode == NewMode
                ? new
                {
                    customerUserId = _customerUserId,
                    type = _model.NewEquipmentType,
                    brand = _model.NewEquipmentBrand,
                    model = _model.NewEquipmentModel,
                    serialNumber = _model.NewEquipmentSerialNumber,
                    installDate = (DateTimeOffset?)null,
                    warrantyExpiresAt = (DateTimeOffset?)null,
                    notes = (string?)null,
                }
                : null,
            charges = _charges
                .Where(c => !string.IsNullOrWhiteSpace(c.Description) && c.Quantity > 0)
                .Select(c => new { description = c.Description.Trim(), quantity = c.Quantity, unitPrice = c.UnitPrice, taxRate = c.TaxRate })
                .ToList(),
        };

        var createResult = await ApiClient.PostAsync<Guid>(ApiRoutes.Operations.WorkOrders.Base, body);
        if (!createResult.IsSuccessful)
        {
            Form.DisplayErrors(createResult, Snackbar);
            return;
        }

        var workOrderId = createResult.ResultData;
        if (_beforePhotoAssetId is { } beforeAssetId)
        {
            await AddMediaItemAsync(workOrderId, beforeAssetId, isBeforePhoto: true);
        }

        if (_afterPhotoAssetId is { } afterAssetId)
        {
            await AddMediaItemAsync(workOrderId, afterAssetId, isBeforePhoto: false);
        }

        Snackbar.ShowSuccess(createResult.DisplayMessage);
        Navigation.NavigateTo(AppRoutes.AdminHome + "/operations/appointments");
    });

    private async Task AddMediaItemAsync(Guid workOrderId, Guid mediaAssetId, bool isBeforePhoto)
    {
        var result = await ApiClient.PostAsync(ApiRoutes.Operations.WorkOrders.AddMediaItem(workOrderId), new { mediaAssetId, isBeforePhoto, displayOrder = 0 });
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
        }
    }
}
