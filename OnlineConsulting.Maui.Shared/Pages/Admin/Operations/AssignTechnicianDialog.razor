@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Operations
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject FormState<AssignTechnicianModel> Form

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Assign Technician</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm EditContext="@Form.EditContext">
            <UserPicker Label="Technician" Required="true" Value="@_model.TechnicianUserId" ValueChanged="@((Guid? id) => _model.TechnicianUserId = id ?? Guid.Empty)" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="AssignAsync" IsBusy="@_isBusy" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public AppointmentResponse Appointment { get; set; } = default!;

    private readonly AssignTechnicianModel _model = new();
    private bool _isBusy;

    protected override void OnInitialized() => Form.Bind(_model);

    private async Task AssignAsync()
    {
        _isBusy = true;

        var result = await ApiClient.PostAsync(ApiRoutes.Operations.Appointments.AssignTechnician(Appointment.Id), new { technicianUserId = _model.TechnicianUserId });

        _isBusy = false;

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private sealed class AssignTechnicianModel
    {
        public Guid TechnicianUserId { get; set; }
    }
}
