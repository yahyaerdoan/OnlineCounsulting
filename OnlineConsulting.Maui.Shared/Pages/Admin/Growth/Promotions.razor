@page "/admin/growth/promotions"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Promotions</PageTitle>

<PageHeroBanner Title="Promotions" Subtitle="Time-limited offers shown on your public site.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/growth/promotions/new"))">New Promotion</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="PromotionResponse" @ref="_table" ApiBasePath="@ApiRoutes.Growth.Promotions.All"
                 SearchPlaceholder="Search title or description" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@nameof(PromotionResponse.Title)" T="PromotionResponse">Title</MudTableSortLabel></MudTh>
        <MudTh>Expires</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="promotion">
        <MudTd DataLabel="Title" Class="cell-primary">@promotion.Title</MudTd>
        <MudTd DataLabel="Expires">@(promotion.ExpiresAt is { } expires ? BusinessTime.FormatDateTime(expires) : "Never")</MudTd>
        <MudTd DataLabel="Actions">
            <RowActions Actions="@([
                new RowAction("Edit", Icons.Material.Outlined.EditNote) { Href = $"{AppRoutes.AdminHome}/growth/promotions/{promotion.Id}/edit", Disabled = !promotion.Can(LinkRels.Edit) },
                new RowAction("Delete", Icons.Material.Outlined.DeleteOutline) { OnClick = () => DeleteAsync(promotion), Disabled = !promotion.Can(LinkRels.Delete), Color = Color.Error },
            ])" />
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<PromotionResponse> _table = default!;
    private string? _loadError;

    private async Task DeleteAsync(PromotionResponse promotion)
    {
        if (!await DialogService.ConfirmDeleteAsync("promotion", promotion.Title))
        {
            return;
        }

        if (promotion.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
