@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Growth
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject FormState<CompleteReferralModel> Form

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Complete Referral</MudText>
    </TitleContent>
    <DialogContent>
        <EntitySummaryHeader Title="@Referral.Code" Subtitle="@($"Referrer: {Referral.ReferrerName ?? Referral.ReferrerEmail}")" />

        <EditForm EditContext="@Form.EditContext">
            <MudNumericField T="decimal" @bind-Value="_model.RewardAmount" For="@(() => _model.RewardAmount)" Label="Reward amount" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.01m" Format="F2" Class="mt-3"
                             Adornment="Adornment.Start" AdornmentText="$" HideSpinButtons="true" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="CompleteAsync" IsBusy="@_isBusy" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public ReferralResponse Referral { get; set; } = default!;

    private readonly CompleteReferralModel _model = new();
    private bool _isBusy;

    protected override void OnInitialized() => Form.Bind(_model);

    private async Task CompleteAsync()
    {
        _isBusy = true;

        var result = await ApiClient.PostAsync(ApiRoutes.Growth.Referrals.Complete(Referral.Id), new { rewardAmount = _model.RewardAmount });

        _isBusy = false;

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private sealed class CompleteReferralModel
    {
        public decimal RewardAmount { get; set; } = 10m;
    }
}
