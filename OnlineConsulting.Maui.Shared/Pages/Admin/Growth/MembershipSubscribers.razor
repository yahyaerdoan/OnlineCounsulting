@* Who is enrolled in which plan: member, plan and price, state (including "ends on" for pending cancellations), dates and actions.
   Tabs narrow by state; search matches member name or email, plan or status on the server. A pending cancellation can be undone here. *@
@page "/admin/growth/membership-subscribers"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject NavigationManager Navigation
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Membership Subscribers</PageTitle>

<PageHeroBanner Title="Membership Subscribers" Subtitle="Everyone enrolled in a membership plan.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/growth/memberships"))">Back to Plans</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ListFilterTabs Options="ViewTabs" Selected="@_view" SelectedChanged="OnViewChanged" Label="Filter by membership state" />

<ServerDataTable TItem="CustomerMembershipResponse" @ref="_table" ApiBasePath="@ApiRoutes.Growth.CustomerMemberships.All" ServerSearch="true"
                 ExtraQuery="ViewQuery" SearchPlaceholder="Search member, email or plan" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh>Member</MudTh>
        <MudTh>Plan</MudTh>
        <MudTh>Status</MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(CustomerMembershipResponse.StartDate)" T="CustomerMembershipResponse">Member Since</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(CustomerMembershipResponse.RenewalDate)" T="CustomerMembershipResponse">Renews / Ends</MudTableSortLabel></MudTh>
        <MudTh Class="cell-actions">Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="membership">
        <MudTd Class="cell-primary">
            <PersonCell Name="@(membership.MemberName ?? "Deleted user")" Secondary="@membership.MemberEmail" />
        </MudTd>
        <MudTd DataLabel="Plan">
            <span class="cell-stack">
                <span class="cell-strong">@(membership.PlanName ?? "Unknown plan")</span>
                @if (membership.PlanPrice is { } price)
                {
                    <span class="cell-muted">@CurrencyFormat.Format(price)@CycleSuffix(membership.PlanBillingCycle)</span>
                }
            </span>
        </MudTd>
        <MudTd DataLabel="Status"><StatusBadge Label="@StatusLabel(membership)" Kind="@StatusKind(membership)" /></MudTd>
        <MudTd DataLabel="Member Since">@BusinessTime.FormatDate(membership.StartDate)</MudTd>
        <MudTd DataLabel="@(membership.IsEnding || membership.Status == "Cancelled" ? "Ends" : "Renews")">
            @(membership.RenewalDate is { } renewal ? BusinessTime.FormatDate(renewal) : "-")
        </MudTd>
        <MudTd DataLabel="Actions" Class="cell-actions">
            @if (membership.Can(LinkRels.Reactivate))
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Outlined.Replay"
                           OnClick="@(() => ReactivateAsync(membership))">Keep active</MudButton>
            }
            <MudTooltip Text="Cancel now">
                <MudIconButton Icon="@Icons.Material.Outlined.Cancel" Color="Color.Error" Size="Size.Small" aria-label="Cancel now"
                               Disabled="@(!membership.Can(LinkRels.Cancel))" OnClick="@(() => CancelAsync(membership))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Color="Color.Secondary">No memberships match this view.</MudText>
    </NoRecordsContent>
</ServerDataTable>

@code {
    private static readonly List<ListFilterOption> ViewTabs =
    [
        new(string.Empty, "All", Icons.Material.Outlined.WorkspacePremium),
        new("Active", "Active"),
        new("Ending", "Ending soon"),
        new("NeedsAttention", "Needs attention"),
        new("Paused", "Paused"),
        new("Cancelled", "Cancelled"),
    ];

    private ServerDataTable<CustomerMembershipResponse>? _table;
    private string? _loadError;
    private string _view = string.Empty;

    private string? ViewQuery() => _view.Length == 0 ? null : $"&view={Uri.EscapeDataString(_view)}";

    private async Task OnViewChanged(string view)
    {
        _view = view;
        await ReloadAsync(refilter: true);
    }

    private Task ReloadAsync(bool refilter = false) =>
        _table is null ? Task.CompletedTask : refilter ? _table.RefilterAsync() : _table.ReloadAsync();

    private static string CycleSuffix(string? cycle) => cycle switch
    {
        "Monthly" => "/mo",
        "Annual" => "/yr",
        _ => string.Empty,
    };

    private static string StatusLabel(CustomerMembershipResponse membership) => membership switch
    {
        { IsEnding: true } => "Ending",
        { Status: "Active", TrialEndDate: { } trialEnd } when trialEnd > DateTimeOffset.UtcNow => "Free trial",
        { Status: "PastDue" } => "Payment due",
        { Status: "PendingPayment" } => "Pending payment",
        { Status: "Failed" } => "Setup failed",
        _ => membership.Status,
    };

    private static string StatusKind(CustomerMembershipResponse membership) => membership switch
    {
        { IsEnding: true } => StatusKinds.Warning,
        { Status: "Active", TrialEndDate: { } trialEnd } when trialEnd > DateTimeOffset.UtcNow => StatusKinds.Info,
        { Status: "Active" } => StatusKinds.Success,
        { Status: "Paused" } => StatusKinds.Info,
        { Status: "PastDue" or "Failed" } => StatusKinds.Danger,
        { Status: "PendingPayment" } => StatusKinds.Warning,
        _ => StatusKinds.Neutral,
    };

    private async Task ReactivateAsync(CustomerMembershipResponse membership)
    {
        var who = membership.MemberName ?? "this customer";
        if (!await DialogService.ConfirmAsync("Keep Membership Active", $"Undo {who}'s cancellation? The membership will renew as usual on its next billing date."))
        {
            return;
        }

        await RunAsync(membership.Links.Find(LinkRels.Reactivate));
    }

    private async Task CancelAsync(CustomerMembershipResponse membership)
    {
        var who = membership.MemberName ?? "this customer";
        if (!await DialogService.ConfirmAsync("Cancel Membership", $"Cancel {who}'s membership immediately? Billing stops now and this can't be undone; they would need to subscribe again."))
        {
            return;
        }

        await RunAsync(membership.Links.Find(LinkRels.Cancel));
    }

    private async Task RunAsync(HalLink? link)
    {
        if (link is null)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(link, new { });
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await ReloadAsync();
    }
}
