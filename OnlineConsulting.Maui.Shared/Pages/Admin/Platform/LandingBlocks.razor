@page "/admin/platform/landing-blocks"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@using OnlineConsulting.Maui.Shared.Infrastructure.Icons
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Landing Blocks</PageTitle>

<PageHeroBanner Title="Landing Blocks" Subtitle="Feature cards, how-it-works steps and FAQ entries on the platform's home page.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Article"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/platform/landing-page"))">Landing Page</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/platform/landing-blocks/new"))">New Block</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="LandingBlockResponse" @ref="_table" ApiBasePath="@ApiRoutes.SiteContent.LandingBlocks.All"
                 SearchPlaceholder="Search title or text" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@nameof(LandingBlockResponse.Section)" T="LandingBlockResponse">Section</MudTableSortLabel></MudTh>
        <MudTh>Icon</MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(LandingBlockResponse.Title)" T="LandingBlockResponse">Title</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(LandingBlockResponse.DisplayOrder)" T="LandingBlockResponse">Order</MudTableSortLabel></MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="block">
        <MudTd DataLabel="Section">@LandingSections.Label(block.Section)</MudTd>
        <MudTd DataLabel="Icon">
            @if (!string.IsNullOrWhiteSpace(block.Icon))
            {
                <MudIcon Icon="@IconCatalog.Resolve(block.Icon)" Size="Size.Small" />
            }
        </MudTd>
        <MudTd DataLabel="Title" Class="cell-primary">@block.Title</MudTd>
        <MudTd DataLabel="Order">@block.DisplayOrder</MudTd>
        <MudTd DataLabel="Actions">
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                <MudTooltip Text="Edit">
                    <MudIconButton Disabled="@(!block.Can(LinkRels.Edit))" aria-label="Edit" Icon="@Icons.Material.Outlined.EditNote" Color="Color.Default"
                                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + $"/platform/landing-blocks/{block.Id}/edit"))" />
                </MudTooltip>

                <MudTooltip Text="Delete">
                    <MudIconButton Disabled="@(!block.Can(LinkRels.Delete))" aria-label="Delete" Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error"
                                   OnClick="@(() => DeleteAsync(block))" />
                </MudTooltip>
            </MudButtonGroup>
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<LandingBlockResponse>? _table;
    private string? _loadError;

    private async Task DeleteAsync(LandingBlockResponse block)
    {
        if (!await DialogService.ConfirmDeleteAsync("landing block", block.Title))
        {
            return;
        }

        if (block.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        if (_table is not null)
        {
            await _table.ReloadAsync();
        }
    }
}
