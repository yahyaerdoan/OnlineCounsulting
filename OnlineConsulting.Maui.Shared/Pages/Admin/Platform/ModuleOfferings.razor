@page "/admin/platform/module-offerings"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Module Offerings</PageTitle>

<PageHeroBanner Title="Module Offerings" Subtitle="The modules tenants can subscribe to.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Sync"
                   Disabled="@_syncing" OnClick="SyncPricesAsync">Sync Prices</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Navigation.NavigateTo($"{AppRoutes.AdminHome}/platform/module-offerings/new"))">New Module Offering</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <SearchableTable TItem="ModuleOfferingResponse" Items="@_offerings" SearchPlaceholder="Search module offerings"
                      Filter="@((offering, text) => offering.Name.Contains(text, StringComparison.OrdinalIgnoreCase) || offering.Key.Contains(text, StringComparison.OrdinalIgnoreCase))">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh Class="mud-table-cell-align-right">Price</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="offering">
            <MudTd DataLabel="Name" Class="cell-primary">@offering.Name</MudTd>
            <MudTd DataLabel="Price" Class="mud-table-cell-align-right">@CurrencyFormat.Format(offering.Price)</MudTd>
            <MudTd DataLabel="Actions">
                <RowActions Actions="@([
                    new RowAction("Edit", Icons.Material.Outlined.EditNote) { Href = $"{AppRoutes.AdminHome}/platform/module-offerings/{offering.Id}/edit", Disabled = !offering.Can(LinkRels.Edit) },
                ])" />
            </MudTd>
        </RowTemplate>
    </SearchableTable>
}

@code {
    private List<ModuleOfferingResponse> _offerings = [];
    private bool _loading = true;
    private string? _loadError;
    private bool _syncing;

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiClient.GetAsync<PaginatedResponse<ModuleOfferingResponse>>(ApiRoutes.Paged(ApiRoutes.Platform.ModuleOfferings.All, 0, int.MaxValue));
        if (!result.IsSuccessful || result.ResultData is null)
        {
            _loadError = result.DisplayMessage;
            _offerings = [];
        }
        else
        {
            _offerings = result.ResultData.Items;
        }

        _loading = false;
    }

    private async Task SyncPricesAsync()
    {
        _syncing = true;
        var result = await ApiClient.PostAsync(ApiRoutes.Platform.ModuleOfferings.SyncPrices, null);
        _syncing = false;

        if (result.IsSuccessful)
        {
            Snackbar.ShowSuccess(result.DisplayMessage);
        }
        else
        {
            Snackbar.ShowError(result.DisplayMessage);
        }
    }
}
