@* Platform landing copy: one form, saved as a single row. Lists (features, steps, FAQ) live on the Landing Blocks page. *@
@page "/admin/platform/landing-page"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.Platform.LandingPageModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<LandingPageFormModel> Form

<PageTitle>Landing Page</PageTitle>

<PageHeroBanner Title="Landing Page" Subtitle="Headlines and buttons on the platform's home page.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ViewAgenda"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/platform/landing-blocks"))">Landing Blocks</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.OpenInNew" Href="/" Target="_blank">View page</MudButton>
    </ActionContent>
</PageHeroBanner>

<EditForm EditContext="@Form.EditContext">
    <MudPaper Class="pa-4">
        <MudStack Spacing="4">
            <MudText Typo="Typo.subtitle1" Class="text-strong">Hero</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.HeroEyebrow" For="@(() => _model.HeroEyebrow)" Label="Eyebrow" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="8"><MudTextField @bind-Value="_model.HeroTitle" For="@(() => _model.HeroTitle)" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_model.HeroLead" For="@(() => _model.HeroLead)" Label="Lead" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" MaxLines="4" Sizing="InputSizing.Auto" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.PrimaryCtaText" For="@(() => _model.PrimaryCtaText)" Label="Primary button (to Pricing)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_model.SecondaryCtaText" For="@(() => _model.SecondaryCtaText)" Label="Secondary button (to Contact)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                @* Pictures are optional; a hero with one turns into text beside the picture. *@
                <MudItem xs="12"><LandingImageField @bind-Value="_model.HeroImageUrl" /></MudItem>
            </MudGrid>

            <LandingSectionFields Heading="Features" @bind-Eyebrow="_model.FeaturesEyebrow" @bind-Title="_model.FeaturesTitle" @bind-Lead="_model.FeaturesLead"
                                  EyebrowFor="@(() => _model.FeaturesEyebrow)" TitleFor="@(() => _model.FeaturesTitle)" LeadFor="@(() => _model.FeaturesLead)" />
            <LandingImageField @bind-Value="_model.FeaturesHeroImageUrl" />

            <LandingSectionFields Heading="Industries (cards come from Categories; leave the title empty to hide)" @bind-Eyebrow="_model.IndustriesEyebrow" @bind-Title="_model.IndustriesTitle" @bind-Lead="_model.IndustriesLead"
                                  EyebrowFor="@(() => _model.IndustriesEyebrow)" TitleFor="@(() => _model.IndustriesTitle)" LeadFor="@(() => _model.IndustriesLead)" />
            <LandingImageField @bind-Value="_model.IndustriesHeroImageUrl" />

            <LandingSectionFields Heading="How it works" @bind-Eyebrow="_model.StepsEyebrow" @bind-Title="_model.StepsTitle" @bind-Lead="_model.StepsLead"
                                  EyebrowFor="@(() => _model.StepsEyebrow)" TitleFor="@(() => _model.StepsTitle)" LeadFor="@(() => _model.StepsLead)" />

            <LandingSectionFields Heading="Pricing" @bind-Eyebrow="_model.PricingEyebrow" @bind-Title="_model.PricingTitle" @bind-Lead="_model.PricingLead"
                                  EyebrowFor="@(() => _model.PricingEyebrow)" TitleFor="@(() => _model.PricingTitle)" LeadFor="@(() => _model.PricingLead)" />

            <MudText Typo="Typo.subtitle1" Class="text-strong">FAQ</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_model.FaqEyebrow" For="@(() => _model.FaqEyebrow)" Label="Eyebrow" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="8"><MudTextField @bind-Value="_model.FaqTitle" For="@(() => _model.FaqTitle)" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            </MudGrid>

            <LandingSectionFields Heading="About page hero (leave the title empty to keep the plain banner)" @bind-Eyebrow="_model.AboutHeroEyebrow" @bind-Title="_model.AboutHeroTitle" @bind-Lead="_model.AboutHeroLead"
                                  EyebrowFor="@(() => _model.AboutHeroEyebrow)" TitleFor="@(() => _model.AboutHeroTitle)" LeadFor="@(() => _model.AboutHeroLead)" />
            <LandingImageField @bind-Value="_model.AboutHeroImageUrl" />

            <LandingSectionFields Heading="Contact page hero (leave the title empty to keep the plain banner)" @bind-Eyebrow="_model.ContactHeroEyebrow" @bind-Title="_model.ContactHeroTitle" @bind-Lead="_model.ContactHeroLead"
                                  EyebrowFor="@(() => _model.ContactHeroEyebrow)" TitleFor="@(() => _model.ContactHeroTitle)" LeadFor="@(() => _model.ContactHeroLead)" />
            <LandingImageField @bind-Value="_model.ContactHeroImageUrl" />

            <MudText Typo="Typo.subtitle1" Class="text-strong">Closing call to action</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12"><MudTextField @bind-Value="_model.ClosingTitle" For="@(() => _model.ClosingTitle)" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_model.ClosingLead" For="@(() => _model.ClosingLead)" Label="Lead" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="1" MaxLines="3" Sizing="InputSizing.Auto" /></MudItem>
            </MudGrid>
        </MudStack>

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">Save</MudButton>
        </MudStack>
    </MudPaper>
</EditForm>

@code {
    private readonly LandingPageFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        // Bind before any await - Blazor can render (and touch Form.EditContext) after the first yield point.
        Form.Bind(_model);

        // NotFound just means nothing is saved yet; the form starts empty.
        var result = await ApiClient.GetAsync<LandingPageResponse>(ApiRoutes.SiteContent.LandingPage.Base);
        if (result.IsSuccessful && result.ResultData is { } page)
        {
            _model.Load(page);
        }
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var result = await ApiClient.PutAsync(ApiRoutes.SiteContent.LandingPage.Base, _model);
        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
    });
}
