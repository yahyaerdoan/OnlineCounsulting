@* Inline editor for one card, step or FAQ entry, opened in place inside its landing section. *@
@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Platform
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Infrastructure.Icons
@using OnlineConsulting.Maui.Shared.Pages.Admin.Platform.LandingBlockModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject FormState<LandingBlockFormModel> Form

<CascadingValue Value="@Form.EditContext">
    <MudPaper Outlined="true" Class="pa-3 rounded-lg">
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_model.Title" For="@(() => _model.Title)" Label="@(IsFaq ? "Question" : "Title")" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="1" Sizing="InputSizing.Auto" AutoFocus="true" />
            <MudTextField @bind-Value="_model.Body" For="@(() => _model.Body)" Label="@(IsFaq ? "Answer" : "Text")" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="2" Sizing="InputSizing.Auto" />
            @if (!IsFaq)
            {
                <IconPicker @bind-Value="_model.Icon" For="@(() => _model.Icon)" />
            }
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OnCancel" Disabled="@Form.IsBusy">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveAsync" Disabled="@Form.IsBusy">@(Block is null ? "Add" : "Save")</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</CascadingValue>

@code {
    [Parameter, EditorRequired] public string Section { get; set; } = string.Empty;

    /// <summary>Null when adding a new entry.</summary>
    [Parameter] public LandingBlockResponse? Block { get; set; }

    /// <summary>Order given to a new entry, so it lands at the end.</summary>
    [Parameter] public int NextOrder { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly LandingBlockFormModel _model = new();

    private bool IsFaq => Section == LandingSections.Faq;

    protected override void OnInitialized()
    {
        Form.Bind(_model);

        _model.Section = Section;
        _model.DisplayOrder = Block?.DisplayOrder ?? NextOrder;

        if (Block is { } block)
        {
            _model.Title = block.Title;
            _model.Body = block.Body;
            _model.Icon = string.IsNullOrWhiteSpace(block.Icon) ? null : IconCatalog.Resolve(block.Icon);
        }
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var body = new
        {
            section = _model.Section,
            title = _model.Title,
            body = _model.Body,
            icon = IsFaq ? null : _model.Icon,
            displayOrder = _model.DisplayOrder,
        };

        var result = Block is { } block
            ? await ApiClient.PutAsync(ApiRoutes.SiteContent.LandingBlocks.ById(block.Id), body)
            : await ApiClient.PostAsync(ApiRoutes.SiteContent.LandingBlocks.Base, body);

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await OnSaved.InvokeAsync();
    });
}
