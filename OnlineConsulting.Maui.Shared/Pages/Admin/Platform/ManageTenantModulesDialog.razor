@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Platform
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Manage Modules - @Tenant.Name</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_allOfferings.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No modules are available right now.</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Added modules are charged now for the rest of the billing period. Removed modules stay active until the period ends.</MudText>
            <MudStack Spacing="0" Class="module-toggle-list">
                @foreach (var offering in _allOfferings)
                {
                    var renews = _activeModuleKeys.Contains(offering.Key) && !_endingModules.ContainsKey(offering.Key);
                    <div class="module-toggle-row">
                        <MudIcon Icon="@ModuleOfferingDisplay.Icon(offering)" Color="Color.Primary" Size="Size.Small" />
                        <div class="module-toggle-text">
                            <MudText Typo="Typo.body1" Class="text-strong">@offering.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@CurrencyFormat.Format(offering.Price) / @ModuleOfferingDisplay.CycleLabel(offering)</MudText>
                            @if (_endingModules.TryGetValue(offering.Key, out var endsAt))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning">Active until @BusinessTime.FormatDate(AsUtc(endsAt))</MudText>
                            }
                        </div>
                        <MudSwitch T="bool" Value="@renews" ValueChanged="@(on => ToggleModuleAsync(offering, on))" Color="Color.Primary"
                                   Disabled="@(_togglingKey is not null)" aria-label="@offering.Name" />
                    </div>
                }
            </MudStack>
        }
        <ApiErrorAlert Message="@_error" Severity="Severity.Error" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close(DialogResult.Ok(true)))">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public TenantResponse Tenant { get; set; } = default!;

    private List<PublicModuleOfferingResponse> _allOfferings = [];
    private HashSet<string> _activeModuleKeys = [];
    private Dictionary<string, DateTime> _endingModules = [];
    private bool _loading = true;
    private string? _togglingKey;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var offeringsResult = await ApiClient.GetAsync<List<PublicModuleOfferingResponse>>(ApiRoutes.Tenancy.ModuleOfferings);
        if (offeringsResult.IsSuccessful)
        {
            _allOfferings = offeringsResult.ResultData ?? [];
        }
        else
        {
            _error = offeringsResult.DisplayMessage;
        }

        _activeModuleKeys = [.. Tenant.ActiveModuleKeys];
        _endingModules = (Tenant.EndingModules ?? []).ToDictionary(m => m.ModuleKey, m => m.EndsAt);

        _loading = false;
    }

    private async Task ToggleModuleAsync(PublicModuleOfferingResponse offering, bool on)
    {
        var resuming = on && _endingModules.ContainsKey(offering.Key);

        if (!resuming && !await ConfirmAsync(offering, on))
        {
            return;
        }

        _togglingKey = offering.Key;

        var result = on
            ? await ApiClient.PostAsync(ApiRoutes.Platform.Tenants.AddModule(Tenant.Id, offering.Key), new { })
            : await ApiClient.DeleteAsync(ApiRoutes.Platform.Tenants.RemoveModule(Tenant.Id, offering.Key));

        _togglingKey = null;

        if (!result.IsSuccessful)
        {
            _error = result.DisplayMessage;
            return;
        }

        _error = null;
        Snackbar.ShowSuccess(result.DisplayMessage);

        if (on)
        {
            _ = _activeModuleKeys.Add(offering.Key);
            _ = _endingModules.Remove(offering.Key);
        }
        else
        {
            _endingModules[offering.Key] = PeriodEnd() ?? DateTime.UtcNow;
        }
    }

    private Task<bool> ConfirmAsync(PublicModuleOfferingResponse offering, bool adding)
    {
        var periodEnd = PeriodEnd();
        var until = periodEnd is { } end ? $"until {BusinessTime.FormatDate(AsUtc(end))}" : "until the end of the current billing period";

        return adding
            ? DialogService.ConfirmAsync($"Add {offering.Name}?",
                $"{ChargeNowText(offering, periodEnd)} to the card on file, then {CurrencyFormat.Format(offering.Price)} / {ModuleOfferingDisplay.CycleLabel(offering)} with the subscription.")
            : DialogService.ConfirmAsync($"Remove {offering.Name}?",
                $"It stays active {until} and won't be billed again. No refund is issued for the current period.");
    }

    /// <summary>Estimate only; the provider prorates to the second.</summary>
    private static string ChargeNowText(PublicModuleOfferingResponse offering, DateTime? periodEnd)
    {
        if (periodEnd is not { } end || end <= DateTime.UtcNow)
        {
            return "The prorated amount for the rest of this billing period is charged now";
        }

        var start = ModuleOfferingDisplay.IsAnnual(offering) ? end.AddYears(-1) : end.AddMonths(-1);
        var share = (decimal)((end - DateTime.UtcNow) / (end - start));
        return $"About {CurrencyFormat.Format(Math.Round(offering.Price * Math.Clamp(share, 0m, 1m), 2))} is charged now for the rest of this billing period";
    }

    private DateTime? PeriodEnd() => Tenant.RenewalDate is { } renewal && renewal > DateTime.UtcNow ? renewal : null;

    private static DateTimeOffset AsUtc(DateTime value) => new(DateTime.SpecifyKind(value, DateTimeKind.Utc));
}
