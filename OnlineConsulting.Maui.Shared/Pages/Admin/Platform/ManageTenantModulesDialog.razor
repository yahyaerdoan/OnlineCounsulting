@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Platform
@inject IApiClient ApiClient
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Manage Modules - @Tenant.Name</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_allOfferings.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No modules are available right now.</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Changes are billed right away, prorated to your current period.</MudText>
            <MudStack Spacing="0" Class="module-toggle-list">
                @foreach (var offering in _allOfferings)
                {
                    var isActive = _activeModuleKeys.Contains(offering.Key);
                    <div class="module-toggle-row">
                        <MudIcon Icon="@ModuleOfferingDisplay.Icon(offering)" Color="Color.Primary" />
                        <div class="module-toggle-text">
                            <MudText Typo="Typo.body1" Class="text-strong">@offering.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@CurrencyFormat.Format(offering.Price) / @ModuleOfferingDisplay.CycleLabel(offering)</MudText>
                        </div>
                        <MudSwitch T="bool" Value="@isActive" ValueChanged="@(active => ToggleModuleAsync(offering.Key, active))" Color="Color.Primary"
                                   Disabled="@(_togglingKey is not null)" aria-label="@offering.Name" />
                    </div>
                }
            </MudStack>
        }
        <ApiErrorAlert Message="@_error" Severity="Severity.Error" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close(DialogResult.Ok(true)))">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public TenantResponse Tenant { get; set; } = default!;

    private List<PublicModuleOfferingResponse> _allOfferings = [];
    private HashSet<string> _activeModuleKeys = [];
    private bool _loading = true;
    private string? _togglingKey;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var offeringsResult = await ApiClient.GetAsync<List<PublicModuleOfferingResponse>>(ApiRoutes.Tenancy.ModuleOfferings);
        if (offeringsResult.IsSuccessful)
        {
            _allOfferings = offeringsResult.ResultData ?? [];
        }
        else
        {
            _error = offeringsResult.DisplayMessage;
        }

        _activeModuleKeys = [.. Tenant.ActiveModuleKeys];

        _loading = false;
    }

    private async Task ToggleModuleAsync(string key, bool active)
    {
        _togglingKey = key;

        var result = active
            ? await ApiClient.PostAsync(ApiRoutes.Platform.Tenants.AddModule(Tenant.Id, key), new { })
            : await ApiClient.DeleteAsync(ApiRoutes.Platform.Tenants.RemoveModule(Tenant.Id, key));

        _togglingKey = null;

        if (!result.IsSuccessful)
        {
            _error = result.DisplayMessage;
            return;
        }

        _error = null;

        if (active)
        {
            _ = _activeModuleKeys.Add(key);
        }
        else
        {
            _ = _activeModuleKeys.Remove(key);
        }
    }
}
