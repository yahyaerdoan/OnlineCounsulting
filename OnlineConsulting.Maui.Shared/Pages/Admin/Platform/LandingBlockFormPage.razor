@page "/admin/platform/landing-blocks/new"
@page "/admin/platform/landing-blocks/{Id:guid}/edit"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Infrastructure.Icons
@using OnlineConsulting.Maui.Shared.Pages.Admin.Platform.LandingBlockModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<LandingBlockFormModel> Form

<PageTitle>@PageName</PageTitle>

<PageHeroBanner Title="@PageName" Subtitle="A feature card, how-it-works step or FAQ entry on the platform's home page.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="BackToList">Back to Landing Blocks</MudButton>
    </ActionContent>
</PageHeroBanner>
<PageBreadcrumbExtra Text="@PageName" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<EditForm EditContext="@Form.EditContext">
    <MudPaper Class="pa-4">
        <MudStack Spacing="3">
            <MudSelect T="string" @bind-Value="_model.Section" For="@(() => _model.Section)" Label="Section" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                @foreach (var (value, label) in LandingSections.All)
                {
                    <MudSelectItem T="string" Value="@value">@label</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="_model.Title" For="@(() => _model.Title)" Label="@(IsFaq ? "Question" : "Title")" Variant="Variant.Outlined" Margin="Margin.Dense" />

            <MudTextField @bind-Value="_model.Body" For="@(() => _model.Body)" Label="@(IsFaq ? "Answer" : "Text")" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="2" MaxLines="6" Sizing="InputSizing.Auto" />

            <MudNumericField @bind-Value="_model.DisplayOrder" For="@(() => _model.DisplayOrder)" Label="Display order" Variant="Variant.Outlined" Margin="Margin.Dense" />

            @if (!IsFaq)
            {
                <IconPicker @bind-Value="_model.Icon" For="@(() => _model.Icon)" />
            }
        </MudStack>

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="BackToList">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">@(Id is null ? "Create" : "Save")</MudButton>
        </MudStack>
    </MudPaper>
</EditForm>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly LandingBlockFormModel _model = new();
    private string? _loadError;

    private string PageName => Id is null ? "New Landing Block" : "Edit Landing Block";

    private bool IsFaq => _model.Section == LandingSections.Faq;

    protected override async Task OnInitializedAsync()
    {
        // Bind before any await - Blazor can render (and touch Form.EditContext) after the first yield point.
        Form.Bind(_model);

        if (Id is not { } blockId)
        {
            return;
        }

        // No GetById endpoint - the public list is small, so find the entry there.
        var listResult = await ApiClient.GetAsync<List<LandingBlockResponse>>(ApiRoutes.SiteContent.LandingBlocks.Base);
        var block = listResult.IsSuccessful ? listResult.ResultData?.Find(b => b.Id == blockId) : null;
        if (block is null)
        {
            _loadError = listResult.DisplayMessage;
            return;
        }

        _model.Section = block.Section;
        _model.Title = block.Title;
        _model.Body = block.Body;
        _model.Icon = string.IsNullOrWhiteSpace(block.Icon) ? null : IconCatalog.Resolve(block.Icon);
        _model.DisplayOrder = block.DisplayOrder;
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var body = new
        {
            section = _model.Section,
            title = _model.Title,
            body = _model.Body,
            icon = IsFaq ? null : _model.Icon,
            displayOrder = _model.DisplayOrder,
        };

        var result = Id is { } blockId
            ? await ApiClient.PutAsync(ApiRoutes.SiteContent.LandingBlocks.ById(blockId), body)
            : await ApiClient.PostAsync(ApiRoutes.SiteContent.LandingBlocks.Base, body);

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        BackToList();
    });

    private void BackToList() => Navigation.NavigateTo(AppRoutes.AdminHome + "/platform/landing-blocks");
}
