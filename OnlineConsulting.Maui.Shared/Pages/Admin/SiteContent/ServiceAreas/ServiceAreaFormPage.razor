@page "/admin/site-content/service-areas/new"
@page "/admin/site-content/service-areas/{Id:guid}/edit"
@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@attribute [Authorize]
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.ServiceAreaModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<ServiceAreaFormModel> Form

<PageTitle>@(Id is null ? "New Service Area" : "Edit Service Area")</PageTitle>

<PageHeroBanner Title="@(Id is null ? "New Service Area" : "Edit Service Area")" Subtitle="The slug is generated automatically from Name and State.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/service-areas"))">Back to Service Areas</MudButton>
    </ActionContent>
</PageHeroBanner>
<PageBreadcrumbExtra Text="@(Id is null ? "New Service Area" : "Edit Service Area")" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<EditForm EditContext="@Form.EditContext">
    <MudPaper Class="pa-4">
        <ServiceAreaFormFields Model="_model" Slug="@_slug" />

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/service-areas"))">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">
                @(Id is null ? "Create" : "Save")
            </MudButton>
        </MudStack>
    </MudPaper>
</EditForm>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly ServiceAreaFormModel _model = new();
    private string? _slug;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        // Bind before any await - Blazor can render (and touch Form.EditContext) after the first yield point.
        Form.Bind(_model);

        if (Id is not { } areaId)
        {
            return;
        }

        // No single-item GET endpoint - fetch the unbounded list and find it, as EquipmentFormPage does for its customer picker.
        var listResult = await ApiClient.QueryAsync<PaginatedResponse<ServiceAreaResponse>>(ApiRoutes.Paged(ApiRoutes.SiteContent.ServiceArea.All, 0, int.MaxValue), null);
        var area = listResult.IsSuccessful ? listResult.ResultData?.Items.FirstOrDefault(a => a.Id == areaId) : null;
        if (area is null)
        {
            _loadError = listResult.DisplayMessage;
            return;
        }

        _model.Name = area.Name;
        _model.State = area.State;
        _model.IntroText = area.IntroText;
        _model.DisplayOrder = area.DisplayOrder;
        _slug = area.Slug;
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var body = new
        {
            name = _model.Name,
            state = _model.State,
            introText = _model.IntroText,
            displayOrder = _model.DisplayOrder,
        };

        var result = Id is { } areaId
            ? await ApiClient.PutAsync(ApiRoutes.SiteContent.ServiceArea.ById(areaId), body)
            : await ApiClient.PostAsync(ApiRoutes.SiteContent.ServiceArea.Base, body);

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        CompleteSave(result.DisplayMessage);
    });

    private void CompleteSave(string message)
    {
        Snackbar.ShowSuccess(message);
        Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/service-areas");
    }
}
