@page "/admin/site-content/footer-info"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Footer Info</PageTitle>

<PageHeroBanner Title="Footer Info" Subtitle="Manage the content blocks shown in the public site footer.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/footer-info/new"))">New Entry</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="FooterInfoResponse" @ref="_table" ApiBasePath="@ApiRoutes.SiteContent.FooterInfo.All"
                 SearchPlaceholder="Search description" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh>Image</MudTh>
        <MudTh>Description</MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(FooterInfoResponse.DisplayOrder)" T="FooterInfoResponse">Order</MudTableSortLabel></MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="entry">
        <MudTd DataLabel="Image"><MudAvatar Size="Size.Small" Square="true"><MudImage Src="@entry.ImageUrl" /></MudAvatar></MudTd>
        <MudTd DataLabel="Description" Class="cell-primary">@entry.Description</MudTd>
        <MudTd DataLabel="Order">@entry.DisplayOrder</MudTd>
        <MudTd DataLabel="Actions">
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                <MudTooltip Text="Edit">
                    <MudIconButton Disabled="@(!entry.Can(LinkRels.Edit))" aria-label="Edit" Icon="@Icons.Material.Outlined.EditNote" Color="Color.Default"
                                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + $"/site-content/footer-info/{entry.Id}/edit"))" />
                </MudTooltip>

                <MudTooltip Text="Delete">
                    <MudIconButton Disabled="@(!entry.Can(LinkRels.Delete))" aria-label="Delete" Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error"
                                   OnClick="@(() => DeleteAsync(entry))" />
                </MudTooltip>
            </MudButtonGroup>
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<FooterInfoResponse> _table = default!;
    private string? _loadError;

    private async Task DeleteAsync(FooterInfoResponse entry)
    {
        if (!await DialogService.ConfirmDeleteAsync("footer info entry", entry.Description))
        {
            return;
        }

        if (entry.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
