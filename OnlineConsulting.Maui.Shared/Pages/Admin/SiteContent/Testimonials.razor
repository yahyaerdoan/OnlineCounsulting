@page "/admin/site-content/testimonials"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Testimonials</PageTitle>

<PageHeroBanner Title="Testimonials" Subtitle="Manage the customer testimonials shown on the public site.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="CreateAsync">New Testimonial</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="TestimonialResponse" @ref="_table" ApiBasePath="@ApiRoutes.SiteContent.Testimonial.All"
                 SearchPlaceholder="Search name or title" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@nameof(TestimonialResponse.FirstName)" T="TestimonialResponse">Name</MudTableSortLabel></MudTh>
        <MudTh>Title</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="testimonial">
        <MudTd DataLabel="Name" Class="cell-primary"><PersonCell Name="@($"{testimonial.FirstName} {testimonial.LastName}")" ImageUrl="@testimonial.ImageUrl" /></MudTd>
        <MudTd DataLabel="Title">@testimonial.Title</MudTd>
        <MudTd DataLabel="Actions">
            <RowActions Actions="@([
                new RowAction("Edit", Icons.Material.Outlined.EditNote) { Href = EditUrl(testimonial), Disabled = !testimonial.Can(LinkRels.Edit) },
                new RowAction("Delete", Icons.Material.Outlined.DeleteOutline) { OnClick = () => DeleteAsync(testimonial), Disabled = !testimonial.Can(LinkRels.Delete), Color = Color.Error },
            ])" />
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<TestimonialResponse> _table = default!;
    private string? _loadError;

    private void CreateAsync() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/testimonials/new");

    private static string EditUrl(TestimonialResponse testimonial) => AppRoutes.AdminHome + $"/site-content/testimonials/{testimonial.Id}/edit";

    private async Task DeleteAsync(TestimonialResponse testimonial)
    {
        if (!await DialogService.ConfirmDeleteAsync("testimonial", $"{testimonial.FirstName} {testimonial.LastName}"))
        {
            return;
        }

        if (testimonial.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
