@page "/admin/site-content/feature-highlights-intro"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Feature Highlights Intro</PageTitle>

<PageHeroBanner Title="Feature Highlights Intro" Subtitle="Manage the intro paragraph and cover image shown above the 'what we provide' cards.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="CreateAsync">New Intro</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="FeatureHighlightsIntroResponse" @ref="_table" ApiBasePath="@ApiRoutes.SiteContent.FeatureHighlightsIntro.All"
                 SearchPlaceholder="Search description" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh>Description</MudTh>
        <MudTh>Display Order</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="intro">
        <MudTd DataLabel="Description" Class="cell-primary">@intro.Description</MudTd>
        <MudTd DataLabel="Display Order">@intro.DisplayOrder</MudTd>
        <MudTd DataLabel="Actions">
            <RowActions Actions="@([
                new RowAction("Edit", Icons.Material.Outlined.EditNote) { Href = EditUrl(intro), Disabled = !intro.Can(LinkRels.Edit) },
                new RowAction("Delete", Icons.Material.Outlined.DeleteOutline) { OnClick = () => DeleteAsync(intro), Disabled = !intro.Can(LinkRels.Delete), Color = Color.Error },
            ])" />
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<FeatureHighlightsIntroResponse> _table = default!;
    private string? _loadError;

    private void CreateAsync() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/feature-highlights-intro/new");

    private static string EditUrl(FeatureHighlightsIntroResponse intro) => AppRoutes.AdminHome + $"/site-content/feature-highlights-intro/{intro.Id}/edit";

    private async Task DeleteAsync(FeatureHighlightsIntroResponse intro)
    {
        if (!await DialogService.ConfirmDeleteAsync("feature highlights intro", intro.Description))
        {
            return;
        }

        if (intro.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
