@page "/admin/site-content/faq-items"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.FaqItemModels
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>FAQ Items</PageTitle>

<PageHeroBanner Title="FAQ Items" Subtitle="General questions plus questions shown on each service's page.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/faq-items/new"))">New FAQ Item</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="FaqItemResponse" @ref="_table" ApiBasePath="@ApiRoutes.SiteContent.FaqItems.All"
                 SearchPlaceholder="Search question or answer" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh>Question</MudTh>
        <MudTh>Shown on</MudTh>
        <MudTh>Answer</MudTh>
        <MudTh Class="mud-table-cell-align-right">Order</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTd DataLabel="Question" Class="cell-primary">@item.Question</MudTd>
        <MudTd DataLabel="Shown on">@ScopeLabel(item.ServiceId)</MudTd>
        <MudTd DataLabel="Answer">@item.Answer</MudTd>
        <MudTd DataLabel="Order" Class="mud-table-cell-align-right">@item.DisplayOrder</MudTd>
        <MudTd DataLabel="Actions">
            <RowActions Actions="@([
                new RowAction("Edit", Icons.Material.Outlined.EditNote) { Href = $"{AppRoutes.AdminHome}/site-content/faq-items/{item.Id}/edit", Disabled = !item.Can(LinkRels.Edit) },
                new RowAction("Delete", Icons.Material.Outlined.DeleteOutline) { OnClick = () => DeleteAsync(item), Disabled = !item.Can(LinkRels.Delete), Color = Color.Error },
            ])" />
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<FaqItemResponse> _table = default!;
    private string? _loadError;
    private Dictionary<Guid, string> _serviceTitles = [];

    protected override async Task OnInitializedAsync()
    {
        // /api/v1/services is paginated - a large-enough page for title lookup, same idiom as the form page.
        var services = await ApiClient.GetAsync<PaginatedResponse<ServiceResponse>>($"{ApiRoutes.Services.Base}?size=100");
        _serviceTitles = services.IsSuccessful && services.ResultData is not null ? services.ResultData.Items.ToDictionary(s => s.Id, s => s.Title) : [];
    }

    private string ScopeLabel(Guid? serviceId) =>
        serviceId is { } id ? _serviceTitles.GetValueOrDefault(id, string.Empty) : FaqScopeLabels.General;

    private async Task DeleteAsync(FaqItemResponse item)
    {
        if (!await DialogService.ConfirmDeleteAsync("FAQ item", item.Question))
        {
            return;
        }

        if (item.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
