@page "/admin/site-content/about-us/new"
@page "/admin/site-content/about-us/{Id:guid}/edit"
@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@attribute [Authorize]
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.AboutUsModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<AboutUsFormModel> Form

<PageTitle>@(Id is null ? "New About Us Entry" : "Edit About Us Entry")</PageTitle>

<PageHeroBanner Title="@(Id is null ? "New About Us Entry" : "Edit About Us Entry")" Subtitle="Shown on the public About Us page.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/about-us"))">Back to About Us</MudButton>
    </ActionContent>
</PageHeroBanner>
<PageBreadcrumbExtra Text="@(Id is null ? "New About Us Entry" : "Edit About Us Entry")" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<EditForm EditContext="@Form.EditContext">
    <MudPaper Class="pa-4">
        <AboutUsFormFields Model="_model" />

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/about-us"))">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">
                @(Id is null ? "Create" : "Save")
            </MudButton>
        </MudStack>
    </MudPaper>
</EditForm>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly AboutUsFormModel _model = new();
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        // Bind before any await - Blazor can render (and touch Form.EditContext) after the first yield point.
        Form.Bind(_model);

        if (Id is not { } entryId)
        {
            return;
        }

        // No GetById endpoint exists - fetch the unbounded public list and find the entry.
        var listResult = await ApiClient.GetAsync<List<AboutUsResponse>>(ApiRoutes.SiteContent.AboutUs.Base);
        var entry = listResult.IsSuccessful ? listResult.ResultData?.Find(e => e.Id == entryId) : null;
        if (entry is null)
        {
            _loadError = listResult.DisplayMessage;
            return;
        }

        _model.Title = entry.Title;
        _model.Description = entry.Description;
        _model.CoverImage = entry.CoverImage;
        _model.VideoUrl = entry.VideoUrl;
        _model.DisplayOrder = entry.DisplayOrder;
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var body = new
        {
            title = _model.Title,
            description = _model.Description,
            coverImage = _model.CoverImage,
            videoUrl = _model.VideoUrl,
            displayOrder = _model.DisplayOrder,
        };

        if (Id is null)
        {
            var createResult = await ApiClient.PostAsync(ApiRoutes.SiteContent.AboutUs.Base, body);
            if (!createResult.IsSuccessful)
            {
                Form.DisplayErrors(createResult, Snackbar);
                return;
            }

            CompleteSave(createResult.DisplayMessage);
            return;
        }

        var result = await ApiClient.PutAsync(ApiRoutes.SiteContent.AboutUs.ById(Id.Value), body);
        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        CompleteSave(result.DisplayMessage);
    });

    private void CompleteSave(string message)
    {
        Snackbar.ShowSuccess(message);
        Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/about-us");
    }
}
