@page "/admin/site-content/footer-info/new"
@page "/admin/site-content/footer-info/{Id:guid}/edit"
@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@attribute [Authorize]
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.FooterInfoModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<FooterInfoFormModel> Form

<PageTitle>@(Id is null ? "New Footer Info Entry" : "Edit Footer Info Entry")</PageTitle>

<PageHeroBanner Title="@(Id is null ? "New Footer Info Entry" : "Edit Footer Info Entry")" Subtitle="Shown in the public site footer.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/footer-info"))">Back to Footer Info</MudButton>
    </ActionContent>
</PageHeroBanner>
<PageBreadcrumbExtra Text="@(Id is null ? "New Footer Info Entry" : "Edit Footer Info Entry")" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<EditForm EditContext="@Form.EditContext">
    <MudPaper Class="pa-4">
        <FooterInfoFormFields Model="_model" />

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/footer-info"))">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">
                @(Id is null ? "Create" : "Save")
            </MudButton>
        </MudStack>
    </MudPaper>
</EditForm>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly FooterInfoFormModel _model = new();
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        // Bind before any await - Blazor can render (and touch Form.EditContext) after the first yield point.
        Form.Bind(_model);

        if (Id is not { } entryId)
        {
            return;
        }

        var result = await ApiClient.QueryAsync<PaginatedResponse<FooterInfoResponse>>(ApiRoutes.Paged(ApiRoutes.SiteContent.FooterInfo.All, 0, int.MaxValue), null);
        if (!result.IsSuccessful || result.ResultData is null)
        {
            _loadError = result.DisplayMessage;
            return;
        }

        var entry = result.ResultData.Items.FirstOrDefault(e => e.Id == entryId);
        if (entry is null)
        {
            _loadError = "Footer info entry not found.";
            return;
        }

        _model.ImageUrl = entry.ImageUrl;
        _model.Description = entry.Description;
        _model.DisplayOrder = entry.DisplayOrder;
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        if (Id is null)
        {
            var createResult = await ApiClient.PostAsync(ApiRoutes.SiteContent.FooterInfo.Base, new
            {
                imageUrl = _model.ImageUrl,
                description = _model.Description,
                displayOrder = _model.DisplayOrder,
            });

            if (!createResult.IsSuccessful)
            {
                Form.DisplayErrors(createResult, Snackbar);
                return;
            }

            CompleteSave(createResult.DisplayMessage);
            return;
        }

        var result = await ApiClient.PutAsync(ApiRoutes.SiteContent.FooterInfo.ById(Id.Value), new
        {
            imageUrl = _model.ImageUrl,
            description = _model.Description,
            displayOrder = _model.DisplayOrder,
        });

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        CompleteSave(result.DisplayMessage);
    });

    private void CompleteSave(string message)
    {
        Snackbar.ShowSuccess(message);
        Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/footer-info");
    }
}
