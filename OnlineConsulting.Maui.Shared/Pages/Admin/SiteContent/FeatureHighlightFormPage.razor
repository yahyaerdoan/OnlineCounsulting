@page "/admin/site-content/feature-highlights/new"
@page "/admin/site-content/feature-highlights/{Id:guid}/edit"
@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@attribute [Authorize]
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.FeatureHighlightModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<FeatureHighlightFormModel> Form

<PageTitle>@(Id is null ? "New Feature Highlight" : "Edit Feature Highlight")</PageTitle>

<PageHeroBanner Title="@(Id is null ? "New Feature Highlight" : "Edit Feature Highlight")" Subtitle="Shown in the public 'what we provide' section.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/feature-highlights"))">Back to Feature Highlights</MudButton>
    </ActionContent>
</PageHeroBanner>
<PageBreadcrumbExtra Text="@(Id is null ? "New Feature Highlight" : "Edit Feature Highlight")" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<EditForm EditContext="@Form.EditContext">
    <MudPaper Class="pa-4">
        <FeatureHighlightFormFields Model="_model" />

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/feature-highlights"))">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">
                @(Id is null ? "Create" : "Save")
            </MudButton>
        </MudStack>
    </MudPaper>
</EditForm>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly FeatureHighlightFormModel _model = new();
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        // Bind before any await - Blazor can render (and touch Form.EditContext) after the first yield point.
        Form.Bind(_model);

        if (Id is not { } highlightId)
        {
            return;
        }

        // No GetById endpoint exists - fetch the unbounded public list and find the entry.
        var listResult = await ApiClient.GetAsync<List<FeatureHighlightResponse>>(ApiRoutes.SiteContent.FeatureHighlight.Base);
        var highlight = listResult.IsSuccessful ? listResult.ResultData?.Find(h => h.Id == highlightId) : null;
        if (highlight is null)
        {
            _loadError = listResult.DisplayMessage;
            return;
        }

        _model.Title = highlight.Title;
        _model.Description = highlight.Description;
        _model.ImageUrl = highlight.ImageUrl;
        _model.DisplayOrder = highlight.DisplayOrder;
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var body = new
        {
            title = _model.Title,
            description = _model.Description,
            imageUrl = _model.ImageUrl,
            displayOrder = _model.DisplayOrder,
        };

        if (Id is null)
        {
            var createResult = await ApiClient.PostAsync(ApiRoutes.SiteContent.FeatureHighlight.Base, body);
            if (!createResult.IsSuccessful)
            {
                Form.DisplayErrors(createResult, Snackbar);
                return;
            }

            CompleteSave(createResult.DisplayMessage);
            return;
        }

        var result = await ApiClient.PutAsync(ApiRoutes.SiteContent.FeatureHighlight.ById(Id.Value), body);
        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        CompleteSave(result.DisplayMessage);
    });

    private void CompleteSave(string message)
    {
        Snackbar.ShowSuccess(message);
        Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/feature-highlights");
    }
}
