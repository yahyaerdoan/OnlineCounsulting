@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.GalleryCategoryModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject FormState<GalleryCategoryFormModel> Form

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit @Category.Name</MudText>
    </TitleContent>
    <DialogContent>
        <EntitySummaryHeader Title="@Category.Name" Subtitle="@Category.Description" />

        <EditForm EditContext="@Form.EditContext">
            <GalleryCategoryFormFields Model="_model" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="SaveAsync" IsBusy="@Form.IsBusy" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public GalleryCategoryResponse Category { get; set; } = default!;

    private readonly GalleryCategoryFormModel _model = new();

    protected override void OnInitialized()
    {
        _model.Name = Category.Name;
        _model.Description = Category.Description;
        Form.Bind(_model);
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var result = await ApiClient.PutAsync(ApiRoutes.SiteContent.GalleryCategory.ById(Category.Id), new { name = _model.Name, description = _model.Description });
        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        MudDialog.Close(DialogResult.Ok(true));
    });
}
