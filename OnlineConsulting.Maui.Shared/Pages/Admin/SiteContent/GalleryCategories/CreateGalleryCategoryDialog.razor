@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.GalleryCategoryModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject FormState<GalleryCategoryFormModel> Form

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Gallery Category</MudText>
    </TitleContent>
    <DialogContent>
        <EntitySummaryHeader Title="New Gallery Category" Subtitle="Tags gallery photos are grouped by." />

        <EditForm EditContext="@Form.EditContext">
            <GalleryCategoryFormFields Model="_model" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="CreateAsync" IsBusy="@Form.IsBusy" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly GalleryCategoryFormModel _model = new();

    protected override void OnInitialized() => Form.Bind(_model);

    private Task CreateAsync() => Form.SubmitAsync(async () =>
    {
        var result = await ApiClient.PostAsync(ApiRoutes.SiteContent.GalleryCategory.Base, new { name = _model.Name, description = _model.Description });
        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        MudDialog.Close(DialogResult.Ok(true));
    });
}
