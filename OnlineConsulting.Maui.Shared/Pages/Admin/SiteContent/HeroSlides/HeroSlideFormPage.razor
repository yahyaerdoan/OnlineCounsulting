@page "/admin/site-content/hero-slides/new"
@page "/admin/site-content/hero-slides/{Id:guid}/edit"
@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@attribute [Authorize]
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.HeroSlideModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject FormState<HeroSlideFormModel> Form

<PageTitle>@(Id is null ? "New Hero Slide" : "Edit Hero Slide")</PageTitle>

<PageHeroBanner Title="@(Id is null ? "New Hero Slide" : "Edit Hero Slide")" Subtitle="Shown in the homepage hero carousel.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ArrowBack"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/hero-slides"))">Back to Hero Slides</MudButton>
    </ActionContent>
</PageHeroBanner>
<PageBreadcrumbExtra Text="@(Id is null ? "New Hero Slide" : "Edit Hero Slide")" />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<EditForm EditContext="@Form.EditContext">
    <MudPaper Class="pa-4">
        <HeroSlideFormFields Model="_model" />

        <MudDivider Class="my-4" />

        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
            <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/hero-slides"))">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Form.IsBusy">
                @(Id is null ? "Create" : "Save")
            </MudButton>
        </MudStack>
    </MudPaper>
</EditForm>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly HeroSlideFormModel _model = new();
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        // Bind before any await - Blazor can render (and touch Form.EditContext) after the first yield point.
        Form.Bind(_model);

        if (Id is not { } slideId)
        {
            return;
        }

        // No single-item GET endpoint - fetch the unbounded list and find it, as EquipmentFormPage does for its customer picker.
        var listResult = await ApiClient.QueryAsync<PaginatedResponse<HeroSlideResponse>>(ApiRoutes.Paged(ApiRoutes.SiteContent.HeroSlide.All, 0, int.MaxValue), null);
        var slide = listResult.IsSuccessful ? listResult.ResultData?.Items.FirstOrDefault(s => s.Id == slideId) : null;
        if (slide is null)
        {
            _loadError = listResult.DisplayMessage;
            return;
        }

        _model.Title = slide.Title;
        _model.Description = slide.Description;
        _model.ImageUrl = slide.ImageUrl;
        _model.DisplayOrder = slide.DisplayOrder;
    }

    private Task SaveAsync() => Form.SubmitAsync(async () =>
    {
        var body = new
        {
            title = _model.Title,
            description = _model.Description,
            imageUrl = _model.ImageUrl,
            displayOrder = _model.DisplayOrder,
        };

        var result = Id is { } slideId
            ? await ApiClient.PutAsync(ApiRoutes.SiteContent.HeroSlide.ById(slideId), body)
            : await ApiClient.PostAsync(ApiRoutes.SiteContent.HeroSlide.Base, body);

        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        CompleteSave(result.DisplayMessage);
    });

    private void CompleteSave(string message)
    {
        Snackbar.ShowSuccess(message);
        Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/hero-slides");
    }
}
