@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@using OnlineConsulting.Maui.Shared.Pages.Admin.Catalog
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.PartnershipModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="Model.FirstName" For="@(() => Model.FirstName)" Label="First name" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="Model.LastName" For="@(() => Model.LastName)" Label="Last name" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>

    <MudTextField @bind-Value="Model.Email" For="@(() => Model.Email)" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <MudTextField @bind-Value="Model.Title" For="@(() => Model.Title)" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <MudTextField @bind-Value="Model.CompanyName" For="@(() => Model.CompanyName)" Label="Company name" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <MudTextField @bind-Value="Model.Description" For="@(() => Model.Description)" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Lines="1" MaxLines="5" Sizing="InputSizing.Auto" />

    <MudTextField @bind-Value="Model.WebsiteUrl" For="@(() => Model.WebsiteUrl)" Label="Website URL" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <MudNumericField @bind-Value="Model.DisplayOrder" For="@(() => Model.DisplayOrder)" Label="Display order" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <CoverImagePicker ImageUrl="@_photoUrl" IsUploading="_isUploadingPhoto" OnFileSelected="OnPhotoSelectedAsync" OnAssetSelected="OnAssetSelected"
                      OnRemove="@(() => { Model.PhotoMediaAssetId = null; _photoUrl = null; })" />
</MudStack>

@code {
    [Parameter, EditorRequired]
    public PartnershipFormModel Model { get; set; } = default!;

    [Parameter]
    public string? InitialPhotoUrl { get; set; }

    private string? _photoUrl;
    private bool _isUploadingPhoto;
    private bool _photoUrlInitialized;

    protected override void OnParametersSet()
    {
        if (!_photoUrlInitialized)
        {
            _photoUrl = InitialPhotoUrl;
            _photoUrlInitialized = true;
        }
    }

    private async Task OnPhotoSelectedAsync(InputFileChangeEventArgs e)
    {
        _isUploadingPhoto = true;
        var result = await MediaUploadHelper.UploadAsync(ApiClient, e.File);
        _isUploadingPhoto = false;

        if (!result.IsSuccessful || result.ResultData is null)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Model.PhotoMediaAssetId = result.ResultData.Id;
        _photoUrl = result.ResultData.Url;
    }

    private void OnAssetSelected(MediaAssetResponse asset)
    {
        Model.PhotoMediaAssetId = asset.Id;
        _photoUrl = asset.Url;
    }
}
