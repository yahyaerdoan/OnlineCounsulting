@namespace OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent
@using MudExRichTextEditor
@using OnlineConsulting.Maui.Shared.Pages.Admin.Catalog
@using OnlineConsulting.Maui.Shared.Pages.Admin.SiteContent.AboutUsModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudTextField @bind-Value="Model.Title" For="@(() => Model.Title)" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <MudText Typo="Typo.body2" Color="Color.Secondary">Description</MudText>
    <MudExRichTextEdit @ref="_editor" @bind-Value="Model.Description" Height="240" Placeholder="Description" />
    <ValidationMessage For="@(() => Model.Description)" Class="mud-input-error" />

    <MudTextField @bind-Value="Model.VideoUrl" For="@(() => Model.VideoUrl)" Label="Video URL" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <MudNumericField @bind-Value="Model.DisplayOrder" For="@(() => Model.DisplayOrder)" Label="Display order" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <CoverImagePicker ImageUrl="@Model.CoverImage" IsUploading="_isUploading" OnFileSelected="OnFileSelectedAsync" OnAssetSelected="OnAssetSelected"
                      OnRemove="@(() => Model.CoverImage = null)" />
</MudStack>

@code {
    [Parameter, EditorRequired]
    public AboutUsFormModel Model { get; set; } = default!;

    private bool _isUploading;
    private MudExRichTextEdit _editor = default!;
    private string? _pendingInitialDescription;

    /// <summary>SetHtml bypasses Quill's clipboard importer and drops foreign markup (e.g. lists) -
    /// clear before mount, then reload via InsertHtmlAsync after render to load it losslessly.</summary>
    protected override void OnParametersSet()
    {
        if (_pendingInitialDescription is null && !string.IsNullOrEmpty(Model.Description))
        {
            _pendingInitialDescription = Model.Description;
            Model.Description = string.Empty;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pendingInitialDescription is { } html)
        {
            // SetHtml("") first just to await the editor's JS-ready wait - InsertHtmlAsync has none.
            await _editor.SetHtml(string.Empty);
            await _editor.InsertHtmlAsync(html);
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _isUploading = true;
        var result = await MediaUploadHelper.UploadAsync(ApiClient, e.File, MediaFolders.AboutUs);
        _isUploading = false;

        if (!result.IsSuccessful || result.ResultData is null)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Model.CoverImage = result.ResultData.Url;
    }

    private void OnAssetSelected(MediaAssetResponse asset) => Model.CoverImage = asset.Url;
}
