@page "/admin/site-content/service-areas"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Service Areas</PageTitle>

<PageHeroBanner Title="Service Areas" Subtitle="Manage the geographic service areas shown on the public site.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/service-areas/new"))">New Area</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="ServiceAreaResponse" @ref="_table" ApiBasePath="@ApiRoutes.SiteContent.ServiceArea.All"
                 SearchPlaceholder="Search name or state" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@nameof(ServiceAreaResponse.Name)" T="ServiceAreaResponse">Name</MudTableSortLabel></MudTh>
        <MudTh>State</MudTh>
        <MudTh>Slug</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="area">
        <MudTd DataLabel="Name" Class="cell-primary">@area.Name</MudTd>
        <MudTd DataLabel="State">@area.State</MudTd>
        <MudTd DataLabel="Slug">@area.Slug</MudTd>
        <MudTd DataLabel="Actions">
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                <MudTooltip Text="Edit">
                    <MudIconButton Disabled="@(!area.Can(LinkRels.Edit))" aria-label="Edit" Icon="@Icons.Material.Outlined.EditNote" Color="Color.Default"
                                   OnClick="@(() => Navigation.NavigateTo($"{AppRoutes.AdminHome}/site-content/service-areas/{area.Id}/edit"))" />
                </MudTooltip>

                <MudTooltip Text="Delete">
                    <MudIconButton Disabled="@(!area.Can(LinkRels.Delete))" aria-label="Delete" Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error"
                                   OnClick="@(() => DeleteAsync(area))" />
                </MudTooltip>
            </MudButtonGroup>
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<ServiceAreaResponse> _table = default!;
    private string? _loadError;

    private async Task DeleteAsync(ServiceAreaResponse area)
    {
        if (!await DialogService.ConfirmDeleteAsync("service area", area.Name))
        {
            return;
        }

        if (area.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
