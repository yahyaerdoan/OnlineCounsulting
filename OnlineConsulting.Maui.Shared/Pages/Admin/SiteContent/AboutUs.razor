@page "/admin/site-content/about-us"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>About Us</PageTitle>

<PageHeroBanner Title="About Us" Subtitle="Manage the About Us content blocks shown on the public site.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="CreateAsync">New Entry</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="AboutUsResponse" @ref="_table" ApiBasePath="@ApiRoutes.SiteContent.AboutUs.All"
                 SearchPlaceholder="Search title or description" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh>Cover</MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(AboutUsResponse.Title)" T="AboutUsResponse">Title</MudTableSortLabel></MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="entry">
        <MudTd DataLabel="Cover">
            @if (entry.CoverImage is not null)
            {
                <MudAvatar Size="Size.Small" Square="true"><MudImage Src="@MediaUrlResolver.Resolve(ApiClient, entry.CoverImage)" /></MudAvatar>
            }
        </MudTd>
        <MudTd DataLabel="Title" Class="cell-primary">@entry.Title</MudTd>
        @* Sanitized on save (IRichTextSanitizer), so it renders as the editor shows it. *@
        <MudTd DataLabel="Description"><div class="admin-rich-text">@((MarkupString)entry.Description)</div></MudTd>
        <MudTd DataLabel="Actions">
            <RowActions Actions="@([
                new RowAction("Edit", Icons.Material.Outlined.EditNote) { Href = EditUrl(entry), Disabled = !entry.Can(LinkRels.Edit) },
                new RowAction("Delete", Icons.Material.Outlined.DeleteOutline) { OnClick = () => DeleteAsync(entry), Disabled = !entry.Can(LinkRels.Delete), Color = Color.Error },
            ])" />
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<AboutUsResponse> _table = default!;
    private string? _loadError;

    private void CreateAsync() => Navigation.NavigateTo(AppRoutes.AdminHome + "/site-content/about-us/new");

    private static string EditUrl(AboutUsResponse entry) => AppRoutes.AdminHome + $"/site-content/about-us/{entry.Id}/edit";

    private async Task DeleteAsync(AboutUsResponse entry)
    {
        if (!await DialogService.ConfirmDeleteAsync("About Us entry", entry.Title))
        {
            return;
        }

        if (entry.Links.Find(LinkRels.Delete) is not { } delete)
        {
            return;
        }

        var result = await ApiClient.FollowAsync(delete);
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
