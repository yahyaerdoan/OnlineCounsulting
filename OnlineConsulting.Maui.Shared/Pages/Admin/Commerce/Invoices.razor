@* Every invoice for the business: visit invoices awaiting payment and order receipts. Staff record offline payments
   (the customer gets a receipt), void mistakes, and download any invoice as a PDF. *@
@page "/admin/commerce/invoices"
@attribute [Authorize(Roles = "Admin,Super Admin,Member")]
@using OnlineConsulting.Maui.Shared.Infrastructure.Files
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject IFileSaver FileSaver
@inject ISnackbar Snackbar

<PageTitle>Invoices</PageTitle>

<PageHeroBanner Title="Invoices" Subtitle="Visit invoices and order receipts. Record cash or check payments here." />

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="InvoiceResponse" @ref="_table" ApiBasePath="@ApiRoutes.Invoices.All"
                 SearchPlaceholder="Search invoice number, customer or status" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="@nameof(InvoiceResponse.IssuedAt)" T="InvoiceResponse">Issued</MudTableSortLabel></MudTh>
        <MudTh>Invoice #</MudTh>
        <MudTh>Customer</MudTh>
        <MudTh>For</MudTh>
        <MudTh>Status</MudTh>
        <MudTh Class="mud-table-cell-align-right">Total</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="invoice">
        <MudTd DataLabel="Issued">@DateTimeFormat.FormatDate(invoice.IssuedAt)</MudTd>
        <MudTd DataLabel="Invoice #" Class="cell-primary">@invoice.InvoiceNumber</MudTd>
        <MudTd DataLabel="Customer">@invoice.BillToName</MudTd>
        <MudTd DataLabel="For">@invoice.Title</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@OnlineConsulting.Maui.Shared.Pages.User.Invoices.StatusColor(invoice)">
                @OnlineConsulting.Maui.Shared.Pages.User.Invoices.StatusLabel(invoice)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Total" Class="mud-table-cell-align-right">@CurrencyFormat.Format(invoice.Total)</MudTd>
        <MudTd DataLabel="Actions">
            <MudTooltip Text="Download PDF">
                <MudIconButton aria-label="Download PDF" Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" OnClick="@(() => DownloadAsync(invoice))" />
            </MudTooltip>
            <MudTooltip Text="Record payment">
                <MudMenu aria-label="Record payment" Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" Dense="true" Disabled="@(!invoice.IsOpen)">
                    <MudMenuItem OnClick="@(() => MarkPaidAsync(invoice, "Cash"))">Paid in cash</MudMenuItem>
                    <MudMenuItem OnClick="@(() => MarkPaidAsync(invoice, "Check"))">Paid by check</MudMenuItem>
                    <MudMenuItem OnClick="@(() => MarkPaidAsync(invoice, "Card"))">Card taken on site</MudMenuItem>
                </MudMenu>
            </MudTooltip>
            <MudTooltip Text="Void">
                <MudIconButton aria-label="Void" Icon="@Icons.Material.Outlined.Block" Color="Color.Error" Size="Size.Small" Disabled="@(!invoice.IsOpen)"
                               OnClick="@(() => VoidAsync(invoice))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<InvoiceResponse>? _table;
    private string? _loadError;

    private async Task DownloadAsync(InvoiceResponse invoice)
    {
        var result = await ApiClient.GetAsync<InvoicePdfResponse>(ApiRoutes.Invoices.StaffPdf(invoice.Id));
        if (!result.IsSuccessful || result.ResultData is null)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        await FileSaver.SaveAsync(result.ResultData.FileName, Convert.FromBase64String(result.ResultData.ContentBase64), "application/pdf");
    }

    private async Task MarkPaidAsync(InvoiceResponse invoice, string method)
    {
        if (!await DialogService.ConfirmAsync("Record payment", $"Mark {invoice.InvoiceNumber} ({CurrencyFormat.Format(invoice.Total)}) as paid? The customer gets a receipt."))
        {
            return;
        }

        var result = await ApiClient.PostAsync(ApiRoutes.Invoices.MarkPaid(invoice.Id), new { paymentMethod = method });
        await ShowAndReloadAsync(result);
    }

    private async Task VoidAsync(InvoiceResponse invoice)
    {
        if (!await DialogService.ConfirmAsync("Void invoice", $"Void {invoice.InvoiceNumber}? The customer won't be asked to pay it."))
        {
            return;
        }

        var result = await ApiClient.PostAsync(ApiRoutes.Invoices.Void(invoice.Id), new { reason = (string?)null });
        await ShowAndReloadAsync(result);
    }

    private async Task ShowAndReloadAsync(ApiEnvelope result)
    {
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        if (_table is not null)
        {
            await _table.ReloadAsync();
        }
    }
}
