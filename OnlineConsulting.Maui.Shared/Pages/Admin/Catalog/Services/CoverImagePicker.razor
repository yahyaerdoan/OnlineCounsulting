@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Catalog

<MudStack Spacing="2">
    @if (ImageUrl is not null)
    {
        <MudImage Src="@ImageUrl" Height="160" ObjectFit="ObjectFit.Cover" Class="rounded-lg" />
    }

    <MudFileUpload T="IBrowserFile" Files="_selectedFile" FilesChanged="OnSelectedFileChangedAsync" OnFilesChanged="OnFileSelected"
                   Accept="image/*" DragAndDrop="true" Disabled="IsUploading" />

    @if (IsUploading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
</MudStack>

@code {
    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter]
    public bool IsUploading { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }

    /// <summary>Media Library browsing is disabled for now - kept so callers don't need to change; not wired to any UI.</summary>
    [Parameter]
    public EventCallback<MediaAssetResponse> OnAssetSelected { get; set; }

    /// <summary>Fires when the file upload's own delete (x) icon clears the selected file - the single
    /// place this picker signals "remove the image", replacing a separate Remove button.</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    private IBrowserFile? _selectedFile;

    private Task OnSelectedFileChangedAsync(IBrowserFile? file)
    {
        _selectedFile = file;
        return file is null && OnRemove.HasDelegate ? OnRemove.InvokeAsync() : Task.CompletedTask;
    }
}
