@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Catalog
@inject IApiClient ApiClient

<MudStack Spacing="2">
    @* Relative media urls are served by the Api, not this page's origin. *@
    @if (MediaUrlResolver.Resolve(ApiClient, ImageUrl) is { } src)
    {
        @* Whole picture, aspect kept, scales with the screen. *@
        <MudImage Src="@src" Fluid="true" ObjectFit="ObjectFit.Contain" Class="rounded-lg cover-image-preview" />
    }

    <MudFileUpload T="IBrowserFile" Files="_selectedFile" FilesChanged="OnSelectedFileChangedAsync" OnFilesChanged="OnFileSelected"
                   Accept="image/*" DragAndDrop="true" Disabled="IsUploading" />

    @if (IsUploading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
</MudStack>

@code {
    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter]
    public bool IsUploading { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }

    /// <summary>Unused for now - Media Library browsing was removed but callers still pass this.</summary>
    [Parameter]
    public EventCallback<MediaAssetResponse> OnAssetSelected { get; set; }

    /// <summary>Fires when the upload's own delete (x) icon clears the file - the "remove" signal.</summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    private IBrowserFile? _selectedFile;

    private Task OnSelectedFileChangedAsync(IBrowserFile? file)
    {
        _selectedFile = file;
        return file is null && OnRemove.HasDelegate ? OnRemove.InvokeAsync() : Task.CompletedTask;
    }
}
