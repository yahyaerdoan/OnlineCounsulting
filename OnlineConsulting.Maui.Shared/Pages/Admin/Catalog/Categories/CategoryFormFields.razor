@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Catalog
@using MudBlazor.Utilities

<MudStack Spacing="3">
    <MudTextField @bind-Value="Model.Title" For="@(() => Model.Title)" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" />

    <MudTextField @bind-Value="Model.Description" For="@(() => Model.Description)" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Lines="1" MaxLines="5" Sizing="InputSizing.Auto" />

    <IconPicker @bind-Value="Model.Icon" For="@(() => Model.Icon)" />

    <MudStack Spacing="1">
        <MudColorPicker Value="@ColorValue" ValueChanged="OnColorChanged" Label="Icon color"
                         Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudLink Href="https://mudblazor.com/features/colors" Target="_blank" Typo="Typo.caption">Browse colors</MudLink>
    </MudStack>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public CategoryFormModel Model { get; set; } = default!;

    private MudColor? ColorValue
    {
        get
        {
            var color = Model.IconColor;
            if (string.IsNullOrWhiteSpace(color))
            {
                return null;
            }

            return color;
        }
    }

    private void OnColorChanged(MudColor? color) => Model.IconColor = color?.ToString(MudColorOutputFormats.Hex);
}
