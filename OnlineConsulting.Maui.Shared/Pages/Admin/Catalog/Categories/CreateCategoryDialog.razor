@namespace OnlineConsulting.Maui.Shared.Pages.Admin.Catalog
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@using OnlineConsulting.Maui.Shared.Pages.Admin.Catalog.CategoryModels
@inject IApiClient ApiClient
@inject ISnackbar Snackbar
@inject FormState<CategoryFormModel> Form

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New Category</MudText>
    </TitleContent>
    <DialogContent>
        <EntitySummaryHeader Title="New Category" Subtitle="Shown to customers browsing your catalog." />

        <EditForm EditContext="@Form.EditContext">
            <CategoryFormFields Model="_model" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="CreateAsync" IsBusy="@Form.IsBusy" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly CategoryFormModel _model = new();

    protected override void OnInitialized() => Form.Bind(_model);

    private Task CreateAsync() => Form.SubmitAsync(async () =>
    {
        var result = await ApiClient.PostAsync(ApiRoutes.Categories.Base, new { title = _model.Title, description = _model.Description, icon = _model.Icon, iconColor = _model.IconColor });
        if (!result.IsSuccessful)
        {
            Form.DisplayErrors(result, Snackbar);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        MudDialog.Close(DialogResult.Ok(true));
    });
}
