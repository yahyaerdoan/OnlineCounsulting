@page "/admin/catalog/categories"
@attribute [Authorize]
@using OnlineConsulting.Maui.Shared.Infrastructure.Icons
@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Categories</PageTitle>

<PageHeroBanner Title="Categories" Subtitle="Manage the service categories customers browse in your catalog.">
    <ActionContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Add"
                   OnClick="@(() => Navigation.NavigateTo(AppRoutes.AdminHome + "/catalog/categories/new"))">New Category</MudButton>
    </ActionContent>
</PageHeroBanner>

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

<ServerDataTable TItem="CategoryResponse" @ref="_table" ApiBasePath="@ApiRoutes.Categories.All"
                 SearchPlaceholder="Search title or description" OnLoadError="@(message => _loadError = message)">
    <HeaderContent>
        <MudTh>Icon</MudTh>
        <MudTh><MudTableSortLabel SortLabel="@nameof(CategoryResponse.Title)" T="CategoryResponse">Title</MudTableSortLabel></MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="category">
        <MudTd DataLabel="Icon"><MudIcon Icon="@IconCatalog.Resolve(category.Icon)" Style="@IconCatalog.ColorStyle(category.IconColor)" Size="Size.Small" /></MudTd>
        <MudTd DataLabel="Title">@category.Title</MudTd>
        <MudTd DataLabel="Description">@category.Description</MudTd>
        <MudTd DataLabel="Actions">
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                <MudIconButton Icon="@Icons.Material.Outlined.EditNote" Color="Color.Default" title="Edit"
                               OnClick="@(() => Navigation.NavigateTo($"{AppRoutes.AdminHome}/catalog/categories/{category.Id}/edit"))" />

                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" title="Delete"
                               OnClick="@(() => DeleteAsync(category))" />
            </MudButtonGroup>
        </MudTd>
    </RowTemplate>
</ServerDataTable>

@code {
    private ServerDataTable<CategoryResponse> _table = default!;
    private string? _loadError;

    private async Task DeleteAsync(CategoryResponse category)
    {
        if (!await DialogService.ConfirmDeleteAsync("category", category.Title))
        {
            return;
        }

        var result = await ApiClient.DeleteAsync(ApiRoutes.Categories.ById(category.Id));
        if (!result.IsSuccessful)
        {
            Snackbar.ShowError(result.DisplayMessage);
            return;
        }

        Snackbar.ShowSuccess(result.DisplayMessage);
        await _table.ReloadAsync();
    }
}
