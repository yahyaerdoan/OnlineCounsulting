@inherits LayoutComponentBase
@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using MudBlazor.Services
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@using OnlineConsulting.Maui.Shared.Infrastructure.Auth
@using OnlineConsulting.Maui.Shared.Infrastructure.Navigation
@using OnlineConsulting.Maui.Shared.Theme
@inject IAuthSession AuthSession
@inject IPlatformInfo PlatformInfo
@inject UiModuleRegistry ModuleRegistry
@inject AuthenticationExpiredNotifier ExpiredNotifier
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject IBrowserViewportService ViewportService

<AppThemeProvider Theme="AppTheme.Default" />
<BrandFavicon />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="0" Class="app-bar-elevated" Fixed="true">
                <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
                <BrandMark Class="ml-2" />
                <MudSpacer />
                <MudTooltip Text="View Website">
                    <MudIconButton Icon="@Icons.Material.Outlined.Storefront" Color="Color.Inherit" Href="/" Target="_blank" aria-label="View Website" />
                </MudTooltip>
                <CommandPaletteButton User="context.User" />
                <NotificationBell />
                <ThemeModeMenu />
                <UserAccountMenu User="context.User" />
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="@CurrentDrawerVariant" ClipMode="DrawerClipMode.Always"
                       Class="@DrawerCssClass">
                <NavDrawerMenu Sections="ModuleRegistry.NavSections" User="context.User" />
            </MudDrawer>

            <LiveUpdatesHost />
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.False" Class="pa-4 page-shell">
                    <PageBreadcrumbs />
                    @Body
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <div class="auth-shell">
            <div class="auth-brand">
                <BrandMark AvatarColor="Color.Surface" IconColor="Color.Primary" Class="auth-brand-mark" />

                <div class="auth-brand-body">
                    <MudText Typo="Typo.h1">Comfortable air, without the hassle.</MudText>
                    <MudText Typo="Typo.body1">
                        Sign in to book visits, follow your technician and keep your home's
                        heating and cooling in top shape.
                    </MudText>
                    <MudList T="string" Class="auth-brand-features">
                        <MudListItem T="string" Icon="@Icons.Material.Outlined.Check" Class="auth-feature-item">
                            Book and reschedule visits in a few taps
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Outlined.Check" Class="auth-feature-item">
                            Track every visit from scheduled to done
                        </MudListItem>
                        <MudListItem T="string" Icon="@Icons.Material.Outlined.Check" Class="auth-feature-item">
                            Membership perks, equipment history and invoices in one place
                        </MudListItem>
                    </MudList>
                    <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ArrowBack"
                               Class="mt-4">Back to website</MudButton>
                </div>

                <MudText Typo="Typo.caption" Class="auth-brand-footer">&copy; @DateTime.UtcNow.Year <BrandName /></MudText>
            </div>

            <div class="auth-panel">
                <div class="auth-mobile-hero">
                    <BrandMark AvatarColor="Color.Surface" IconColor="Color.Primary" Class="auth-brand-mark" />
                    <MudText Typo="Typo.body1">Comfortable air, without the hassle.</MudText>
                </div>
                @Body
                <MudButton Href="/" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Class="auth-mobile-back">Back to website</MudButton>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&times;</span>
</div>

@code {

    /// <summary>Shared shell for both hosts - AuthorizeView switches admin chrome vs. login panel;
    /// also owns the post-login welcome toast and per-platform drawer behavior.</summary>
    
    /// <summary>Mini is a persistent desktop icon-rail that just changes width when toggled - on a
    /// phone-sized viewport that resize is easy to miss entirely, which read as "the toggle button
    /// does nothing". Native mobile gets a real overlay drawer (Temporary) that opens/closes, closed
    /// by default so it doesn't cover content on first render.</summary>
    private bool _drawerOpen;
    private bool _compactViewport;
    private readonly Guid _viewportObserverId = Guid.NewGuid();

    /// <summary>Login redirects here with ?welcome=true - shown once, then stripped from the URL.</summary>
    protected override async Task OnInitializedAsync()
    {
        _compactViewport = PlatformInfo.IsNativeMobile;
        _drawerOpen = !_compactViewport;
        ExpiredNotifier.AuthenticationExpired += OnAuthenticationExpired;
        Navigation.LocationChanged += OnLocationChanged;

        if (Navigation.Uri.Contains("welcome=true", StringComparison.Ordinal))
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var firstName = authState.User.FindFirst(ClaimTypes.GivenName)?.Value;
            Snackbar.ShowSuccess(string.IsNullOrEmpty(firstName) ? "Welcome back!" : $"Welcome back, {firstName}!");
            Navigation.ClearQueryFlag("welcome");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !PlatformInfo.IsNativeMobile)
        {
            await ViewportService.SubscribeAsync(_viewportObserverId, OnViewportChanged,
                new ResizeOptions { NotifyOnBreakpointOnly = true }, fireImmediately: true);
        }
    }

    private void OnViewportChanged(BrowserViewportEventArgs args)
    {
        var compact = args.Breakpoint < Breakpoint.Md;
        if (compact == _compactViewport)
        {
            return;
        }

        _compactViewport = compact;
        _drawerOpen = !compact;
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_compactViewport && _drawerOpen)
        {
            _drawerOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnAuthenticationExpired() => InvokeAsync(() => AuthSession.SignOutAsync());

    public async ValueTask DisposeAsync()
    {
        ExpiredNotifier.AuthenticationExpired -= OnAuthenticationExpired;
        Navigation.LocationChanged -= OnLocationChanged;
        if (!PlatformInfo.IsNativeMobile)
        {
            try
            {
                await ViewportService.UnsubscribeAsync(_viewportObserverId);
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private DrawerVariant CurrentDrawerVariant => _compactViewport ? DrawerVariant.Temporary : DrawerVariant.Mini;

    // The overlay drawer intentionally does NOT reuse "nav-drawer" - that class carries
    // overflow-x:hidden and Mini-variant collapse rules for the Web desktop rail, which were
    // clipping/breaking the Temporary drawer's open/close transform on a phone-sized viewport.
    private string DrawerCssClass => _compactViewport
        ? "nav-drawer-mobile"
        : "nav-drawer" + (_drawerOpen ? "" : " nav-drawer-collapsed");

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
