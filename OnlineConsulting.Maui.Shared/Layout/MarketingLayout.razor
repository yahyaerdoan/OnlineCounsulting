@* Shell for public marketing pages - utility strip + sticky nav bar. Mobile nav is a full-screen overlay, not a dropdown. *@
@inherits LayoutComponentBase
@using OnlineConsulting.Maui.Shared.Theme
@using OnlineConsulting.Maui.Shared.Components.Marketing
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@using System.Security.Claims
@inject IApiClient ApiClient

<MudThemeProvider Theme="MarketingTheme.Default" />
<MudPopoverProvider />
<MudSnackbarProvider @rendermode="InteractiveServer" />
<MudDialogProvider />

<MudLayout Class="marketing-app-layout">
    <div class="marketing-top-bar">
        <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex justify-space-between align-center flex-wrap gap-2">
            <div class="d-flex align-center gap-4 flex-wrap">
                @if (_contact is not null)
                {
                    <a href="tel:@_contact.Phone" class="header-phone-cta">
                        <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />
                        <span class="header-phone-cta-text">24/7 Emergency Service &middot; <strong>@_contact.Phone</strong></span>
                    </a>
                    <MudLink Href="@($"mailto:{_contact.Email}")" Color="Color.Inherit" Underline="Underline.None" Class="marketing-top-bar-link">
                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-1" />
                        @_contact.Email
                    </MudLink>
                }
            </div>
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                @if (_socialLinks is { Count: > 0 })
                {
                    <MudStack Row="true" Spacing="0">
                        @foreach (var link in _socialLinks)
                        {
                            <MudIconButton Href="@link.Url" Target="_blank" Icon="@link.Icon" Size="Size.Small" Color="Color.Inherit" />
                        }
                    </MudStack>
                }
                <MudStack Row="true" Spacing="1" Class="marketing-login-register" AlignItems="AlignItems.Center">
                    <AuthorizeView>
                        <Authorized>
                            <MudLink Href="/user/dashboard" Color="Color.Inherit" Underline="Underline.None" Class="marketing-top-bar-link">@DisplayName(context.User)</MudLink>
                            <MudLink Href="@AppRoutes.Logout" Color="Color.Inherit" Underline="Underline.None" Class="marketing-top-bar-link">Sign out</MudLink>
                        </Authorized>
                        <NotAuthorized>
                            <MudLink Href="/login" Color="Color.Inherit" Underline="Underline.None" Class="marketing-top-bar-link">Login</MudLink>
                            <MudLink Href="/register" Color="Color.Inherit" Underline="Underline.None" Class="marketing-top-bar-link">Register</MudLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </MudStack>
            </MudStack>
        </MudContainer>
    </div>

    <div class="marketing-sticky-header">
        <MudAppBar Elevation="0" Fixed="false" Class="marketing-app-bar">
            @* Same MudContainer as .marketing-top-bar above - lines the logo/nav/CTA up with the
               utility strip and page content instead of a hand-matched CSS max-width. *@
            <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center" Style="width: 100%;">
                <MarketingBrandMark />
                <MudSpacer />
                <MudStack Row="true" Spacing="5" AlignItems="AlignItems.Center" Class="marketing-nav">
                    <NavLink href="/" Match="NavLinkMatch.All" class="marketing-nav-link">Home</NavLink>
                    <NavLink href="/about" class="marketing-nav-link">About</NavLink>
                    <NavLink href="/gallery" class="marketing-nav-link">Gallery</NavLink>
                    <NavLink href="/services" class="marketing-nav-link">Services</NavLink>
                    <NavLink href="/contact" class="marketing-nav-link">Contact</NavLink>
                    <NavLink href="/membership" class="marketing-nav-link">Membership</NavLink>
                    <NavLink href="/pricing" class="marketing-nav-link">Pricing</NavLink>
                </MudStack>
                <MudSpacer />
                <CartBadge Class="mr-4" />
                <MudLink Href="/appointment" Underline="Underline.None" Class="header-book-now-btn">Book Now</MudLink>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Class="marketing-nav-toggle"
                                aria-label="Toggle navigation" aria-expanded="false" />
            </MudContainer>
        </MudAppBar>

        <nav class="marketing-nav-mobile">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" Class="marketing-nav-close"
                            aria-label="Close navigation" />
            <NavLink href="/" Match="NavLinkMatch.All" class="marketing-nav-link">Home</NavLink>
            <NavLink href="/about" class="marketing-nav-link">About</NavLink>
            <NavLink href="/gallery" class="marketing-nav-link">Gallery</NavLink>
            <NavLink href="/services" class="marketing-nav-link">Services</NavLink>
            <NavLink href="/contact" class="marketing-nav-link">Contact</NavLink>
            <NavLink href="/appointment" class="marketing-nav-link">Appointment</NavLink>
            <NavLink href="/membership" class="marketing-nav-link">Membership</NavLink>
            <NavLink href="/pricing" class="marketing-nav-link">Pricing</NavLink>
            <CartBadge IconOnly="false" Class="marketing-nav-link" />
            <MudDivider Class="my-2" />
            <AuthorizeView>
                <Authorized>
                    <MudLink Href="/user/dashboard" Color="Color.Inherit" Underline="Underline.None" Class="marketing-nav-link">My Account</MudLink>
                    <MudLink Href="@AppRoutes.Logout" Color="Color.Inherit" Underline="Underline.None" Class="marketing-nav-link">Sign out</MudLink>
                </Authorized>
                <NotAuthorized>
                    <MudLink Href="/login" Color="Color.Inherit" Underline="Underline.None" Class="marketing-nav-link">Login</MudLink>
                    <MudLink Href="/register" Color="Color.Inherit" Underline="Underline.None" Class="marketing-nav-link">Register</MudLink>
                </NotAuthorized>
            </AuthorizeView>
            <MudLink Href="/appointment" Underline="Underline.None" Class="header-book-now-btn mt-3 justify-center">Book Now</MudLink>
        </nav>
    </div>
    <div class="marketing-sticky-header-spacer"></div>

    <MudMainContent Class="marketing-layout-main">
        @Body
    </MudMainContent>

    <MarketingFooter />
</MudLayout>

@code {
    private CompanyContactResponse? _contact;
    private List<SocialLinkResponse>? _socialLinks;

    protected override async Task OnInitializedAsync()
    {
        var contactResult = await ApiClient.GetAsync<CompanyContactResponse>(ApiRoutes.Inquiries.Contact.Get);
        _contact = contactResult.IsSuccessful ? contactResult.ResultData : null;

        var socialLinksResult = await ApiClient.GetAsync<List<SocialLinkResponse>>(ApiRoutes.SiteContent.SocialLink.Base);
        _socialLinks = socialLinksResult.IsSuccessful ? socialLinksResult.ResultData : null;
    }

    private static string? DisplayName(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.GivenName)?.Value is { Length: > 0 } firstName ? firstName : user.Identity?.Name;
}
