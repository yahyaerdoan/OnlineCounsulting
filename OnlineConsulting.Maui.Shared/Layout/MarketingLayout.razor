@* Shell for public marketing pages - one sticky nav bar (promotion strip above it). Phones navigate through the bottom tab bar
   and the Menu page instead of the footer: the native app skips it, narrow browsers hide it in CSS. *@
@inherits LayoutComponentBase
@using OnlineConsulting.Maui.Shared.Theme
@using OnlineConsulting.Maui.Shared.Components.Marketing
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@using System.Security.Claims
@inject IApiClient ApiClient
@inject IJSRuntime JsRuntime
@inject IPlatformInfo PlatformInfo
@inject IAuthSession AuthSession

<AppThemeProvider Theme="MarketingTheme.Default" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<MudLayout Class="marketing-app-layout has-bottom-nav">
    @if (PlatformInfo.IsNativeMobile)
    {
        <div class="status-bar-safe-area"></div>
    }
    <PromotionBanner />

    <div class="marketing-sticky-header">
        <MudAppBar Elevation="0" Fixed="false" Class="marketing-app-bar">
            <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center" Style="width: 100%;">
                <MarketingBrandMark />
                <MudSpacer />
                <MudStack Row="true" Spacing="5" AlignItems="AlignItems.Center" Class="marketing-nav">
                    <NavLink href="/services" class="marketing-nav-link">Services</NavLink>
                    <NavLink href="/membership" class="marketing-nav-link">Membership</NavLink>
                    <NavLink href="/gallery" class="marketing-nav-link">Our work</NavLink>
                    <NavLink href="/about" class="marketing-nav-link">About</NavLink>
                    <NavLink href="/contact" class="marketing-nav-link">Contact</NavLink>
                </MudStack>
                <MudSpacer />
                @if (_contact is { Phone.Length: > 0 })
                {
                    <MudTooltip Text="@($"24/7 emergency: {_contact.Phone}")">
                        <MudIconButton Href="@($"tel:{_contact.Phone}")" Icon="@Icons.Material.Outlined.Phone" Color="Color.Inherit"
                                       Class="hide-on-phone" aria-label="@($"Call {_contact.Phone}")" />
                    </MudTooltip>
                }
                <ThemeModeMenu Class="hide-on-phone" />
                <CartBadge Class="mx-2" />
                <AuthorizeView>
                    <Authorized>
                        <MudMenu Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight" aria-label="Your account" Class="mr-3 hide-on-phone">
                            <MudText Typo="Typo.subtitle2" Class="px-4 pt-2 pb-2">@DisplayName(context.User)</MudText>
                            <MudDivider />
                            <MudMenuItem Href="/user/dashboard" Icon="@Icons.Material.Outlined.Dashboard">Dashboard</MudMenuItem>
                            <MudMenuItem Href="/user/appointments" Icon="@Icons.Material.Outlined.CalendarMonth">My visits</MudMenuItem>
                            <MudMenuItem Href="/user/profile" Icon="@Icons.Material.Outlined.ManageAccounts">Profile</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem OnClick="@(() => AuthSession.SignOutAsync())" Icon="@Icons.Material.Outlined.Logout" IconColor="Color.Error">Sign out</MudMenuItem>
                        </MudMenu>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="/login" class="marketing-nav-link mr-4 hide-on-phone">Sign in</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
                <MudLink Href="/appointment" Underline="Underline.None" Class="header-book-now-btn hide-on-phone">Book Now</MudLink>
            </MudContainer>
        </MudAppBar>
    </div>
    <div class="marketing-sticky-header-spacer"></div>

    <MudMainContent Class="marketing-layout-main">
        @Body
    </MudMainContent>

    @if (!PlatformInfo.IsNativeMobile)
    {
        <MarketingFooter />
    }

    <MobileBottomNav />
</MudLayout>

@code {
    private CompanyContactResponse? _contact;

    protected override async Task OnInitializedAsync()
    {
        var contactResult = await ApiClient.GetAsync<CompanyContactResponse>(ApiRoutes.Inquiries.Contact.Get);
        _contact = contactResult.IsSuccessful ? contactResult.ResultData : null;
    }

    /// <summary>Re-binds marketing.js's scroll handlers after every render, not just DOMContentLoaded/enhancedload - neither fires reliably in BlazorWebView.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await JsRuntime.InvokeVoidAsync("initMarketingNav");

    private static string DisplayName(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.GivenName)?.Value is { Length: > 0 } firstName ? firstName : user.Identity?.Name ?? "Your account";
}
