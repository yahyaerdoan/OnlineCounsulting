@implements IDisposable
@using OnlineConsulting.Maui.Shared.Infrastructure.Navigation
@inject BreadcrumbState Breadcrumb

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    protected override void OnParametersSet() => Breadcrumb.Set(Text);

    // Only clear if we still own the value - avoids wiping a newer page's segment.
    public void Dispose()
    {
        if (Breadcrumb.ExtraSegment == Text)
        {
            Breadcrumb.Set(null);
        }
    }
}
