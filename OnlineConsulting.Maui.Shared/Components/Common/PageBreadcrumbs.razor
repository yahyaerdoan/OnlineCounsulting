@implements IDisposable
@using OnlineConsulting.Maui.Shared.Infrastructure.Navigation
@using OnlineConsulting.Maui.Shared.Layout
@inject NavigationManager Navigation
@inject UiModuleRegistry ModuleRegistry
@inject BreadcrumbState Breadcrumb

<MudBreadcrumbs Items="@_trail" Class="pa-0 mb-2 page-breadcrumbs">
    <SeparatorTemplate>
        <MudIcon Icon="@Icons.Material.Outlined.ArrowForward" Size="Size.Small" />
    </SeparatorTemplate>
</MudBreadcrumbs>

@code {
    private List<BreadcrumbItem> _trail = [];

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Breadcrumb.Changed += OnBreadcrumbStateChanged;
        BuildTrail();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Clear before rebuilding - the outgoing page's extra segment must not flash on the new route.
        Breadcrumb.Set(null);
        BuildTrail();
        InvokeAsync(StateHasChanged);
    }

    private void OnBreadcrumbStateChanged()
    {
        BuildTrail();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Derives "Home / Section / Page[ / Sub-page]" from the same NavSection data as the
    /// drawer, matched by longest href prefix so routed sub-pages (create/edit forms, drill-downs)
    /// inherit their parent NavItem's trail; PageBreadcrumbExtra supplies the trailing segment.</summary>
    private void BuildTrail()
    {
        var currentHref = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        var isHome = string.Equals(currentHref, AppRoutes.AdminHome, StringComparison.OrdinalIgnoreCase);

        var trail = new List<BreadcrumbItem>
        {
            new("Home", href: AppRoutes.AdminHome, disabled: isHome),
        };

        var match = ModuleRegistry.NavSections
            .SelectMany(section => section.Items.Select(item => (section, item)))
            .Where(pair => string.Equals(pair.item.Href, currentHref, StringComparison.OrdinalIgnoreCase)
                || currentHref.StartsWith(pair.item.Href + "/", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(pair => pair.item.Href.Length)
            .FirstOrDefault();

        if (match.item is not null)
        {
            var isCurrentPage = string.Equals(match.item.Href, currentHref, StringComparison.OrdinalIgnoreCase);
            trail.Add(new BreadcrumbItem(match.section.Title, href: null, disabled: true));
            trail.Add(new BreadcrumbItem(match.item.Text, href: match.item.Href, disabled: isCurrentPage));

            if (!isCurrentPage && Breadcrumb.ExtraSegment is { } extra)
            {
                trail.Add(new BreadcrumbItem(extra, href: null, disabled: true));
            }
        }

        _trail = trail;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Breadcrumb.Changed -= OnBreadcrumbStateChanged;
    }
}
