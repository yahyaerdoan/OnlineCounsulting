@typeparam TItem where TItem : IQueryableFields
@inject IApiClient ApiClient

@* Generic paginated/searchable/sortable MudTable wrapper - reuse for every admin list screen. Below 960px each row becomes a card
   (label/value lines, actions along the bottom), styled by .admin-table in app.css. *@
<MudTable @ref="_table" ServerData="ServerReloadAsync" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="@($"admin-table {Class}")">
    <ToolBarContent>
        <MudSpacer />
        @if (ServerSearch || TItem.SearchFields.Length > 0)
        {
            <MudTextField T="string" ValueChanged="OnSearch" Immediate="true" DebounceInterval="300" Margin="Margin.Dense" Class="admin-table-search"
                          Placeholder="@SearchPlaceholder" Adornment="Adornment.Start" Clearable="true"
                          AdornmentIcon="@Icons.Material.Outlined.Search" IconSize="Size.Small" />
        }
        @ToolbarContent
    </ToolBarContent>
    <HeaderContent>@HeaderContent</HeaderContent>
    <RowTemplate>@RowTemplate(context)</RowTemplate>
    <NoRecordsContent>
        @if (NoRecordsContent is not null)
        {
            @NoRecordsContent
        }
        else
        {
            <MudText>No matching records found.</MudText>
        }
    </NoRecordsContent>
    <LoadingContent>
        @if (LoadingContent is not null)
        {
            @LoadingContent
        }
        else
        {
            <MudText>Loading...</MudText>
        }
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    [Parameter, EditorRequired]
    public string ApiBasePath { get; set; } = default!;

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    [Parameter, EditorRequired]
    public RenderFragment HeaderContent { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    [Parameter]
    public RenderFragment? ToolbarContent { get; set; }

    [Parameter]
    public RenderFragment? NoRecordsContent { get; set; }

    [Parameter]
    public RenderFragment? LoadingContent { get; set; }

    [Parameter]
    public string Class { get; set; } = "mt-2";

    /// <summary>Sends the search box text as ?search= for the endpoint to match (e.g. joined names), instead of a DynamicQuery filter on SearchFields.</summary>
    [Parameter]
    public bool ServerSearch { get; set; }

    /// <summary>Extra query string (e.g. "&amp;view=Ending"), read on every load so a filter tab can change it and call RefilterAsync.</summary>
    [Parameter]
    public Func<string?>? ExtraQuery { get; set; }

    /// <summary>Fires with the failure message - the page decides how to display it.</summary>
    [Parameter]
    public EventCallback<string> OnLoadError { get; set; }

    private MudTable<TItem> _table = default!;
    private string? _searchText;

    /// <summary>Call after any mutation (create/update/delete) so the current page re-fetches.</summary>
    public Task ReloadAsync() => _table.ReloadServerData();

    /// <summary>Call after a filter changes: back to the first page, then re-fetch.</summary>
    public async Task RefilterAsync()
    {
        if (_table.CurrentPage != 0)
        {
            _table.NavigateTo(0);
        }

        await _table.ReloadServerData();
    }

    private async Task<TableData<TItem>> ServerReloadAsync(TableState state, CancellationToken cancellationToken)
    {
        var route = ApiRoutes.Paged(ApiBasePath, state.Page, state.PageSize);
        if (ServerSearch && !string.IsNullOrWhiteSpace(_searchText))
        {
            route += $"&search={Uri.EscapeDataString(_searchText.Trim())}";
        }

        if (ExtraQuery?.Invoke() is { Length: > 0 } extra)
        {
            route += extra;
        }

        var result = await ApiClient.QueryAsync<PaginatedResponse<TItem>>(route, BuildDynamicQuery(state), cancellationToken);

        if (!result.IsSuccessful || result.ResultData is null)
        {
            await OnLoadError.InvokeAsync(result.DisplayMessage);
            return new TableData<TItem> { TotalItems = 0, Items = [] };
        }

        return new TableData<TItem> { TotalItems = result.ResultData.Count, Items = result.ResultData.Items };
    }

    private DynamicQuery? BuildDynamicQuery(TableState state)
    {
        List<DynamicSort>? sort = string.IsNullOrEmpty(state.SortLabel)
            ? null
            : [new DynamicSort(state.SortLabel, state.SortDirection == SortDirection.Descending ? "desc" : "asc")];

        var filter = ServerSearch || string.IsNullOrWhiteSpace(_searchText) || TItem.SearchFields.Length == 0
            ? null
            : BuildSearchFilter(TItem.SearchFields, _searchText);

        return sort is null && filter is null ? null : new DynamicQuery(sort, filter);
    }

    /// <summary>Root filter needs its own Field/Operator too - see DynamicQuery.cs.</summary>
    private static DynamicFilter BuildSearchFilter(string[] fields, string search)
    {
        var root = new DynamicFilter(fields[0], "contains", search);
        return fields.Length == 1
            ? root
            : root with { Logic = "or", Filters = [.. fields.Skip(1).Select(f => new DynamicFilter(f, "contains", search))] };
    }

    private Task OnSearch(string? text)
    {
        _searchText = text;
        return RefilterAsync();
    }
}
