@typeparam TItem

@* Same toolbar/search UX and .admin-table styling as ServerDataTable (cards below 960px), but filters an already-fetched flat list in-memory. *@
<MudTable Items="@_filteredItems" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="@($"admin-table {Class}")">
    <ToolBarContent>
        <MudSpacer />
        <MudTextField T="string" ValueChanged="OnSearch" Immediate="true" DebounceInterval="300" Margin="Margin.Dense" Class="admin-table-search"
                      Placeholder="@SearchPlaceholder" Adornment="Adornment.Start" Clearable="true"
                      AdornmentIcon="@Icons.Material.Outlined.Search" IconSize="Size.Small" />
        @ToolbarContent
    </ToolBarContent>
    <HeaderContent>@HeaderContent</HeaderContent>
    <RowTemplate>@RowTemplate(context)</RowTemplate>
    <NoRecordsContent>
        @if (NoRecordsContent is not null)
        {
            @NoRecordsContent
        }
        else
        {
            <MudText>No matching records found.</MudText>
        }
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    /// <summary>Case-insensitive match against whichever fields the caller wants searchable.</summary>
    [Parameter, EditorRequired]
    public Func<TItem, string, bool> Filter { get; set; } = default!;

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search";

    [Parameter, EditorRequired]
    public RenderFragment HeaderContent { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowTemplate { get; set; } = default!;

    [Parameter]
    public RenderFragment? ToolbarContent { get; set; }

    [Parameter]
    public RenderFragment? NoRecordsContent { get; set; }

    [Parameter]
    public string Class { get; set; } = "mt-2";

    private string? _searchText;

    private IEnumerable<TItem> _filteredItems =>
        _searchText is { } text && !string.IsNullOrWhiteSpace(text) ? Items.Where(item => Filter(item, text)) : Items;

    private void OnSearch(string text) => _searchText = text;
}
