<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="@Class">
    <MudAvatar Color="@AvatarColor" Variant="Variant.Filled" Size="Size.Small">
        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Color="@IconColor" />
    </MudAvatar>
    <MudText Typo="Typo.h6" Color="@TextColor" Class="text-strong">ComfortPro</MudText>
</MudStack>

@code {
    [Parameter]
    public Color AvatarColor { get; set; } = Color.Primary;

    [Parameter]
    public Color IconColor { get; set; } = Color.Inherit;

    [Parameter]
    public Color TextColor { get; set; } = Color.Inherit;

    [Parameter]
    public string? Class { get; set; }
}
