@* Sends a user to the dashboard when the page belongs to a nav item hidden from them; same rule as the sidebar. *@
@using System.Security.Claims
@using OnlineConsulting.Maui.Shared.Layout
@inject NavigationManager Navigation
@inject UiModuleRegistry ModuleRegistry

@if (_allowed)
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired]
    public ClaimsPrincipal User { get; set; } = new();

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _allowed = true;

    // Runs on every navigation: the layout re-renders with the new page as ChildContent.
    protected override void OnParametersSet()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        _allowed = ModuleRegistry.NavSections.CanOpen(path, User);
        if (!_allowed)
        {
            Navigation.NavigateTo(AppRoutes.AdminHome, replace: true);
        }
    }
}
