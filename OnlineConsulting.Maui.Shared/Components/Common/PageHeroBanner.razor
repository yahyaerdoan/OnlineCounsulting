<MudPaper Class="dash-hero mb-4" Elevation="0">
    <MudText Typo="Typo.h5" Class="mb-1 hero-title">@Title</MudText>
    <MudText Typo="Typo.body2" Class="hero-subtitle">@Subtitle</MudText>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Subtitle { get; set; } = string.Empty;
}
