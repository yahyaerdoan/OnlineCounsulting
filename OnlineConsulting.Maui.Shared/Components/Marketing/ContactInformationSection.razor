@* Contact details card - description + address/email/phone + working hours, from the company contact record the page loads. *@

@if (Contact is { } contact)
{
    <div class="contact-form">
        <MudText Typo="Typo.h5" Class="marketing-display mb-1">Contact details</MudText>
        @if (!string.IsNullOrWhiteSpace(contact.Description))
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@contact.Description</MudText>
        }

        <MudStack Spacing="3">
            @foreach (var (icon, label, value, href) in RowsFor(contact))
            {
                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                    <div class="contact-info-icon">
                        <MudIcon Icon="@icon" Color="Color.Primary" Size="Size.Small" />
                    </div>
                    <MudStack Spacing="0" Class="min-w-0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@label</MudText>
                        @if (href is not null)
                        {
                            <MudLink Href="@href" Target="@(href.StartsWith("http", StringComparison.Ordinal) ? "_blank" : null)" Typo="Typo.body2" Class="contact-info-link">@value</MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@value</MudText>
                        }
                    </MudStack>
                </MudStack>
            }
        </MudStack>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public CompanyContactResponse? Contact { get; set; }

    private static IEnumerable<(string Icon, string Label, string Value, string? Href)> RowsFor(CompanyContactResponse contact) =>
    [
        (Icons.Material.Filled.Home, "Address", contact.Address, ContactLinks.Directions(contact.Address)),
        (Icons.Material.Filled.Email, "Email", contact.Email, $"mailto:{contact.Email}"),
        (Icons.Material.Filled.Phone, "Phone", contact.Phone, $"tel:{contact.Phone}"),
        (Icons.Material.Filled.AccessTime, "Working hours", contact.WorkingHours, null),
    ];
}
