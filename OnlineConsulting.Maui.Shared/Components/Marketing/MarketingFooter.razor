@* Wide-screen footer; hidden on phones, where the Menu page carries the social links, newsletter and "For businesses" card.
   Opens with one entry card per audience (homeowners, businesses, technicians/staff), then link columns grouped the same way. *@
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@using OnlineConsulting.Maui.Shared.Layout
@inject IApiClient ApiClient
@inject SiteBrand Brand

<footer class="marketing-footer">
    <MudContainer MaxWidth="MaxWidth.Large" Class="pt-8">
        <div class="footer-audiences">
            <a href="/appointment" class="footer-audience footer-audience-home">
                <span class="footer-audience-icon"><MudIcon Icon="@Icons.Material.Outlined.Home" /></span>
                <span class="footer-audience-text">
                    <span class="footer-audience-eyebrow">For Homeowners</span>
                    <span class="footer-audience-title">Book a visit in a few taps</span>
                    <span class="footer-audience-cta">Book now<MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></span>
                </span>
            </a>
            <a href="@Brand.PlatformLink("/pricing")" class="footer-audience footer-audience-business">
                <span class="footer-audience-icon"><MudIcon Icon="@Icons.Material.Outlined.RocketLaunch" /></span>
                <span class="footer-audience-text">
                    <span class="footer-audience-eyebrow">For Businesses</span>
                    <span class="footer-audience-title">Get your own booking app</span>
                    <span class="footer-audience-cta">See plans and pricing<MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></span>
                </span>
            </a>
            <AuthorizeView Roles="@StaffRoles">
                <Authorized>
                    <a href="@AppRoutes.AdminHome" class="footer-audience footer-audience-team">
                        <span class="footer-audience-icon"><MudIcon Icon="@Icons.Material.Outlined.Engineering" /></span>
                        <span class="footer-audience-text">
                            <span class="footer-audience-eyebrow">For Technicians &amp; Staff</span>
                            <span class="footer-audience-title">Your jobs and schedule</span>
                            <span class="footer-audience-cta">Open dashboard<MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></span>
                        </span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="@StaffLoginUrl" class="footer-audience footer-audience-team">
                        <span class="footer-audience-icon"><MudIcon Icon="@Icons.Material.Outlined.Engineering" /></span>
                        <span class="footer-audience-text">
                            <span class="footer-audience-eyebrow">For Technicians &amp; Staff</span>
                            <span class="footer-audience-title">See today's jobs and schedule</span>
                            <span class="footer-audience-cta">Team sign in<MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></span>
                        </span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </MudContainer>

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <div class="footer-columns">
            <div class="footer-brand">
                <div class="footer-brand-about">
                    <MarketingBrandMark />
                    @foreach (var info in _footerInfos)
                    {
                        <p class="footer-brand-desc">@info.Description</p>
                    }
                </div>

                <ul class="footer-reach">
                    @if (!string.IsNullOrWhiteSpace(_contact?.Phone))
                    {
                        <li>
                            <a href="@($"tel:{_contact.Phone}")" class="footer-reach-item">
                                <span class="footer-reach-icon"><MudIcon Icon="@Icons.Material.Outlined.Phone" Size="Size.Small" /></span>
                                <span class="footer-reach-text"><span class="footer-reach-label">Call us</span><span class="footer-reach-value">@_contact.Phone</span></span>
                            </a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(_contact?.Email))
                    {
                        <li>
                            <a href="@($"mailto:{_contact.Email}")" class="footer-reach-item">
                                <span class="footer-reach-icon"><MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" /></span>
                                <span class="footer-reach-text"><span class="footer-reach-label">Email us</span><span class="footer-reach-value">@_contact.Email</span></span>
                            </a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(_contact?.WorkingHours))
                    {
                        <li>
                            <a href="/contact" class="footer-reach-item">
                                <span class="footer-reach-icon"><MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Small" /></span>
                                <span class="footer-reach-text"><span class="footer-reach-label">Working hours</span><span class="footer-reach-value">@_contact.WorkingHours</span></span>
                            </a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(_contact?.Address))
                    {
                        <li>
                            <a href="@($"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(_contact.Address)}")" target="_blank" rel="noopener" class="footer-reach-item">
                                <span class="footer-reach-icon"><MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" /></span>
                                <span class="footer-reach-text"><span class="footer-reach-label">Address</span><span class="footer-reach-value">@_contact.Address</span></span>
                            </a>
                        </li>
                    }
                    @if (_socialLinks is { Count: > 0 })
                    {
                        <li>
                            <div class="footer-reach-item">
                                <span class="footer-reach-icon"><MudIcon Icon="@Icons.Material.Outlined.Share" Size="Size.Small" /></span>
                                <span class="footer-reach-text">
                                    <span class="footer-reach-label">Follow us</span>
                                    <span class="footer-reach-social">
                                        @foreach (var link in _socialLinks)
                                        {
                                            <MudTooltip Text="@link.Name">
                                                <a href="@link.Url" target="_blank" rel="noopener" aria-label="@link.Name" class="@($"footer-reach-social-link social-brand {SocialBrand.ClassFor(link)}")"
                                                   style="@SocialBrand.StyleFor(link)"><MudIcon Icon="@link.Icon" Size="Size.Small" /></a>
                                            </MudTooltip>
                                        }
                                    </span>
                                </span>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <nav class="footer-links" aria-label="For homeowners">
                <span class="marketing-footer-heading">Homeowners</span>
                <a href="/services">Services</a>
                <a href="/appointment">Book a visit</a>
                <a href="/membership">Membership</a>
                <a href="/gallery">Our work</a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/user/dashboard">My account</a>
                        <a href="/user/appointments">My visits</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login">Sign in</a>
                        <a href="/register">Create account</a>
                    </NotAuthorized>
                </AuthorizeView>
                @if (_popularServices.Count > 0)
                {
                    <div class="footer-popular">
                        <span class="footer-popular-head"><MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Size="Size.Small" />Popular</span>
                        @foreach (var service in _popularServices)
                        {
                            <a href="@($"/services/{service.Slug}")" class="@($"footer-popular-item {AccentTone.For(service.CategoryId)}")">
                                <span class="footer-popular-icon">
                                    <MudIcon Icon="@(service.Kind == ServiceKinds.Product ? Icons.Material.Outlined.Inventory2 : Icons.Material.Outlined.HomeRepairService)" Size="Size.Small" />
                                </span>
                                <span class="footer-popular-text">
                                    <span class="footer-popular-title">@service.Title</span>
                                    <span class="footer-popular-price">@ServicePriceFormat.Display(service)</span>
                                </span>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="footer-popular-chevron" />
                            </a>
                        }
                        <a href="/services" class="footer-popular-all">All services<MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
                    </div>
                }
            </nav>

            @if (Brand.IsPlatform)
            {
                <nav class="footer-links" aria-label="For businesses">
                    <span class="marketing-footer-heading">Businesses</span>
                    <a href="/pricing">Plans &amp; pricing</a>
                    <a href="/pricing#build">Build your own plan</a>
                    <a href="/signup">Sign up your business</a>
                    <a href="/contact">Talk to us</a>
                    <a href="/about">About us</a>
                </nav>
            }

            <nav class="footer-links" aria-label="For technicians and staff">
                <span class="marketing-footer-heading">Team</span>
                <AuthorizeView Roles="@StaffRoles">
                    <Authorized>
                        <a href="@AppRoutes.AdminHome">Dashboard</a>
                        <a href="@($"{AppRoutes.AdminHome}/operations/appointments")">Appointments &amp; jobs</a>
                        <a href="/notifications">Notifications</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="@StaffLoginUrl">Team sign in</a>
                        <a href="/forgot-password">Forgot password</a>
                    </NotAuthorized>
                </AuthorizeView>
                <a href="/contact">Help &amp; support</a>
            </nav>

            <div class="footer-newsletter">
                <span class="marketing-footer-heading">Newsletter</span>
                <MudText Typo="Typo.body2" Class="mb-2">Seasonal maintenance tips and offers, straight to your inbox.</MudText>
                <NewsletterForm FormName="footer-newsletter" />
            </div>
        </div>
    </MudContainer>

    <div class="footer-bottom">
        <MudContainer MaxWidth="MaxWidth.Large" Class="footer-bottom-inner">
            <span>&copy; 2024&ndash;@DateTime.UtcNow.Year <BrandName />. All rights reserved.</span>
            <span>Developed by <a href="/">Fluent IT Innovator Solutions</a></span>
        </MudContainer>
    </div>
</footer>

@code {
    private const string StaffRoles = "Admin,Super Admin,Member";
    private const int PopularCount = 3;
    private const int PopularCandidates = 24;

    private static readonly string StaffLoginUrl = $"{AppRoutes.Login}?ReturnUrl={Uri.EscapeDataString(AppRoutes.AdminHome)}";

    private List<FooterInfoResponse> _footerInfos = [];
    private List<SocialLinkResponse>? _socialLinks;
    private CompanyContactResponse? _contact;
    private List<ServiceResponse> _popularServices = [];

    protected override async Task OnInitializedAsync()
    {
        await Brand.EnsureLoadedAsync();
        var footerInfoResult = await ApiClient.GetAsync<List<FooterInfoResponse>>(ApiRoutes.SiteContent.FooterInfo.Base);
        _footerInfos = footerInfoResult.IsSuccessful ? footerInfoResult.ResultData ?? [] : [];

        var socialLinksResult = await ApiClient.GetAsync<List<SocialLinkResponse>>(ApiRoutes.SiteContent.SocialLink.Base);
        _socialLinks = socialLinksResult.IsSuccessful ? socialLinksResult.ResultData : null;

        var contactResult = await ApiClient.GetAsync<CompanyContactResponse>(ApiRoutes.Inquiries.Contact.Get);
        _contact = contactResult.IsSuccessful ? contactResult.ResultData : null;

        var servicesResult = await ApiClient.GetAsync<PaginatedResponse<ServiceResponse>>(ApiRoutes.Paged(ApiRoutes.Services.Base, 0, PopularCandidates));
        var services = servicesResult.IsSuccessful ? servicesResult.ResultData?.Items ?? [] : [];
        _popularServices = [.. services.OrderByDescending(s => s.FeaturedArea).Take(PopularCount)];
    }
}
