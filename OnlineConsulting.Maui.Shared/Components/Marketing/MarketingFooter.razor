@* Mirrors the legacy footer (UserInterface's LayoutFooterTopArea* ViewComponents) - newsletter form
   posts for real to Inquiries.Newsletter.Subscribe, unlike the legacy action="#". *@
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@inject IApiClient ApiClient
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.False" Class="marketing-footer pa-0">
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <MudGrid Spacing="6">
            <MudItem xs="12" md="4">
                <MarketingBrandMark />
                @foreach (var info in _footerInfos)
                {
                    <MudText Typo="Typo.body2" Class="mt-3">@info.Description</MudText>
                }
                <MudStack Spacing="1" Class="mt-3">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Proudly serving the greater metro area</MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Mon&ndash;Sat: 7am&ndash;8pm &bull; 24/7 Emergency Line</MudText>
                    </MudStack>
                </MudStack>
                @if (_socialLinks is { Count: > 0 })
                {
                    <MudStack Row="true" Spacing="1" Class="mt-3">
                        @foreach (var link in _socialLinks)
                        {
                            <MudIconButton Href="@link.Url" Target="_blank" Icon="@link.Icon"
                                           Size="Size.Small" Color="Color.Inherit" />
                        }
                    </MudStack>
                }
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudText Typo="Typo.subtitle1" Class="marketing-display marketing-footer-heading mb-2">Quick Links</MudText>
                <MudStack Spacing="1">
                    <MudLink Href="/" Color="Color.Inherit">Home</MudLink>
                    <MudLink Href="/about" Color="Color.Inherit">About Us</MudLink>
                    <MudLink Href="/gallery" Color="Color.Inherit">Gallery</MudLink>
                    <MudLink Href="/services" Color="Color.Inherit">Services</MudLink>
                    <MudLink Href="/contact" Color="Color.Inherit">Contact</MudLink>
                    <MudLink Href="/login" Color="Color.Inherit">Login</MudLink>
                </MudStack>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle1" Class="marketing-display marketing-footer-heading mb-2">Popular Services</MudText>
                <MudStack Spacing="3">
                    @foreach (var service in _popularServices)
                    {
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudImage Src="@_imageUrlsByServiceId.GetValueOrDefault(service.Id)" ObjectFit="ObjectFit.Cover"
                                      Width="66" Height="66" Class="rounded flex-shrink-0" />
                            <div>
                                <MudLink Href="@($"/services/{service.Slug}")" Color="Color.Inherit" Typo="Typo.body2" Class="d-block footer-course-title">@service.Title</MudLink>
                                <MudText Typo="Typo.caption" Class="d-block mt-1">Price: @CurrencyFormat.Format(service.DiscountedPrice)</MudText>
                            </div>
                        </MudStack>
                    }
                </MudStack>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.subtitle1" Class="marketing-display marketing-footer-heading mb-2">Newsletter</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">Enter your email and we'll send you more information of.</MudText>
                <EditForm Model="_newsletterModel" method="post" FormName="marketing-newsletter" OnValidSubmit="SubscribeAsync">
                    <div class="newsletter-input-box">
                        <InputText @bind-Value="_newsletterModel.Email" name="email" class="newsletter-input" placeholder="Your email address" />
                        <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Send" Size="Size.Small"
                                       Class="newsletter-button" Disabled="@_isSubscribing" />
                    </div>
                </EditForm>
            </MudItem>
        </MudGrid>
    </MudContainer>

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
        <MudStack Row="true" Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2">&copy; All rights reserved 2024 - @DateTime.UtcNow.Year</MudText>
            <MudLink Href="/" Color="Color.Inherit" Class="d-flex align-center" Style="text-decoration:none;">
                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Primary" Class="mx-1" />
                <MudText Typo="Typo.body2" Class="mr-1 text-strong">Comfort</MudText>
                <MudText Typo="Typo.body2">Pro</MudText>
            </MudLink>
            <MudText Typo="Typo.body2">&#9829; Developed by</MudText>
            <MudLink Href="/" Color="Color.Inherit">Fluent IT Innovator Solutions</MudLink>
        </MudStack>
    </MudContainer>
</MudContainer>

@code {
    private List<FooterInfoResponse> _footerInfos = [];
    private List<SocialLinkResponse>? _socialLinks;
    private List<ServiceResponse> _popularServices = [];
    private Dictionary<Guid, string?> _imageUrlsByServiceId = [];
    private bool _isSubscribing;

    [SupplyParameterFromForm]
    private NewsletterModel _newsletterModel { get => field ??= new(); set; }

    protected override async Task OnInitializedAsync()
    {
        var footerInfoResult = await ApiClient.GetAsync<List<FooterInfoResponse>>(ApiRoutes.SiteContent.FooterInfo.Base);
        _footerInfos = footerInfoResult.IsSuccessful ? footerInfoResult.ResultData ?? [] : [];

        var socialLinksResult = await ApiClient.GetAsync<List<SocialLinkResponse>>(ApiRoutes.SiteContent.SocialLink.Base);
        _socialLinks = socialLinksResult.IsSuccessful ? socialLinksResult.ResultData : null;

        await LoadPopularServicesAsync();
    }

    /// <summary>Mirrors the legacy site's LayoutFooterTopAreaBlock3ViewComponentPartial exactly:
    /// first catalog page capped to 3, then only the entries that actually have a cover image.</summary>
    private async Task LoadPopularServicesAsync()
    {
        var pagedResult = await ApiClient.GetAsync<PaginatedResponse<ServiceResponse>>(ApiRoutes.Paged(ApiRoutes.Services.Base, 0, 3));
        var page = pagedResult.IsSuccessful ? pagedResult.ResultData?.Items ?? [] : [];

        _popularServices = [.. page.Where(s => s.CoverMediaAssetId is not null)];

        var lookups = await Task.WhenAll(_popularServices.Select(async service =>
            (service.Id, Url: service.CoverMediaAssetId is Guid mediaId ? await MediaUploadHelper.GetUrlAsync(ApiClient, mediaId) : null)));

        _imageUrlsByServiceId = lookups.ToDictionary(l => l.Id, l => l.Url);
    }

    private async Task SubscribeAsync()
    {
        _isSubscribing = true;

        var result = await ApiClient.PostAsync(ApiRoutes.Inquiries.Newsletter.Subscribe, new { email = _newsletterModel.Email });

        _isSubscribing = false;

        Snackbar.Add(result.DisplayMessage, result.IsSuccessful ? Severity.Success : Severity.Error);

        if (result.IsSuccessful)
        {
            _newsletterModel.Email = string.Empty;
        }

        StateHasChanged();
    }

    private sealed class NewsletterModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
