@* Current offers as coupon tickets: a colored stub on the left, then the title, what you get, how long it lasts (a countdown
   that turns red in the last three days) and a claim button. A grid on wide screens, swipeable cards on phones. Always fully
   visible, never collapsed; hidden entirely when there are no active promotions. On the home page this replaces the slim
   promotion strip at every width. *@
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@inject IApiClient ApiClient

@if (_promotions.Count > 0)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="marketing-section-tight">
        <SectionHeading Eyebrow="Special Offers" Title="Current Promotions" Lead="Limited-time savings on the services homeowners book most." />

        <div class="@($"promos {(_promotions.Count == 1 ? "promos-single" : "")}")" role="list">
            @for (var i = 0; i < _promotions.Count; i++)
            {
                var promotion = _promotions[i];
                var daysLeft = promotion.ExpiresAt is { } expires ? (int)Math.Ceiling((expires - DateTimeOffset.UtcNow).TotalDays) : (int?)null;
                <article class="@($"promo {AccentTone.At(i)}")" role="listitem">
                    <div class="promo-stub" aria-hidden="true">
                        <span class="promo-stub-icon"><MudIcon Icon="@Icons.Material.Outlined.LocalOffer" /></span>
                        <span class="promo-stub-label">Offer</span>
                    </div>
                    <div class="promo-body">
                        @if (promotion.ExpiresAt is { } ends && daysLeft is { } days)
                        {
                            <span class="@($"promo-expiry {(days <= UrgentDays ? "urgent" : "")}")" title="@($"Ends {BusinessTime.Format(ends, "MMMM d, yyyy")}")">
                                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />@ExpiryText(ends, days)
                            </span>
                        }
                        <h3 class="promo-title">@promotion.Title</h3>
                        <p class="promo-desc">@promotion.Description</p>
                        <div class="promo-actions">
                            <MudButton Href="@(string.IsNullOrWhiteSpace(promotion.CtaUrl) ? "/appointment" : promotion.CtaUrl)" Variant="Variant.Filled"
                                       Class="sell-btn promo-cta" EndIcon="@Icons.Material.Filled.ArrowForward">
                                @(string.IsNullOrWhiteSpace(promotion.CtaText) ? "Claim offer" : promotion.CtaText)
                            </MudButton>
                        </div>
                    </div>
                </article>
            }
        </div>
    </MudContainer>
}

@code {
    private const int UrgentDays = 3;

    private List<PromotionResponse> _promotions = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiClient.GetAsync<List<PromotionResponse>>(ApiRoutes.Growth.Promotions.Base);
        var all = result.IsSuccessful ? result.ResultData ?? [] : [];
        _promotions = [.. all.Where(p => p.ExpiresAt is null || p.ExpiresAt > DateTimeOffset.UtcNow)
            .OrderBy(p => p.DisplayOrder)];
    }

    private string ExpiryText(DateTimeOffset ends, int daysLeft) => daysLeft switch
    {
        <= 1 when DateOnly.FromDateTime(BusinessTime.ToLocal(ends).DateTime) == BusinessTime.Today => "Ends today",
        <= 1 => "Ends tomorrow",
        <= 7 => $"{daysLeft} days left",
        _ => $"Ends {BusinessTime.Format(ends, "MMM d")}",
    };
}
