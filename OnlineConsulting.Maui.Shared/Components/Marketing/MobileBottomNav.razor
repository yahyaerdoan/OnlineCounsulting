@* Thumb-reachable tab bar for customer pages on phone-sized screens (web and native); CSS hides it on wide screens.
   The center tab is the primary action (booking, or signup on the platform's own site), the last one opens the Menu hub. *@
@inject SiteBrand Brand

<nav class="mobile-bottom-nav" aria-label="Main">
    <NavLink href="/" Match="NavLinkMatch.All" class="mobile-bottom-nav-item">
        <MudIcon Icon="@Icons.Material.Outlined.Home" />
        <span>Home</span>
    </NavLink>
    @if (Brand.IsPlatform)
    {
        <NavLink href="/pricing" class="mobile-bottom-nav-item">
            <MudIcon Icon="@Icons.Material.Outlined.Sell" />
            <span>Pricing</span>
        </NavLink>
        <NavLink href="/signup" class="mobile-bottom-nav-item mobile-bottom-nav-primary">
            <span class="mobile-bottom-nav-primary-icon"><MudIcon Icon="@Icons.Material.Filled.RocketLaunch" /></span>
            <span>Start</span>
        </NavLink>
        <NavLink href="/contact" class="mobile-bottom-nav-item">
            <MudIcon Icon="@Icons.Material.Outlined.Forum" />
            <span>Contact</span>
        </NavLink>
    }
    else
    {
        <NavLink href="/services" class="mobile-bottom-nav-item">
            <MudIcon Icon="@Icons.Material.Outlined.HomeRepairService" />
            <span>Services</span>
        </NavLink>
        <NavLink href="/appointment" class="mobile-bottom-nav-item mobile-bottom-nav-primary">
            <span class="mobile-bottom-nav-primary-icon"><MudIcon Icon="@Icons.Material.Filled.Add" /></span>
            <span>Book</span>
        </NavLink>
        <NavLink href="/user/appointments" class="mobile-bottom-nav-item">
            <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" />
            <span>Visits</span>
        </NavLink>
    }
    <NavLink href="/menu" class="mobile-bottom-nav-item">
        <MudIcon Icon="@Icons.Material.Outlined.Menu" />
        <span>Menu</span>
    </NavLink>
</nav>

@code {
    protected override Task OnInitializedAsync() => Brand.EnsureLoadedAsync();
}
