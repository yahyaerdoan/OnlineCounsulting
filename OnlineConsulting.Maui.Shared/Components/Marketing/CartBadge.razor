@* Live cart-item badge. An interactive island (like AddToCartForm) so it shares one circuit -
   and one CartState instance - with every add-to-cart button on the static-SSR marketing page,
   letting a successful add update the header count without a full page reload. *@
@implements IDisposable
@using OnlineConsulting.Maui.Shared.Infrastructure.Commerce
@inject CartState CartState

@if (IconOnly)
{
    <MudBadge Content="@BadgeText" Color="Color.Error" Overlap="true" Visible="@(CartState.Count > 0)" Class="@($"header-badge {Class}")">
        <MudIconButton Href="/user/cart" Icon="@Icons.Material.Outlined.ShoppingCart" Color="Color.Inherit" aria-label="Cart" />
    </MudBadge>
}
else
{
    <NavLink href="/user/cart" class="@Class">Cart @(CartState.Count > 0 ? $"({CartState.Count})" : "")</NavLink>
}

@code {
    [Parameter]
    public bool IconOnly { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    private string BadgeText => CartState.Count > 99 ? "99+" : CartState.Count.ToString();

    protected override async Task OnInitializedAsync()
    {
        CartState.Changed += OnCartStateChanged;

        await CartState.EnsureLoadedAsync();
    }

    private void OnCartStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => CartState.Changed -= OnCartStateChanged;
}
