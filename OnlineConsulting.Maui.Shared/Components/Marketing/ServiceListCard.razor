@* Catalog card for a service (Services page, home "Popular Services", related services). Colored by its category's tone, with 24/7
   and deal badges on the photo, the price up front and the one next step for its kind: "Book a visit" (blue) for a visit,
   "Add to cart" (gold) for a product. Pure CSS hover, so it works on the static-SSR pages; inside .svc-grid on phones it turns
   into a compact horizontal row. *@

<article class="@($"svc-card {AccentTone.For(Service.CategoryId)}")">
    <a href="@DetailUrl" class="svc-card-media" aria-label="@Service.Title">
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img src="@ImageUrl" alt="" loading="lazy" />
        }
        else
        {
            <span class="svc-card-placeholder"><MudIcon Icon="@Icons.Material.Outlined.HomeRepairService" /></span>
        }
        <span class="svc-card-badges">
            @if (Service.IsEmergencyAvailable)
            {
                <span class="svc-badge svc-badge-emergency"><MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />24/7</span>
            }
            @if (ServicePriceFormat.HasDiscount(Service))
            {
                <span class="svc-badge svc-badge-deal">@Service.DiscountRate% off</span>
            }
        </span>
    </a>

    <div class="svc-card-body">
        @if (!string.IsNullOrWhiteSpace(CategoryTitle))
        {
            <a href="@CategoryUrl" class="svc-card-category"><span class="svc-card-dot" aria-hidden="true"></span>@CategoryTitle</a>
        }
        <h3 class="svc-card-title"><a href="@DetailUrl">@Service.Title</a></h3>
        <p class="svc-card-desc">@Service.Description</p>

        <div class="svc-card-price">
            <span class="svc-card-price-now">@ServicePriceFormat.Display(Service)</span>
            @if (ServicePriceFormat.HasDiscount(Service))
            {
                <span class="svc-card-price-old">@CurrencyFormat.Format(Service.Price)</span>
            }
        </div>
        <span class="svc-card-kind">
            <MudIcon Icon="@(IsProduct ? Icons.Material.Outlined.Inventory2 : Icons.Material.Outlined.Engineering)" Size="Size.Small" />
            @(IsProduct ? "Order online" : "A technician comes to you")
        </span>

        <div class="svc-card-actions">
            <ServicePrimaryAction ServiceId="@Service.Id" Kind="@Service.Kind" BookText="Book a visit" ShowIcon="true" FullWidth="true"
                                  Class="svc-card-cta" />
            <a href="@DetailUrl" class="svc-card-details" aria-label="@($"Details for {Service.Title}")">Details</a>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public ServiceResponse Service { get; set; } = default!;

    /// <summary>Resolved cover image URL - callers pre-resolve via MediaUploadHelper, this component doesn't fetch.</summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>Resolved category title - ServiceResponse only carries CategoryId, callers pass the looked-up title.</summary>
    [Parameter]
    public string? CategoryTitle { get; set; }

    /// <summary>Category-filter route for the category chip - distinct from DetailUrl, which the card's image/title use.</summary>
    [Parameter]
    public string? CategoryUrl { get; set; }

    [Parameter, EditorRequired]
    public string DetailUrl { get; set; } = default!;

    private bool IsProduct => Service.Kind == ServiceKinds.Product;
}
