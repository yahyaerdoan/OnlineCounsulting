@* Marketing-only brand mark (admin's BrandMark.razor is separate). Colors via CSS's "on-dark" modifier, not params.
   A multi-word name mutes its last word, e.g. "Gunes" + "LLC". *@
@implements IDisposable
@inject SiteBrand Brand

<a href="/" class="marketing-brand-mark @(OnDark ? "marketing-brand-mark-on-dark" : "") @Class">
    @if (Brand.LogoUrl is { } logoUrl)
    {
        <img src="@logoUrl" alt="" class="brand-logo mr-2" />
    }
    else
    {
        <span class="brand-initial-badge mr-2">@Brand.Initial</span>
    }
    <span class="marketing-brand-word">@Lead</span>@if (Tail.Length > 0)
    {<span class="marketing-brand-word marketing-brand-word-muted">@Tail</span>}
</a>

@code {
    /// <summary>True on the dark footer - swaps the wordmark/icon to a light-on-dark palette.</summary>
    [Parameter]
    public bool OnDark { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private int LastSpace => Brand.Name.TrimEnd().LastIndexOf(' ');

    private string Lead => LastSpace > 0 ? Brand.Name[..LastSpace] : Brand.Name;

    private string Tail => LastSpace > 0 ? Brand.Name[LastSpace..].Trim() : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Brand.Changed += OnBrandChanged;
        await Brand.EnsureLoadedAsync();
    }

    private void OnBrandChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Brand.Changed -= OnBrandChanged;
}
