@* Tabbed "explore by category" band: category tabs (vertical on desktop, a swipeable row of story-style bubbles on phones) switch a
   panel with the category's pitch and its services, each one tap from booking. *@
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@inject IApiClient ApiClient

<section class="category-explorer-band">
    <MudContainer MaxWidth="MaxWidth.Large" Class="marketing-section-tight">
        <MudText Typo="Typo.overline" Color="Color.Primary" Class="text-strong">Services</MudText>
        <MudText Typo="Typo.h4" Class="marketing-display mb-2">Everything your home's comfort needs</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6" Style="max-width:640px;">
            From routine maintenance to emergency repairs and full system installs. Pick a category to see what we do.
        </MudText>

        @if (_categories.Count > 0)
        {
            <div class="category-explorer">
                <div class="category-explorer-tabs" role="tablist" aria-label="Service categories">
                    @for (var index = 0; index < _categories.Count; index++)
                    {
                        var category = _categories[index];
                        var id = category.Id;
                        <button type="button" role="tab" id="@($"category-tab-{id}")" aria-controls="category-panel"
                                aria-selected="@(id == _selectedId)" class="category-explorer-tab @(id == _selectedId ? "selected" : null)"
                                @onclick="@(() => _selectedId = id)">
                            <span class="tone-bubble category-explorer-tab-icon @AccentTone.At(index)"><MudIcon Icon="@category.Icon" Size="Size.Small" /></span>
                            <span class="category-explorer-tab-label">@category.Title</span>
                        </button>
                    }
                </div>

                @if (Selected is { } selected)
                {
                    <div class="category-explorer-panel" role="tabpanel" id="category-panel" aria-labelledby="@($"category-tab-{selected.Id}")">
                        <MudText Typo="Typo.h5">@selected.Title</MudText>
                        @if (!string.IsNullOrWhiteSpace(selected.Description))
                        {
                            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">@selected.Description</MudText>
                        }

                        <div class="category-explorer-services">
                            @foreach (var service in ServicesOf(selected.Id).Take(4))
                            {
                                <div class="category-explorer-service">
                                    <div class="min-w-0">
                                        <MudLink Href="@($"/services/{service.Slug}")" Class="text-strong">@service.Title</MudLink>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="category-explorer-service-text">@service.Description</MudText>
                                    </div>
                                    <MudButton Href="@($"/appointment?service={service.Id}")" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Book</MudButton>
                                </div>
                            }
                        </div>

                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-5">
                            <MudButton Href="@($"/services?category={selected.Id}")" Variant="Variant.Filled" Color="Color.Primary"
                                       EndIcon="@Icons.Material.Filled.ArrowForward">Explore @selected.Title</MudButton>
                            <MudButton Href="/service-finder" Variant="Variant.Text" Color="Color.Primary">Help me choose</MudButton>
                        </MudStack>
                    </div>
                }
            </div>
        }
    </MudContainer>
</section>

@code {
    private List<CategoryResponse> _categories = [];
    private List<ServiceResponse> _services = [];
    private Guid _selectedId;

    private CategoryResponse? Selected => _categories.FirstOrDefault(c => c.Id == _selectedId);

    protected override async Task OnInitializedAsync()
    {
        var categoriesTask = CategoryLookupHelper.GetAllAsync(ApiClient);
        var servicesTask = ApiClient.GetAsync<PaginatedResponse<ServiceResponse>>($"{ApiRoutes.Services.Base}?size=100");

        _categories = await categoriesTask;
        var services = await servicesTask;
        _services = services.IsSuccessful && services.ResultData is not null ? services.ResultData.Items : [];
        _selectedId = _categories.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private IEnumerable<ServiceResponse> ServicesOf(Guid categoryId) => _services.Where(s => s.CategoryId == categoryId);
}
