@* FAQ accordion for one service, or general FAQs when ServiceId is null; Band = full home-style section. Hidden when empty. *@
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@inject IApiClient ApiClient

@if (_items.Count > 0)
{
    @if (Band)
    {
        <section>
            <MudContainer MaxWidth="MaxWidth.Medium" Class="marketing-section-tight">
                <SectionHeading Eyebrow="FAQ" Title="Frequently Asked Questions" Lead="Quick answers about pricing, scheduling and how we work." />
                @Accordion
            </MudContainer>
        </section>
    }
    else
    {
        <div class="mt-8">
            <MudText Typo="Typo.h6" Class="mb-2">Frequently Asked Questions</MudText>
            @Accordion
        </div>
    }
}

@code {
    /// <summary>The service whose questions to show; null shows the general questions.</summary>
    [Parameter]
    public Guid? ServiceId { get; set; }

    [Parameter]
    public bool Band { get; set; }

    private List<FaqItemResponse> _items = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiClient.GetAsync<List<FaqItemResponse>>(ApiRoutes.SiteContent.FaqItems.Base);
        var all = result.IsSuccessful ? result.ResultData ?? [] : [];
        _items = [.. all.Where(f => f.ServiceId == ServiceId).OrderBy(f => f.DisplayOrder)];
    }

    private RenderFragment Accordion => __builder =>
    {
        <MudStack Spacing="2">
            @foreach (var item in _items)
            {
                <details class="marketing-promo-card">
                    <summary>
                        <span class="marketing-promo-title text-strong">@item.Question</span>
                    </summary>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@item.Answer</MudText>
                </details>
            }
        </MudStack>
    };
}
