@* "Why Choose Us / What We Provide" as a tabbed showcase: on wide screens the numbered list on the left (every item's text
   visible) picks which highlight fills the big photo panel on the right (title, text and a booking link over the photo);
   it only changes when the visitor clicks an item. On phones every highlight is a swipeable photo card. Wired by marketing.js (initProvide) through delegated handlers,
   so it works on the statically rendered home page; each item's own photo is used, the intro's cover image as fallback. *@
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@inject IApiClient ApiClient

@if (_items.Count > 0)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="marketing-section-tight">
        <SectionHeading Eyebrow="Why Choose Us" Title="What We Provide" Lead="@_intro?.Description" />

        <div class="provide" data-provide>
            <div class="provide-tabs" role="tablist" aria-label="What we provide" aria-orientation="vertical">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var item = _items[i];
                    var isFirst = i == 0;
                    <button type="button" role="tab" id="@($"provide-tab-{i}")" aria-controls="@($"provide-panel-{i}")"
                            aria-selected="@(isFirst ? "true" : "false")" tabindex="@(isFirst ? "0" : "-1")"
                            class="@($"provide-tab {AccentTone.At(i)} {(isFirst ? "active" : "")}")" data-provide-tab="@i">
                        <span class="provide-tab-number">@((i + 1).ToString("00"))</span>
                        <span class="provide-tab-text">
                            <span class="provide-tab-title">@item.Title</span>
                            <span class="provide-tab-desc">@item.Description</span>
                        </span>
                    </button>
                }
            </div>

            <div class="provide-stage">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var item = _items[i];
                    var photo = MediaUrlResolver.Resolve(ApiClient, item.ImageUrl) ?? _coverImageUrl;
                    <article id="@($"provide-panel-{i}")" role="tabpanel" aria-labelledby="@($"provide-tab-{i}")"
                             class="@($"provide-panel {AccentTone.At(i)} {(i == 0 ? "active" : "")}")" data-provide-panel="@i">
                        @if (!string.IsNullOrWhiteSpace(photo))
                        {
                            <img src="@photo" alt="" loading="@(i == 0 ? "eager" : "lazy")" />
                        }
                        <div class="provide-panel-overlay">
                            <span class="provide-panel-count">@((i + 1).ToString("00")) / @_items.Count.ToString("00")</span>
                            <h3 class="provide-panel-title">@item.Title</h3>
                            <p class="provide-panel-text">@item.Description</p>
                            <a href="/appointment" class="provide-panel-cta">Book a visit<MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </MudContainer>
}

@code {
    private List<FeatureHighlightResponse> _items = [];
    private FeatureHighlightsIntroResponse? _intro;
    private string? _coverImageUrl;

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiClient.GetAsync<List<FeatureHighlightResponse>>(ApiRoutes.SiteContent.FeatureHighlight.Base);
        _items = result.IsSuccessful ? result.ResultData?.OrderBy(i => i.DisplayOrder).ToList() ?? [] : [];

        var introResult = await ApiClient.GetAsync<List<FeatureHighlightsIntroResponse>>(ApiRoutes.SiteContent.FeatureHighlightsIntro.Base);
        _intro = introResult.IsSuccessful ? introResult.ResultData?.OrderBy(i => i.DisplayOrder).FirstOrDefault() : null;

        if (_intro?.CoverMediaAssetId is { } coverId)
        {
            _coverImageUrl = await MediaUploadHelper.GetUrlAsync(ApiClient, coverId);
        }
    }
}
