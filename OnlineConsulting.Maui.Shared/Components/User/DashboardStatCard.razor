@* One dashboard stat tile: a label and a value, optionally colored. *@
@namespace OnlineConsulting.Maui.Shared.Components.User

<MudPaper Class="pa-3 text-center d-flex flex-column justify-center" Style="height:100%;" Outlined="true">
    <MudText Typo="Typo.caption" Color="Color.Secondary">@Label</MudText>
    <MudText Typo="Typo.h6" Color="@Color">@ChildContent</MudText>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public Color Color { get; set; } = Color.Default;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
