@* Consistent heading for /user/* pages: the title, and the page's main action (e.g. Add Address) on its right when given. *@
@namespace OnlineConsulting.Maui.Shared.Components.User

<div class="dashboard-heading">
    <MudText Typo="Typo.h6" Class="text-strong">@Text</MudText>
    @if (ChildContent is not null)
    {
        <div class="dashboard-heading-actions">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
