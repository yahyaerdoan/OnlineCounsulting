@* Dashboard header card - who you are (avatar, greeting, membership state) and the three things customers reach for
   most (book a visit, basket, support). Actions sit on the right on wide screens and as a shortcut row on phones. *@
@namespace OnlineConsulting.Maui.Shared.Components.User
@using OnlineConsulting.Maui.Shared.Infrastructure.Commerce
@implements IDisposable
@inject IApiClient ApiClient
@inject CartState CartState
@inject DataChangeNotifier Notifier

<MudPaper Class="dashboard-upper-info mb-4" Outlined="true">
    <div class="dashboard-upper-identity">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Size="Size.Small" OnClick="OnToggleSidebar" aria-label="Toggle menu" Class="hide-on-phone" />

        @if (_loading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="48px" Height="48px" />
            <div class="dashboard-upper-text">
                <MudSkeleton Width="140px" Height="24px" />
                <MudSkeleton Width="100px" Height="20px" />
            </div>
        }
        else
        {
            <span class="dashboard-upper-avatar" aria-hidden="true">@Initials</span>
            <div class="dashboard-upper-text">
                <MudText Typo="Typo.subtitle1" Class="dashboard-upper-greeting">Hi, @(_user?.FirstName is { Length: > 0 } firstName ? firstName : "there")</MudText>
                @if (Membership is { } membership)
                {
                    <MudLink Href="/user/membership" Underline="Underline.None" Class="dashboard-upper-status">
                        <MudChip T="string" Size="Size.Small" Color="@membership.Color" Icon="@membership.Icon" Class="ma-0">@membership.Label</MudChip>
                    </MudLink>
                }
                else
                {
                    <MudLink Href="/membership" Underline="Underline.None" Typo="Typo.body2" Class="dashboard-upper-join">
                        Not a member yet &middot; <strong>See plans</strong>
                    </MudLink>
                }
            </div>
        }
    </div>

    <nav class="dashboard-upper-actions" aria-label="Shortcuts">
        <a href="/appointment" class="dashboard-upper-action">
            <span class="tone-bubble tone-bubble-sm @AccentTone.Blue"><MudIcon Icon="@Icons.Material.Outlined.EventAvailable" Size="Size.Small" /></span>
            <span>Book a visit</span>
        </a>
        <a href="/user/cart" class="dashboard-upper-action">
            <span class="tone-bubble tone-bubble-sm @AccentTone.Orange dashboard-upper-cart">
                <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" Size="Size.Small" />
                @if (CartState.Count > 0)
                {
                    <span class="dashboard-upper-count" aria-label="@($"{CartState.Count} items")">@CartState.Count</span>
                }
            </span>
            <span>Basket</span>
        </a>
        <a href="/contact" class="dashboard-upper-action">
            <span class="tone-bubble tone-bubble-sm @AccentTone.Green"><MudIcon Icon="@Icons.Material.Outlined.SupportAgent" Size="Size.Small" /></span>
            <span>Support</span>
        </a>
    </nav>
</MudPaper>

@code {
    private sealed record MembershipBadge(string Label, Color Color, string Icon);

    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    private CurrentUserResponse? _user;
    private CustomerMembershipResponse? _membership;
    private bool _loading = true;
    private IDisposable? _liveUpdates;

    private string Initials =>
        $"{_user?.FirstName.FirstOrDefault()}{_user?.LastName.FirstOrDefault()}".Trim('\0').ToUpperInvariant() is { Length: > 0 } initials ? initials : "?";

    /// <summary>Null when there is no live membership (none, cancelled or failed) - the card then offers the plans instead.</summary>
    private MembershipBadge? Membership => _membership switch
    {
        { IsEnding: true } => new("Membership ending", Color.Warning, Icons.Material.Outlined.EventBusy),
        { Status: "Active" } => new("Active member", Color.Success, Icons.Material.Outlined.WorkspacePremium),
        { Status: "Paused" } => new("Membership paused", Color.Default, Icons.Material.Outlined.PauseCircle),
        { Status: "PastDue" } => new("Payment due", Color.Error, Icons.Material.Outlined.ErrorOutline),
        { Status: "PendingPayment" } => new("Membership pending", Color.Warning, Icons.Material.Outlined.HourglassTop),
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        CartState.Changed += OnCartChanged;
        _liveUpdates = Notifier.Subscribe(() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }),
            DataTopic.Membership, DataTopic.Profile, DataTopic.Summary);

        await CartState.EnsureLoadedAsync();
        await LoadAsync();
        _loading = false;
    }

    /// <summary>Name and membership state; the basket count comes from the shared, self-refreshing CartState.</summary>
    private async Task LoadAsync()
    {
        var userResult = await ApiClient.GetAsync<CurrentUserResponse>(ApiRoutes.Users.Me);
        if (userResult.IsSuccessful)
        {
            _user = userResult.ResultData;
        }

        var membershipResult = await ApiClient.GetAsync<CustomerMembershipResponse>(ApiRoutes.Growth.CustomerMemberships.Mine);
        _membership = membershipResult switch
        {
            { IsSuccessful: true } => membershipResult.ResultData,
            { StatusCode: 404 } => null,
            _ => _membership,
        };
    }

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        CartState.Changed -= OnCartChanged;
        _liveUpdates?.Dispose();
    }
}
