@* Pick a different plan to switch to, styled like SelectAddressDialog's cards: tap a plan to select it, then confirm with Switch plan
   (a billing change, so it isn't applied on tap). *@
@namespace OnlineConsulting.Maui.Shared.Components.User

<MudDialog Class="address-dialog">
    <TitleContent>
        <div class="address-dialog-head">
            <span class="tone-bubble tone-gold"><MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" /></span>
            <span class="address-dialog-title">
                <MudText Typo="Typo.h6" Class="text-strong">Change plan</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pick the plan you'd like to switch to.</MudText>
            </span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="address-picker address-dialog-list" role="radiogroup" aria-label="Plans">
            @for (var i = 0; i < Plans.Count; i++)
            {
                var plan = Plans[i];
                var isChosen = plan.Id == _selectedId;
                <button type="button" role="radio" aria-checked="@(isChosen ? "true" : "false")"
                        class="@($"address-card {(isChosen ? "selected" : "")}")" @onclick="@(() => _selectedId = plan.Id)">
                    <span class="@($"tone-bubble {AccentTone.At(i)}")"><MudIcon Icon="@Icons.Material.Outlined.WorkspacePremium" /></span>
                    <span class="address-card-body">
                        <span class="address-card-name">@plan.Name</span>
                        <span class="address-card-line">@CurrencyFormat.Format(plan.Price) / @(plan.BillingCycle == "Annual" ? "year" : "month")</span>
                        @if (plan.IncludedVisitsPerYear > 0 || plan.DiscountPercent > 0)
                        {
                            <span class="address-card-line">
                                @(plan.IncludedVisitsPerYear > 0 ? $"{plan.IncludedVisitsPerYear} visits a year" : "")@(plan.IncludedVisitsPerYear > 0 && plan.DiscountPercent > 0 ? " · " : "")@(plan.DiscountPercent > 0 ? $"{plan.DiscountPercent:0.#}% off services" : "")
                            </span>
                        }
                    </span>
                    <span class="address-card-check" aria-hidden="true">
                        <MudIcon Icon="@(isChosen ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)" />
                    </span>
                </button>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <DialogActionButtons OnOk="Select" OkText="Switch plan" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public List<MembershipPlanResponse> Plans { get; set; } = default!;

    private Guid _selectedId;

    protected override void OnInitialized() => _selectedId = Plans.Count > 0 ? Plans[0].Id : Guid.Empty;

    private void Select() => MudDialog.Close(DialogResult.Ok(_selectedId));
}
