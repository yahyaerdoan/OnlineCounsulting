@* The caller's referral code (with copy), credit balance and the people they referred, laid out like My Orders: the code and balance
   up top, then one card per referral (name or email, status badge, reward and when it was paid). *@
@namespace OnlineConsulting.Maui.Shared.Components.User
@inject IApiClient ApiClient
@inject DataChangeNotifier Notifier
@implements IDisposable
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

<ApiErrorAlert Message="@_loadError" Severity="Severity.Warning" />

@if (_loading)
{
    <ListSkeleton Rows="3" />
}
else
{
    <div class="orders-stats">
        <button type="button" class="orders-stat orders-stat-alert referral-code-stat" @onclick="CopyCodeAsync" aria-label="Copy referral code">
            <span class="orders-stat-value">
                @_referralCode
                <MudIcon Icon="@(_copied ? Icons.Material.Outlined.Check : Icons.Material.Outlined.ContentCopy)" Size="Size.Small" />
            </span>
            <span class="orders-stat-label">@(_copied ? "copied" : "your code, tap to copy")</span>
        </button>
        <div class="orders-stat">
            <span class="orders-stat-value">@CurrencyFormat.Format(_creditBalance)</span>
            <span class="orders-stat-label">account credit</span>
        </div>
        <div class="orders-stat">
            <span class="orders-stat-value">@_referrals.Count</span>
            <span class="orders-stat-label">@(_referrals.Count == 1 ? "referral" : "referrals")</span>
        </div>
    </div>

    @if (_referrals.Count == 0)
    {
        <div class="cart-empty">
            <span class="tone-bubble tone-bubble-lg tone-berry"><MudIcon Icon="@Icons.Material.Outlined.Redeem" /></span>
            <MudText Typo="Typo.h6" Class="text-strong">No Referrals Yet</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Share your code with friends. When they book their first service, you both earn credit.</MudText>
            <div class="cart-empty-actions">
                <MudButton Variant="Variant.Filled" Class="sell-btn" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyCodeAsync">Copy My Code</MudButton>
            </div>
        </div>
    }
    else
    {
        <div class="order-cards" role="list">
            @foreach (var referral in _referrals)
            {
                var rewarded = referral.Status == Rewarded;
                <div class="@($"order-card {(rewarded ? AccentTone.Green : AccentTone.Orange)}")" role="listitem">
                    <span class="order-card-icon"><MudIcon Icon="@(rewarded ? Icons.Material.Outlined.Redeem : Icons.Material.Outlined.HourglassTop)" /></span>
                    <span class="order-card-main">
                        <span class="order-card-number">@(referral.ReferredName ?? referral.ReferredEmail ?? "A friend")</span>
                        <span class="order-card-date">@(rewarded && referral.RewardedAt is { } at ? $"Rewarded {BusinessTime.FormatDate(at)}" : "Waiting for their first service")</span>
                    </span>
                    <span class="order-card-badges">
                        <StatusBadge Label="@referral.Status" Kind="@(rewarded ? StatusKinds.Success : StatusKinds.Warning)" />
                    </span>
                    <span class="order-card-total">@(referral.RewardAmount is { } amount ? CurrencyFormat.Format(amount) : "-")</span>
                </div>
            }
        </div>
    }
}

@code {
    private const string Rewarded = "Rewarded";

    private string _referralCode = "-";
    private decimal _creditBalance;
    private List<ReferralResponse> _referrals = [];
    private bool _loading = true;
    private bool _copied;
    private string? _loadError;
    private IDisposable? _liveUpdates;

    protected override async Task OnInitializedAsync()
    {
        var codeResult = await ApiClient.PostAsync<string>(ApiRoutes.Growth.Referrals.MyCode, new { });
        if (!codeResult.IsSuccessful || codeResult.ResultData is null)
        {
            _loadError = codeResult.DisplayMessage;
            _loading = false;
            return;
        }

        _referralCode = codeResult.ResultData;

        await LoadReferralsAsync();
        _liveUpdates = Notifier.Subscribe(() => InvokeAsync(async () => { await LoadReferralsAsync(); StateHasChanged(); }), DataTopic.Referrals);
        _loading = false;
    }

    private async Task LoadReferralsAsync()
    {
        var referralsResult = await ApiClient.GetAsync<List<ReferralResponse>>(ApiRoutes.Growth.Referrals.Mine);
        _referrals = referralsResult.IsSuccessful && referralsResult.ResultData is not null
            ? [.. referralsResult.ResultData.OrderByDescending(r => r.RewardedAt ?? DateTimeOffset.MaxValue)]
            : [];

        var creditResult = await ApiClient.GetAsync<AccountCreditSummaryResponse>(ApiRoutes.Growth.Referrals.MyCredit);
        _creditBalance = creditResult.IsSuccessful && creditResult.ResultData is not null ? creditResult.ResultData.Balance : 0m;
    }

    private async Task CopyCodeAsync()
    {
        var copied = await JsRuntime.InvokeAsync<bool>("copyToClipboard", _referralCode);
        if (!copied)
        {
            Snackbar.Add("Clipboard is not available in this browser.", Severity.Error);
            return;
        }

        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }

    public void Dispose() => _liveUpdates?.Dispose();
}
