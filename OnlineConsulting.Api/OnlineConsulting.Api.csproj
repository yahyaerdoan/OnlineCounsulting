<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a6d4b8b0-6e0b-4b7e-9b6b-9b6f7b4e2f0a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned directly (nearest-wins) so it doesn't float up to whatever Core.ApplicationLayer's
         nuspec requests transitively - must match FluentValidation.AspNetCore's supported major
         version (BusinessLogic.csproj) or MVC model validation throws TypeLoadException. -->
    <PackageReference Include="Core.CrossCuttingConcernLayer" />
    <PackageReference Include="Core.SecurityLayer" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Hateoas.AspNetCore" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="ResponseResultHandler.AspNetCore" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <Target Name="DisableCompileTimeOpenApiXmlGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators' or '%(Analyzer.Filename)' == 'Microsoft.AspNetCore.App.SourceGenerators'" />
    </ItemGroup>
  </Target>

