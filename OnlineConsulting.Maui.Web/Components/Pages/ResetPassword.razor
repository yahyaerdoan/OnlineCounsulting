@page "/reset-password"
@attribute [ExcludeFromInteractiveRouting]
@layout MainLayout
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject FormState<ResetPasswordModel> Form

<PageTitle>Reset password</PageTitle>

<AuthCard Icon="@Icons.Material.Outlined.LockReset" Title="Choose a new password" Subtitle="Enter a new password for your account.">
    @if (_successMessage is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Sign in</MudButton>
    }
    else
    {
        <EditForm EditContext="@Form.EditContext" method="post" OnValidSubmit="SubmitAsync" FormName="reset-password" autocomplete="off">
            <AuthTextField Label="New password" Icon="@Icons.Material.Outlined.Lock" Type="password"
                           @bind-Value="_model.NewPassword" AutoFocus="true" />

            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="auth-submit">Reset password</MudButton>
        </EditForm>
    }
</AuthCard>

@code {
    [SupplyParameterFromQuery]
    private Guid UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordModel _model
    {
        get => field ??= new ResetPasswordModel();
        set;
    }

    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnInitialized() => Form.Bind(_model);

    private Task SubmitAsync() => Form.SubmitAsync(async () =>
    {
        _errorMessage = null;

        if (UserId == Guid.Empty || string.IsNullOrWhiteSpace(Token))
        {
            _errorMessage = "This reset link is invalid.";
            return;
        }

        var anonymousClient = HttpClientFactory.CreateClient(ApiHttpClientNames.Anonymous);
        var api = new ApiClient(anonymousClient);

        var result = await api.PostAsync(ApiRoutes.Auth.ResetPassword, new { userId = UserId, token = Token, newPassword = _model.NewPassword });

        if (!result.IsSuccessful)
        {
            _errorMessage = Form.DisplayErrors(result);
            return;
        }

        _successMessage = result.DisplayMessage;
    });

    private sealed class ResetPasswordModel
    {
        public string NewPassword { get; set; } = string.Empty;
    }
}
