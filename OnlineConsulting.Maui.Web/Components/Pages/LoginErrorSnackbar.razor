@* Login.razor is static SSR - this island runs its own circuit just for the toast. *@
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<MudSnackbarProvider />

@code {
    private const string LastGoodbyeKey = "auth-last-goodbye";

    [Parameter]
    public string? ErrorMessage { get; set; }

    /// <summary>Unique per logout - dedups repeat Login re-posts of the same logout via sessionStorage.</summary>
    [Parameter]
    public string? GoodbyeToken { get; set; }

    /// <summary>One-shot success toast carried over via redirect (e.g. AcceptInvite's username notice).</summary>
    [Parameter]
    public string? Notice { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!string.IsNullOrEmpty(ErrorMessage))
        {
            Snackbar.ShowError(ErrorMessage);
            return;
        }

        if (!string.IsNullOrEmpty(Notice))
        {
            Snackbar.ShowSuccess(Notice);
            return;
        }

        if (string.IsNullOrEmpty(GoodbyeToken))
        {
            return;
        }

        var lastShown = await JsRuntime.InvokeAsync<string?>("sessionStorage.getItem", LastGoodbyeKey);
        if (lastShown == GoodbyeToken)
        {
            return;
        }

        Snackbar.ShowSuccess("Goodbye!");
        await JsRuntime.InvokeVoidAsync("sessionStorage.setItem", LastGoodbyeKey, GoodbyeToken);
    }
}
