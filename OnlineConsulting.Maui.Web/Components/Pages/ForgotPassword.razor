@page "/forgot-password"
@attribute [ExcludeFromInteractiveRouting]
@layout MainLayout
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@inject IHttpClientFactory HttpClientFactory
@inject FormState<ForgotPasswordModel> Form

<PageTitle>Forgot password</PageTitle>

<AuthCard Icon="@Icons.Material.Outlined.LockReset" Title="Forgot your password?" Subtitle="Enter your email and we'll send you a reset link.">
    @if (_successMessage is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
    }
    else
    {
        <EditForm EditContext="@Form.EditContext" method="post" OnValidSubmit="SubmitAsync" FormName="forgot-password" autocomplete="off">
            <AuthTextField Label="Email" Icon="@Icons.Material.Outlined.Mail" Type="email"
                           @bind-Value="_model.Email" AutoFocus="true" />

            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="auth-submit">Send reset link</MudButton>
        </EditForm>
    }

    <MudText Typo="Typo.body2" Class="mt-4" Align="Align.Center">
        <MudLink Href="/login">Back to sign in</MudLink>
    </MudText>
</AuthCard>

@code {
    [SupplyParameterFromForm]
    private ForgotPasswordModel _model
    {
        get => field ??= new ForgotPasswordModel();
        set;
    }

    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnInitialized() => Form.Bind(_model);

    private Task SubmitAsync() => Form.SubmitAsync(async () =>
    {
        _errorMessage = null;

        var anonymousClient = HttpClientFactory.CreateClient(ApiHttpClientNames.Anonymous);
        var api = new ApiClient(anonymousClient);

        var result = await api.PostAsync(ApiRoutes.Auth.ForgotPassword, new { email = _model.Email });

        // Handler always succeeds once it receives a request (never reveals if the email exists) -
        // a failure here means the request itself was malformed.
        if (!result.IsSuccessful)
        {
            _errorMessage = Form.DisplayErrors(result);
            return;
        }

        _successMessage = result.DisplayMessage;
    });

    private sealed class ForgotPasswordModel
    {
        public string Email { get; set; } = string.Empty;
    }
}
