@page "/login"
@using OnlineConsulting.Maui.Infrastructure.Auth
@using OnlineConsulting.Maui.Shared.Components.Common
@using OnlineConsulting.Maui.Shared.Infrastructure.Api
@using OnlineConsulting.Maui.Shared.Infrastructure.Auth
@using OnlineConsulting.Maui.Shared.Infrastructure.Forms
@inject IApiClient ApiClient
@inject SecureStorageAccessTokenProvider TokenProvider
@inject MauiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject FormState<LoginModel> Form

<PageTitle>Sign in</PageTitle>

<AuthCard Subtitle="Sign in to book visits and manage your ComfortPro account.">
    <EditForm EditContext="@Form.EditContext" OnValidSubmit="SubmitAsync" autocomplete="off">
        <MudTextField @bind-Value="_model.UserNameOrEmail" For="@(() => _model.UserNameOrEmail)" Label="Username or email" Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Person" Class="mb-4" autocomplete="username" />
        <MudTextField @bind-Value="_model.Password" For="@(() => _model.Password)" Label="Password" InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                      OnAdornmentClick="@(() => _showPassword = !_showPassword)" AdornmentAriaLabel="Show password" Class="mb-5" autocomplete="current-password" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="auth-submit" Disabled="Form.IsBusy">
            @(Form.IsBusy ? "Signing in..." : "Sign in")
        </MudButton>
    </EditForm>

    <MudText Typo="Typo.body2" Class="mt-5" Align="Align.Center">
        New here? <MudLink Href="@RegisterHref" Class="text-strong">Create an account</MudLink>
    </MudText>
</AuthCard>

@code {
    private readonly LoginModel _model = new();
    private bool _showPassword;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string RegisterHref => string.IsNullOrEmpty(ReturnUrl) ? "/register" : $"/register?ReturnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override async Task OnInitializedAsync()
    {
        Form.Bind(_model);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated is true)
        {
            Navigation.NavigateTo(SignInRedirect.Target(authState.User, ReturnUrl), replace: true);
        }
    }

    private Task SubmitAsync() => Form.SubmitAsync(async () =>
    {
        var tokenResult = await ApiClient.PostAsync<AuthTokensResponse>(ApiRoutes.Auth.Login, new { userNameOrEmail = _model.UserNameOrEmail, password = _model.Password });

        if (!tokenResult.IsSuccessful || tokenResult.ResultData is null)
        {
            Form.DisplayErrors(tokenResult, Snackbar);
            return;
        }

        // Stored before the /me call so BearerTokenHandler picks it up for that request too.
        await TokenProvider.SetTokenSetAsync(new TokenSet(tokenResult.ResultData.AccessToken, tokenResult.ResultData.RefreshToken, tokenResult.ResultData.AccessTokenExpiresAt));

        var userResult = await ApiClient.GetAsync<CurrentUserResponse>(ApiRoutes.Users.Me);
        if (!userResult.IsSuccessful || userResult.ResultData is null)
        {
            await TokenProvider.ClearAsync();
            Snackbar.ShowError("Signed in, but could not load your profile. Please try again.");
            return;
        }

        AuthStateProvider.SignIn(userResult.ResultData);
        var target = SignInRedirect.Target(userResult.ResultData.Roles, ReturnUrl);
        Navigation.NavigateTo(target.Contains('?') ? $"{target}&welcome=true" : $"{target}?welcome=true", replace: true);
    });
}
