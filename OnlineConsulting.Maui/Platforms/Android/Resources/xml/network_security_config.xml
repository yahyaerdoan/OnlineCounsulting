<?xml version="1.0" encoding="utf-8"?>
<!-- Dev-only: trusts the bundled dev cert (see OnlineConsulting.Api/DevCerts/README.md) for the
     Android emulator's host-loopback alias (10.0.2.2), which ApiEndpoint.DevDefaultUrl points at -
     its SAN list includes 10.0.2.2, unlike the stock ASP.NET Core dev cert, so https genuinely
     works here instead of failing TLS hostname verification. Every other domain keeps Android's
     default (system trust anchors only). 127.0.0.1 is for a real phone on USB: "adb reverse tcp:7012 tcp:7012" maps the
     phone's own 127.0.0.1:7012 to the PC's Api, and the cert's SAN list covers 127.0.0.1 too. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="@raw/dev_cert" />
        </trust-anchors>
    </domain-config>
</network-security-config>
