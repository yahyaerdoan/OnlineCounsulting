    <PackageVersion Include="ResponseResultHandler.AspNetCore" Version="12.1.27-beta.27" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.0" />
    <PackageVersion Include="Stripe.net" Version="52.3.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
